@{
    ViewData["Title"] = "Business Request";
}
@section Styles {
    <link href="~/css/form.css" rel="stylesheet" type="text/css" />
    <script src="~/js/form.js"></script>
}

<div id="body">

    <!-- The Modal -->
    <div class="modal" id="myModal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="outer-border">
                        <img src="../../images/exclamation-circle-fill.svg" alt="" class="exclamation-img">
                    </div>
                    <p class="information-heading">Information</p>
                    <p class="information-data">
                        While submitting a request you must provide the correct contact
                        information for the patient or the responsible party. Failure to provide correct email and phone
                        number will delay service or declined.
                    </p>
                    <button class="btn btn-info ok-btn" id="closeBtn">Ok</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Navbar -->

    <partial name="_FormNavbar" />

    <!-- Main Content -->

    <div class="main-container">
        <div class="flex-container">
            <div class="top-text">
                <span class="submit-text" id="submit-text">Submit Information</span>
                <a class="back-btn" asp-controller="Patient" asp-action="SubmitRequest">
                    &lt; <span class="back-text">Back</span>
                </a>
            </div>
            <form class="main-form">

                <!-- Family/Friend Information  -->

                <div class="upper-text">
                    Business Information
                </div>
                <div class="row family-info-row">
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="business-first-name" placeholder="name@example.com"
                               required>
                        <label for="business-first-name" class="form-label">Your First Name</label>
                    </div>
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="business-last-name" placeholder="name@example.com"
                               required>
                        <label for="business-last-name" class="form-label">Your Last Name</label>
                    </div>
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="tel" class="form-control phone" id="business-phone" name="phone" required>
                    </div>
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="business-email" placeholder="name@example.com"
                               required>
                        <label for="business-email" class="form-label">Your email</label>
                    </div>
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="property-name" placeholder="name@example.com" required>
                        <label for="property-name" class="form-label">Business/Property Name</label>
                    </div>
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="property-name" placeholder="name@example.com">
                        <label for="property-name" class="form-label">Case Number(Optional)</label>
                    </div>
                </div>

                <!-- Patient Information -->

                <div class="upper-text margin-top">
                    Patient Information
                </div>
                <div class="row symptoms-textarea">
                    <div class="form-floating mb-3 inp col-sm-12">
                        <textarea class="form-control text-area" id="floatingInput"
                                  placeholder="name@example.com"></textarea>
                        <label for="floatingInput" class="form-label">Enter Brief Details of Symptoms(Optional)</label>
                    </div>
                </div>
                <div class="row">
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="first-name" placeholder="name@example.com" required>
                        <label for="first-name" class="form-label">First Name</label>
                    </div>
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="last-name" placeholder="name@example.com" required>
                        <label for="last-name" class="form-label">Last Name</label>
                    </div>
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="date" class="form-control dob" id="dob" placeholder="name@example.com" required>
                        <label for="dob" class="form-label dob-label">Date Of Birth</label>
                    </div>
                </div>

                <!-- Patient Contact Infromation -->

                <div class="upper-text margin-top">
                    Patient Contact Information
                </div>
                <div class="row symptoms-textarea">
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="email" class="form-control" id="email" placeholder="name@example.com" required>
                        <label for="email" class="form-label">Email</label>
                    </div>
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="tel" class="form-control phone" id="phone" name="phone" required>
                    </div>
                </div>

                <!-- Patient Location -->
                <div class="upper-text margin-top">
                    Patient Location
                </div>
                <div class="row symptoms-textarea">
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="street" placeholder="name@example.com" required>
                        <label for="street" class="form-label">Street</label>
                    </div>
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="city" placeholder="name@example.com" required>
                        <label for="city" class="form-label">City</label>
                    </div>
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="state" placeholder="name@example.com" required>
                        <label for="state" class="form-label">State</label>
                    </div>
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="zipcode" placeholder="name@example.com" required>
                        <label for="zipcode" class="form-label">Zipcode</label>
                    </div>
                    <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="room" placeholder="name@example.com">
                        <label for="room" class="form-label">Room / Suite (Optional)</label>
                    </div>
                </div>

                <!-- Submit / Clear -->
                <div class="lower-btn">
                    <button class="lower-custom-btn submit-btn">Submit</button>
                    <button type="button" class="lower-custom-btn cancel-btn" onclick="reload()">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bottom Part -->
    <partial name="_FormFooter" />
    
</div>