@using System.Collections;
@model BlockHistoryViewModel
<table class="table">
    <thead>
        <tr>
            <th>Patient Name</th>
            <th>Phone Number</th>
            <th>Email</th>
            <th>Created Date</th>
            <th>Notes</th>
            <th>is Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.blockRequests)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Email</td>
                <td>@item.CreatedDate?.ToString("MMMM dd,yyyy")</td>
                <td>@item.Reason</td>
                <td>
                    <div class="form-check">
                        <input data-id="@item.BlockRequestId" class="form-check-input" type="checkbox" id="license-check" asp-for="@item.IsActive[0]" onchange="changeActive(this)">
                    </div>
                </td>
                <td><a class="back-btn reset-btn mt-3" id="reset-password" asp-action="RestoreBlock" asp-controller="Admin" asp-route-blockrequestid="@item.BlockRequestId"><span class="back-text">Unblock</span></a></td>
            </tr>
        }
    </tbody>
</table>

<div class="accordion accordion-flush" id="accordionFlushExample">
    @for (var i = 0; i < Model.blockRequests.Count; ++i)
    {
        <div class="accordion-item">
            <h2 class="accordion-header" id="flush-heading@(i)">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#flush-collapse@(i)" aria-expanded="false" aria-controls="flush-collapse@(i)">
                    <div class="mb-3">@(Model.blockRequests[i].Name)</div>
                    <div>@Model.blockRequests[i].Email</div>
                </button>
            </h2>
            <div id="flush-collapse@(i)" class="accordion-collapse collapse" aria-labelledby="flush-heading@(i)"
                 data-bs-parent="#accordionFlushExample">
                <div class="accordion-body main-flex">
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/telephone-black.svg" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Phone Number :
                            <span class="accordion-value-inner">@Model.blockRequests[i].PhoneNumber</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/calendar.svg" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Created Date :
                            <span class="accordion-value-inner">@(Model.blockRequests[i].CreatedDate?.ToString("MMMM dd,yyyy"))</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/list.png" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Notes :
                            <span class="accordion-value-inner">@(Model.blockRequests[i].Reason)</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <i class="bi bi-check tick-color"></i>
                        </div>
                        <span class="accordion-heading-inner">
                            Status :

                            @if (Model.blockRequests[i].IsActive == new BitArray(new[] { true }))
                            {
                                <span class="accordion-value-inner">Yes</span>
                            }
                            else
                            {
                                <span class="accordion-value-inner">No</span>
                            }

                        </span>
                    </div>
                    <div class="lower-btn-mob-flex">
                        <a class="btn contact-btn" asp-action="RestoreBlock" asp-controller="Admin" asp-route-blockrequestid="@Model.blockRequests[i].BlockRequestId">Unblock</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="pagination">
    @if (Model.CurrentPage > 1)
    {
        <a data-page="@(Model.CurrentPage - 1)" href="#">Previous</a>
    }

    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        <a data-page="@i" href="#" class="@(i == Model.CurrentPage ? "pagination-active" : "")">@i</a>
    }

    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a data-page="@(Model.CurrentPage + 1)" href="#">Next</a>
    }
</div>

<script>

    const changeActive = (element) => {
        const blockrequestid = element.getAttribute("data-id")
        console.log(blockrequestid)
        $.ajax({
            url: `/Admin/ToggleActive`,
            type: 'POST',
            dataType: 'html',
            data: { blockrequestid: blockrequestid, value: element.checked },
            // Pass your data here
            success: function (response) {
                console.log(response)
            },
            error: function () {
                alert('An error occurred.');
            }
        });
    }

    $(document).ready(function () {
        $('.pagination a').click(function (e) {
            e.preventDefault();
            var page = $(this).attr('data-page');

            filter(page, 10)
        });
    });
</script>