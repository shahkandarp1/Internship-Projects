@using System.Collections;
@model SearchRecordViewModel
@using static HalloDoc.ViewModels.Enums;

<form asp-action="ExportSearchedData" asp-controller="Admin" method="post">
    @Html.HiddenFor(m => m.adminNavbarViewModel.Name)
    @Html.HiddenFor(m => m.adminNavbarViewModel.curr_active)
    @for(var i=0;i<Model.requestTypes.Count;++i)
    {
        @Html.HiddenFor(m => m.requestTypes[i].RequestTypeId)
        @Html.HiddenFor(m => m.requestTypes[i].Name)
    }
    @for (int i = 0; i < Model.alldata.Count; i++)
    {
        @Html.HiddenFor(m => m.alldata[i].AcceptedDate)
        @Html.HiddenFor(m => m.alldata[i].RequestTypeId)
        @Html.HiddenFor(m => m.alldata[i].RequestId)
        @Html.HiddenFor(m => m.alldata[i].Status)
        @Html.HiddenFor(m => m.alldata[i].RequestClient.FirstName)
        @Html.HiddenFor(m => m.alldata[i].RequestClient.LastName)
        @Html.HiddenFor(m => m.alldata[i].RequestClient.PhoneNumber)
        @Html.HiddenFor(m => m.alldata[i].RequestClient.Email)
        @Html.HiddenFor(m => m.alldata[i].RequestClient.Street)
        @Html.HiddenFor(m => m.alldata[i].RequestClient.Address)
        @Html.HiddenFor(m => m.alldata[i].RequestClient.ZipCode)
        @Html.HiddenFor(m => m.alldata[i].RequestClient.State)
        @Html.HiddenFor(m => m.alldata[i].RequestClient.City)
        @Html.HiddenFor(m => m.alldata[i].RequestClient.Notes)
        @Html.HiddenFor(m => m.alldata[i].CreatedDate)
        @Html.HiddenFor(m => m.alldata[i].Physician.FirstName)
        for (int j = 0; j < Model.alldata[i].RequestStatusLogs.ToList().Count; ++j)
        {
            @Html.HiddenFor(m => m.alldata[i].RequestStatusLogs.ToList()[j].Status)
            @Html.HiddenFor(m => m.alldata[i].RequestStatusLogs.ToList()[j].CreatedDate)
            @Html.HiddenFor(m => m.alldata[i].RequestStatusLogs.ToList()[j].Notes)

        }
        for (int j = 0; j < Model.alldata[i].RequestNotes.ToList().Count; ++j)
        {
            @Html.HiddenFor(m => m.alldata[i].RequestNotes.ToList()[j].AdminNotes)
            @Html.HiddenFor(m => m.alldata[i].RequestNotes.ToList()[j].PhysicianNotes)

        }
    }
    <button class="d-none" id="submit-btn"></button>
</form>


<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Patient Name</th>
                <th>Requestor</th>
                <th>Date Of Service</th>
                <th>Close Case Date</th>
                <th>Email</th>
                <th>Phone Number</th>
                <th>Address</th>
                <th>Zip</th>
                <th>Request Status</th>
                <th>Physician Name</th>
                <th>Physician Notes</th>
                <th>Cancelled By Provider Note</th>
                <th>Admin Note</th>
                <th>Patient Note</th>
                <th>Delete Permanently</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.requests)
            {

                var closecasedate = "-";
                List<string> cancelprovicernote = new List<string>();
                foreach(var requeststatuslog in item.RequestStatusLogs)
                {
                    if(requeststatuslog.Status == 9)
                    {
                        closecasedate = requeststatuslog.CreatedDate.ToString("MMMM dd,yyyy");
                    }
                    if (requeststatuslog.Status == 2 && requeststatuslog?.TransToAdmin == new BitArray(new[] { true }))
                    {
                        cancelprovicernote.Add(requeststatuslog.Notes);
                    }
                }

                <tr>
                    <td>@(string.Concat(item.RequestClient.FirstName, ", ", item.RequestClient.LastName))</td>
                    <td>
                        @if(item.RequestTypeId == 1)
                        {
                            <span>Business</span>
                        }
                        else if (item.RequestTypeId == 2)
                        {
                            <span>Patient</span>
                        }
                        else if (item.RequestTypeId == 3)
                        {
                            <span>Family</span>
                        }
                        else
                        {
                            <span>Concierge</span>
                        }
                    </td>
                    <td>@(item.AcceptedDate == null ? "-":item.AcceptedDate?.ToString("MMMM dd,yyyy"))</td>
                    <td>@closecasedate</td>
                    <td>@item.RequestClient.Email</td>
                    <td>@item.RequestClient.PhoneNumber</td>
                    <td>@(string.Concat(item.RequestClient.Street, ", ", item.RequestClient.City, ", ", item.RequestClient.State))</td>
                    <td>@item.RequestClient.ZipCode</td>
                    <td>@Enum.GetName(typeof(Status), @item.Status)</td>
                    <td>
                        @if (item?.Physician?.FirstName == null)
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <span>Dr. @item.Physician.FirstName</span>
                        }
                    </td>
                    <td>
                        @if(item?.RequestNotes.FirstOrDefault()?.PhysicianNotes == null)
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <span>@item?.RequestNotes.FirstOrDefault()?.PhysicianNotes</span>
                        }
                    </td>
                    <td>
                        @if (cancelprovicernote.Count > 0)
                        {
                            @for (var i = 0; i < cancelprovicernote.Count;++i)
                            {
                                <div>@cancelprovicernote[i]</div>
                            }

                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        @if (item?.RequestNotes.FirstOrDefault()?.AdminNotes == null)
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <span>@item?.RequestNotes.FirstOrDefault()?.AdminNotes</span>
                        }
                    </td>
                    <td>
                        @if (item.RequestClient?.Notes == null)
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <span>@item.RequestClient?.Notes</span>
                        }
                    </td>
                    <td><a class="back-btn reset-btn mt-3" id="reset-password" asp-action="DeleteRequest" asp-controller="Admin" asp-route-id="@item.RequestId"><span class="back-text">Delete</span></a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="accordion accordion-flush" id="accordionFlushExample">
    @for (var i = 0; i < Model.requests.Count; ++i)
    {

        var closecasedate = "-";
        List<string> cancelprovicernote = new List<string>();
        var patientcancellation = "";
        var admincancellation = "";
        foreach (var requeststatuslog in Model.requests[i].RequestStatusLogs)
        {
            if (requeststatuslog.Status == 9)
            {
                closecasedate = requeststatuslog.CreatedDate.ToString("MMMM dd,yyyy");
            }
            if (requeststatuslog.Status == 2 && requeststatuslog?.TransToAdmin == new BitArray(new[] { true }))
            {
                cancelprovicernote.Add(requeststatuslog.Notes);
            }
            if (requeststatuslog.Status == 6)
            {
                admincancellation = requeststatuslog.Notes;
            }
            if (requeststatuslog.Status == 7)
            {
                patientcancellation = requeststatuslog.Notes;
            }
        }

        <div class="accordion-item">
            <h2 class="accordion-header" id="flush-heading@(i)">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#flush-collapse@(i)" aria-expanded="false" aria-controls="flush-collapse@(i)">
                    <div class="mb-3">@(string.Concat(Model.requests[i].RequestClient.FirstName, ", ", Model.requests[i].RequestClient.FirstName))</div>
                    <div>@(string.Concat(Model.requests[i].RequestClient.Street, ", ", Model.requests[i].RequestClient.City, ", ", Model.requests[i].RequestClient.State))</div>
                </button>
            </h2>
            <div id="flush-collapse@(i)" class="accordion-collapse collapse" aria-labelledby="flush-heading@(i)"
                 data-bs-parent="#accordionFlushExample">
                <div class="accordion-body main-flex">
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <i class="bi bi-person tick-color"></i>
                        </div>
                        <span class="accordion-heading-inner">
                            Requestor :
                            <span class="accordion-value-inner">
                                @if (Model.requests[i].RequestTypeId == 1)
                                {
                                    <span>Business</span>
                                }
                                else if (Model.requests[i].RequestTypeId == 2)
                                {
                                    <span>Patient</span>
                                }
                                else if (Model.requests[i].RequestTypeId == 3)
                                {
                                    <span>Family</span>
                                }
                                else
                                {
                                    <span>Concierge</span>
                                }
                            </span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/calendar.svg" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Date Of Service :
                            <span class="accordion-value-inner">@(Model.requests[i].AcceptedDate == null ? "-" : Model.requests[i].AcceptedDate?.ToString("MMMM dd,yyyy"))</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/calendar.svg" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Case Closed Service :
                            <span class="accordion-value-inner">@(closecasedate)</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/envelope-black.svg" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Email :
                            <span class="accordion-value-inner">@Model.requests[i].RequestClient.Email</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/telephone-black.svg" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Phone Number :
                            <span class="accordion-value-inner">@Model.requests[i].RequestClient.PhoneNumber</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <i class="bi bi-geo-alt tick-color"></i>
                        </div>
                        <span class="accordion-heading-inner">
                            Address :
                            <span class="accordion-value-inner">@(string.Concat(Model.requests[i].RequestClient.Street, ", ", Model.requests[i].RequestClient.City, ", ", Model.requests[i].RequestClient.State))</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <i class="bi bi-geo-alt tick-color"></i>
                        </div>
                        <span class="accordion-heading-inner">
                            ZipCode :
                            <span class="accordion-value-inner">@(Model.requests[i].RequestClient.ZipCode)</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <i class="bi bi-check tick-color"></i>
                        </div>
                        <span class="accordion-heading-inner">
                            Request Status :
                            <span class="accordion-value-inner">@Enum.GetName(typeof(Status), Model.requests[i].Status)</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <i class="bi bi-person tick-color"></i>
                        </div>
                        <span class="accordion-heading-inner">
                            Provider Name :
                            <span class="accordion-value-inner">
                                @if (Model.requests[i]?.Physician?.FirstName == null)
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <span>Dr. @Model.requests[i].Physician.FirstName</span>
                                }
                            </span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/list.png" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Provider Note :
                            <span class="accordion-value-inner">
                                @if (Model.requests[i]?.RequestNotes.FirstOrDefault()?.PhysicianNotes == null)
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <span>@Model.requests[i]?.RequestNotes.FirstOrDefault()?.PhysicianNotes</span>
                                }
                            </span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/list.png" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Cancelled By Provider Note :
                            <span class="accordion-value-inner">
                                @if (cancelprovicernote.Count > 0)
                                {
                                    @for (var j = 0; j < cancelprovicernote.Count; ++j)
                                    {
                                        <div>@cancelprovicernote[j]</div>
                                    }

                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/list.png" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Admin Note :
                            <span class="accordion-value-inner">
                                @if (Model.requests[i]?.RequestNotes.FirstOrDefault()?.AdminNotes == null)
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <span>@Model.requests[i]?.RequestNotes.FirstOrDefault()?.AdminNotes</span>
                                }
                            </span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/list.png" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Cancellation Reasons :
                            <span class="accordion-value-inner">
                                @if (admincancellation == "" && patientcancellation == "")
                                {
                                    <span>-</span>
                                }
                                else if (admincancellation != "" && patientcancellation == "")
                                {
                                    <span>@admincancellation</span>
                                }
                                else if (admincancellation == "" && patientcancellation != "")
                                {
                                    <span>@patientcancellation</span>
                                }
                                else
                                {
                                    <div>@admincancellation</div>
                                    <div>@patientcancellation</div>
                                }
                            </span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/list.png" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Patient Note :
                            <span class="accordion-value-inner">
                                @if (Model.requests[i].RequestClient?.Notes == null)
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <span>@Model.requests[i].RequestClient?.Notes</span>
                                }
                            </span>
                        </span>
                    </div>
                    <div class="lower-btn-mob-flex">
                        <a class="btn contact-btn" asp-action="DeleteRequest" asp-controller="Admin" asp-route-id="@Model.requests[i].RequestId">Delete Permanently</a>
                        <a class="btn contact-btn" asp-action="ViewCase" asp-controller="Admin" asp-route-id="@Model.requests[i].RequestId">View Case</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


<div class="pagination">
    @if (Model.CurrentPage > 1)
    {
        <a data-page="@(Model.CurrentPage - 1)" href="#">Previous</a>
    }

    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        <a data-page="@i" href="#" class="@(i == Model.CurrentPage ? "pagination-active" : "")">@i</a>
    }

    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a data-page="@(Model.CurrentPage + 1)" href="#">Next</a>
    }
</div>

<script>
    $(document).ready(function () {
        $('.pagination a').click(function (e) {
            e.preventDefault();
            var page = $(this).attr('data-page');

            filter(page, 10)
        });
    });
</script>