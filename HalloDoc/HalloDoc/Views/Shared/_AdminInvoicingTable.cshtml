@model PhysicianInvoicingViewModel

@if ((Model.timesheetDetails != null && Model.timesheetDetails.IsFinalized[0] == false) || Model.timesheetDetails == null)
{
    <div class="bottom-main-container mt-3 mb-3 pb-3 bg-body">
        <div class="no-record-pad admin-no-record-pad">@Model.physician.FirstName @Model.physician.LastName has not finalized timesheet in specified time period.</div>
    </div>
}
else if (Model.timesheetDetails.IsFinalized[0] == true && Model.timesheetDetails.Status == "Not Accepted")
{
    <div class="bottom-main-container mt-3 mb-3 pb-3 bg-body">
        <div class="top-text filter-section">
            <span class="submit-text" id="submit-text">Pending Bi-Weekly Timesheet</span>
        </div>
        <div class="table-responsive">
            <table class="timesheet-table">
                <thead>
                    <tr>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.timesheetDetails.Startdate?.ToString("MMMM dd,yyyy")</td>
                        <td>@Model.timesheetDetails.Enddate?.ToString("MMMM dd,yyyy")</td>
                        <td>@(Model.timesheetDetails.Status == "Not Accepted" ? "Pending" : "Accepted")</td>
                        <td>
                            <a class="back-btn reset-btn db" id="approve-btn">Approve</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.timesheetDetails.IsFinalized[0] == true && Model.timesheetDetails.Status == "Accepted")
{
    <div class="bottom-main-container mt-3 mb-3 pb-3 bg-body">
        <div class="table-responsive">
            <table class="timesheet-table">
                <thead>
                    <tr>
                        <th>Shift Date</th>
                        <th>Shift</th>
                        <th>NightShift Weekend</th>
                        <th>Housecall</th>
                        <th>Housecall Nights Weekend</th>
                        <th>Phone Consults</th>
                        <th>Phone Consults Night Weekend</th>
                        <th>Batch Testing</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.timesheetDetails.TimesheetDetails)
                    {
                        <tr>
                            <td>@item.Shiftdate?.ToString("MMMM dd,yyyy")</td>
                            <td>@item.ShiftHours</td>
                            <td>0</td>
                            <td>
                                @if (item.IsWeekend[0] == false)
                                {
                                    <span>@item.Housecall</span>
                                }
                                else
                                {
                                    <span>0</span>
                                }
                            </td>
                            <td>
                                @if (item.IsWeekend[0] == true)
                                {
                                    <span>@item.Housecall</span>
                                }
                                else
                                {
                                    <span>0</span>
                                }
                            </td>
                            <td>
                                @if (item.IsWeekend[0] == false)
                                {
                                    <span>@item.PhoneConsult</span>
                                }
                                else
                                {
                                    <span>0</span>
                                }
                            </td>
                            <td>
                                @if (item.IsWeekend[0] == true)
                                {
                                    <span>@item.PhoneConsult</span>
                                }
                                else
                                {
                                    <span>0</span>
                                }
                            </td>
                            <td>0</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="bottom-main-container mt-3 mb-3 pb-3 bg-body">
        <div class="top-text filter-section">
            <span class="submit-text" id="submit-text">TimeSheet Reimbursement</span>
        </div>

        <div class="table-responsive">
            <table class="timesheet-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Item</th>
                        <th>Amount</th>
                        <th>Bill</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.timesheetReimbursement.TimesheetReimbursements)
                    {
                        <tr>
                            <td>@item.Date?.ToString("MMMM dd,yyyy")</td>
                            <td>@item.Item</td>
                            <td>@item.Amount</td>
                            <td>@(item.Bill ?? "-")</td>
                            <td>
                                @if (item.Bill != null)
                                {
                                    <a class="back-btn reset-btn db" id="reset-password" onclick="viewDoc('@item.Bill')">View</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
}