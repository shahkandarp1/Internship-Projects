@using System.Collections;
@using System.Diagnostics;
@model AdminDashboardViewModel

<form asp-action="Dashboard" asp-controller="Admin" method="post">
<input type="hidden" asp-for="requestor" id="requestor_submit">
<input type="hidden" asp-for="RegionId" id="region_submit">
<input type="hidden" asp-for="search" id="search_submit">
@Html.HiddenFor(m => m.CurrentPage)
@Html.HiddenFor(m => m.PageSize)
@Html.HiddenFor(m => m.status)
<button class="d-none" id="submit-btn"></button>
<table id="dtBasicExample" class="table">
    <thead class="thead-dark">
        <tr>
            <th>Name</th>
            <th></th>
            @if(Model.adminNavbarViewModel.role == "Admin")
            {
                    
                    @if (Model.status != "Unpaid")
                    {
                        <th>Date Of Birth</th>
                    }
                    @if (Model.status == "New" || Model.status == "Pending" || Model.status == "Active")
                    {
                        <th>Requestor</th>
                    }
                    @if (Model.status != "New")
                    {
                        <th>Physician Name</th>
                        <th>Date Of Service</th>
                    }
                    @if (Model.status == "New")
                    {
                        <th>Requested Date</th>
                    }
                    @if (Model.status != "ToClose")
                    {
                        <th style="min-width: 175px;">Phone</th>
                    }
                    <th>Address</th>
                    @if (Model.status != "Conclude" || Model.status != "Unpaid")
                    {
                        <th>Notes</th>
                    }
                }
                else if (Model.adminNavbarViewModel.role == "Provider")
                {
                    <th style="min-width: 175px;">Phone</th>
                    <th>Address</th>
                    @if(Model.status == "Active")
                    {
                        <th>Status</th>
                    }
                }
                <th>Actions</th>
            </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.requests)
        {

            var admin = Model.adminNavbarViewModel.role == "Admin" ? "" : "hidden";
            var statusClass = "";
            List<string> notes = new List<string>();
            @if (item.RequestTypeId == 1)
            {
                statusClass = "business";
            }
            else if (item.RequestTypeId == 2)
            {
                statusClass = "patient";
            }
            else if (item.RequestTypeId == 3)
            {
                statusClass = "family";
            }
            else
            {
                statusClass = "concierge";
            }
            foreach (var stat in item.RequestStatusLogs)
            {
                if (stat.Status == 1)
                {
                    if (stat.Notes != null)
                    {
                        notes.Add(stat.Notes);
                    }
                }
            }
            <tr class="@statusClass">
                <td>@(string.Concat(item.RequestClient.FirstName, ',', item.RequestClient.LastName))</td>
                <td>
                    <a class="img-container" href="mailto:@item.Email">
                        <img src="../../images/envelope.svg" alt="" />
                    </a>
                </td>
                @if(Model.adminNavbarViewModel.role == "Admin")
                {
                        @if (Model.status != "Unpaid")
                        {

                            DateTime now = DateTime.Today;
                            int age = now.Year - DateTime.Parse($"{item.RequestClient.IntYear}-{item.RequestClient.StrMonth}-{item.RequestClient.IntDate}").Year;
                            if (DateTime.Parse($"{item.RequestClient.IntYear}-{item.RequestClient.StrMonth}-{item.RequestClient.IntDate}") > now.AddYears(-age))
                                age--;

                            <td>@(DateTime.Parse($"{item.RequestClient.IntYear}-{item.RequestClient.StrMonth}-{item.RequestClient.IntDate}").ToString("MMMM dd,yyyy"))(@age)</td>
                        }
                        @if (Model.status == "New" || Model.status == "Pending" || Model.status == "Active")
                        {
                            <td>@(statusClass.Substring(0, 1).ToUpper() + statusClass.Substring(1).ToLower()) @(string.Concat(item.FirstName, ',', item.LastName))</td>
                        }
                        @if (Model.status != "New")
                        {
                            <td>@(item.Physician == null ? "-" : "Dr." + item.Physician.FirstName)</td>
                        }
                        @if (Model.status == "New")
                        {

                            int hoursDifference = (int)(DateTime.Now - item.CreatedDate).TotalHours;
                            int minutesDifference = (DateTime.Now - item.CreatedDate).Minutes;

                            <td><span>@(item.CreatedDate.ToString("MMMM dd,yyyy"))</span><br /><span>@hoursDifference</span>h <span>@minutesDifference</span>m</td>
                        }
                        @if (Model.status != "New")
                        {
                            <td>@item.AcceptedDate?.ToString("MMMM dd,yyyy")</td>
                        }
                        @if (Model.status != "ToClose")
                        {
                            <td>
                                <a href="tel:@item.RequestClient.PhoneNumber" class="phone-container">
                                    <img src="../../images/telephone.svg"
                                         class=""
                                         alt="" /><span class="phone-number">@item.RequestClient.PhoneNumber</span>
                                </a><br />
                                (Patient)<br />
                                @if (item.RequestTypeId != 2)
                                {
                                    <a href="tel:@item.PhoneNumber" class="phone-container mt-2">
                                        <img src="../../images/telephone.svg"
                                             class=""
                                             alt="" /><span class="phone-number">@item.PhoneNumber</span>
                                    </a>

                                    <br />
                                    @($"({statusClass.Substring(0, 1).ToUpper() + statusClass.Substring(1).ToLower()})")
                                }

                            </td>
                        }
                        <td>@(item.RequestClient.Address != null ? string.Concat(item.RequestClient.Address, ',', item.RequestClient.Street, ',', item.RequestClient.City, ',', item.RequestClient.State, ',', item.RequestClient.ZipCode) : string.Concat(item.RequestClient.Street, ',', item.RequestClient.City, ',', item.RequestClient.State, ',', item.RequestClient.ZipCode))</td>
                        @if (Model.status != "Conclude" || Model.status != "Unpaid")
                        {
                            <td>
                                @for (var j = 0; j < notes.Count; ++j)
                                {
                                    <div>@notes[j]</div>
                                }
                            </td>
                        }
                    }
                    else if (Model.adminNavbarViewModel.role == "Provider")
                    {
                        <td>
                            <a href="tel:@item.RequestClient.PhoneNumber" class="phone-container">
                                <img src="../../images/telephone.svg"
                                     class=""
                                     alt="" /><span class="phone-number">@item.RequestClient.PhoneNumber</span>
                            </a><br />
                            (Patient)<br />
                            @if (item.RequestTypeId != 2)
                            {
                                <a href="tel:@item.PhoneNumber" class="phone-container mt-2">
                                    <img src="../../images/telephone.svg"
                                         class=""
                                         alt="" /><span class="phone-number">@item.PhoneNumber</span>
                                </a>

                                <br />
                                @($"({statusClass.Substring(0, 1).ToUpper() + statusClass.Substring(1).ToLower()})")
                            }

                        </td>
                        <td>@(item.RequestClient.Address != null ? string.Concat(item.RequestClient.Address, ',', item.RequestClient.Street, ',', item.RequestClient.City, ',', item.RequestClient.State, ',', item.RequestClient.ZipCode) : string.Concat(item.RequestClient.Street, ',', item.RequestClient.City, ',', item.RequestClient.State, ',', item.RequestClient.ZipCode))</td>
                        @if (Model.status == "Active")
                        {
                            if(item.Status == 4)
                            {
                                <td><a class="status-doctor-btn" asp-action="HouseCall" asp-controller="Doctor" asp-route-id="@item.RequestId"><span>House Call</span></a></td>
                            }
                            else
                            {
                                <td></td>                                
                            }
                        }
                    }
                    <td>
                    <div class="dropdown show">
                        <button class="btn action-btn"
                                role="button"
                                id="dropdownMenuLink"
                                data-bs-toggle="dropdown"
                                aria-haspopup="true"
                                aria-expanded="false">
                            Actions
                        </button>
                        <div class="dropdown-menu"
                             aria-labelledby="dropdownMenuLink">
                            @if (Model.status == "New")
                            {
                                    <a class="dropdown-item assign-case @admin" href="#" data-id="@item.RequestId" data-region-id="@item.RequestClient.RegionId"><div class="action-item"><img src="../../images/list.png" alt="" class="action-img"><span>Assign Case</span></div></a>
                                <a class="dropdown-item cancel-case @admin" href="#" data-id="@item.RequestId" data-name="@(string.Concat(item.RequestClient.FirstName, ' ', item.RequestClient.LastName))"><div class="action-item"><img src="../../images/x-mark.png" alt="" class="action-img"><span>Cancel Case</span></div></a>
                            }
                            @if (Model.status == "New" || Model.status == "Pending" || Model.status == "Active" || Model.status == "Conclude" || Model.status == "ToClose" || Model.status == "Unpaid")
                            {
                                <a class="dropdown-item" asp-action="ViewCase" asp-controller="Admin" asp-route-id="@(item.RequestId)"><div class="action-item"><img src="../../images/file.png" alt="" class="action-img"><span>View Case</span></div></a>
                            }
                            @if (Model.status == "New" || Model.status == "Pending" || Model.status == "Active" || Model.status == "Conclude" || Model.status == "ToClose" || Model.status == "Unpaid")
                            {
                                    <a class="dropdown-item" asp-action="ViewNotes" asp-controller="Admin" asp-route-id="@item.RequestId"><div class="action-item"><img src="../../images/paper.png" alt="" class="action-img"><span>View Notes</span></div></a>
                            }
                            @if (Model.status == "New")
                            {
                                    <a class="dropdown-item block-case @admin" data-id="@item.RequestId" data-name="@(string.Concat(item.RequestClient.FirstName, ' ', item.RequestClient.LastName))"><div class="action-item"><img src="../../images/blocked.png" alt="" class="action-img"><span>Block Patient</span></div></a>
                            }
                            @if (Model.status == "Pending" || Model.status == "Active" || Model.status == "Conclude" || Model.status == "ToClose" || Model.status == "Unpaid")
                            {
                                <a class="dropdown-item" asp-action="ViewUploads" asp-controller="Admin" asp-route-id="@item.RequestId"><div class="action-item"><img src="../../images/upload.png" alt="" class="action-img"><span>View Uploads</span></div></a>
                            }
                            @if (Model.status == "Pending")
                            {
                                    <a class="dropdown-item transfer-case @admin" href="#" data-id="@item.RequestId" data-region-id="@item.RequestClient.RegionId"><div class="action-item"><img src="../../images/list.png" alt="" class="action-img"><span>Transfer</span></div></a>
                            }
                            @if (Model.status == "Pending" || Model.status == "ToClose")
                            {
                                    <a class="dropdown-item clear-case @admin" href="#" data-id="@item.RequestId"><div class="action-item"><img src="../../images/x-mark.png" alt="" class="action-img"><span>Clear Case</span></div></a>
                            }
                            @if (Model.status == "Pending")
                            {
                                    <a class="dropdown-item send-agreement" href="#" data-id="@item.RequestId" data-type-id="@item.RequestTypeId" data-email="@item.RequestClient.Email" data-phonenumber="@item.RequestClient.PhoneNumber"><div class="action-item"><img src="../../images/document-symbol-with-text-lines.png" alt="" class="action-img"><span>Send Agreement</span></div></a>
                            }
                            @if (Model.status == "Conclude" || Model.status == "ToClose" || Model.status == "Active")
                            {
                                    <a class="dropdown-item @admin" asp-action="Orders" asp-controller="Admin" asp-route-id="@item.RequestId"><div class="action-item"><img src="../../images/list.png" alt="" class="action-img"><span>Orders</span></div></a>
                                    <a class="dropdown-item @admin" asp-action="EncounterForm" asp-controller="Admin" asp-route-id="@item.RequestId"><div class="action-item"><img src="../../images/document-symbol-with-text-lines.png" alt="" class="action-img"><span>Encounter</span></div></a>
                            }
                            @if (Model.status == "ToClose")
                            {
                                    <a class="dropdown-item @admin" asp-action="CloseCase" asp-controller="Admin" asp-route-id="@item.RequestId"><div class="action-item"><img src="../../images/x-mark.png" alt="" class="action-img"><span>Close Case</span></div></a>
                            }
                            @if (Model.status == "New" && Model.adminNavbarViewModel.role == "Provider")
                            {
                                    <a class="dropdown-item" asp-action="AcceptCase" asp-controller="Doctor" asp-route-id="@item.RequestId"><div class="action-item"><img src="../../images/list.png" alt="" class="action-img"><span>Accept</span></div></a>
                            }
                            @if (Model.status == "Active" && Model.adminNavbarViewModel.role == "Provider")
                            {
                                    <a class="dropdown-item" asp-action="Orders" asp-controller="Admin" asp-route-id="@item.RequestId"><div class="action-item"><img src="../../images/list.png" alt="" class="action-img"><span>Orders</span></div></a>
                            }
                            @if (Model.status == "Conclude" && Model.adminNavbarViewModel.role == "Provider")
                            {
                                <a class="dropdown-item" asp-action="ConcludeCare" asp-controller="Doctor" asp-route-id="@item.RequestId"><div class="action-item"><img src="../../images/heart-rate.png" alt="" class="action-img"><span>Conclude Care</span></div></a>
                            }
                            @if ((Model.status == "Conclude" || Model.status == "Active") && Model.adminNavbarViewModel.role == "Provider")
                            {
                                if (item.Status == 3)
                                {
                                    <a class="dropdown-item type-of-care" data-id="@item.RequestId"><div class="action-item"><img src="../../images/document-symbol-with-text-lines.png" alt="" class="action-img"><span>Encounter</span></div></a>
                                }
                                else if ((item.Status == 4 || item.Status == 5) && (item.EncounterForms.ToList().Count == 0 || (item.EncounterForms.ToList().Count > 0 && item.EncounterForms.ToList()[0].IsFinalized[0] == false)))
                                {
                                    <a class="dropdown-item" asp-action="EncounterForm" asp-controller="Doctor" asp-route-id="@item.RequestId"><div class="action-item"><img src="../../images/document-symbol-with-text-lines.png" alt="" class="action-img"><span>Encounter</span></div></a>
                                }
                                else if ((item.Status == 4 || item.Status == 5) && (item.EncounterForms.ToList().Count > 0 && item.EncounterForms.ToList()[0].IsFinalized[0] == true))
                                {
                                    <a class="dropdown-item finalize-encounter" data-id="@item.RequestId"><div class="action-item"><img src="../../images/document-symbol-with-text-lines.png" alt="" class="action-img"><span>Encounter</span></div></a>
                                }
                            }
                            @if (Model.status == "Pending" && Model.adminNavbarViewModel.role == "Provider")
                            {
                                <a class="dropdown-item transfer-doctor-case" href="#" data-id="@item.RequestId"><div class="action-item"><img src="../../images/list.png" alt="" class="action-img"><span>Transfer</span></div></a>
                            }

                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@for(var i=0;i<Model.requests.Count;++i)
{
    var admin = Model.adminNavbarViewModel.role == "Admin" ? "" : "hidden";
    var statusClass = "";
    List<string> notes = new List<string>();
    @if (Model.requests[i].RequestTypeId == 1)
    {
        statusClass = "business";
    }
    else if (Model.requests[i].RequestTypeId == 2)
    {
        statusClass = "patient";
    }
    else if (Model.requests[i].RequestTypeId == 3)
    {
        statusClass = "family";
    }
    else
    {
        statusClass = "concierge";
        }
        foreach (var stat in Model.requests[i].RequestStatusLogs)
        {
            if (stat.Status == 1)
            {
                if(stat.Notes!=null)
                {
                    notes.Add(stat.Notes);
                }
            }
    }
    <div class="accordion accordion-flush" id="accordionFlushExample">
        <div class="accordion-item">
            <h2 class="accordion-header" id="flush-heading@(i)">
                <button class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#flush-collapse@(i)"
                        aria-expanded="false"
                        aria-controls="flush-collapse@(i)">
                    <div class="accordion-top-flex">
                        <span class="accordion-value"> @(string.Concat(Model.requests[i].RequestClient.FirstName, ',', Model.requests[i].RequestClient.LastName)) </span>
                        @if(Model.requests[i].RequestTypeId == 2)
                        {
                            <div class="req-accordion-filter Patient">
                                <span class="requestor-type accordion-requestor">Patient</span>
                                <span class="color patient-color"></span>
                            </div>
                        }
                        else if (Model.requests[i].RequestTypeId == 1)
                        {
                            <div class="req-accordion-filter Patient">
                                <span class="requestor-type accordion-requestor">Business</span>
                                <span class="color business-color"></span>
                            </div>
                        }
                        else if(Model.requests[i].RequestTypeId == 3)
                        {
                            <div class="req-accordion-filter Patient">
                                <span class="requestor-type accordion-requestor">Family</span>
                                <span class="color family-color"></span>
                            </div>
                        }
                        else
                        {
                            <div class="req-accordion-filter Patient">
                                <span class="requestor-type accordion-requestor">Concierge</span>
                                <span class="color concierge-color"></span>
                            </div>
                        }
                    </div>
                    <div class="accordion-top-flex">
                        <div class="accordion-value mob-address">@(Model.requests[i].RequestClient.Address != null ? string.Concat(Model.requests[i].RequestClient.Address, ',', Model.requests[i].RequestClient.Street, ',', Model.requests[i].RequestClient.City, ',', Model.requests[i].RequestClient.State, ',', Model.requests[i].RequestClient.ZipCode) : string.Concat(Model.requests[i].RequestClient.Street, ',', Model.requests[i].RequestClient.City, ',', Model.requests[i].RequestClient.State, ',', Model.requests[i].RequestClient.ZipCode))</div>
                            <div class="map-btn map-abs-btn" data-address="@(string.Concat(Model.requests[i].RequestClient.Street, ',', Model.requests[i].RequestClient.City, ',', Model.requests[i].RequestClient.State, ',', Model.requests[i].RequestClient.ZipCode))">Map Location</div>
                    </div>
                    @if(Model.status == "New" && Model.adminNavbarViewModel.role == "Admin")
                    {
                        <div class="mt-1">
                            <img src="../../images/clock.svg" alt="" class="accordion-img"> <span class="accordion-value">
                                Created
                                Date: <span class="accordion-value">@Model.requests[i].CreatedDate.ToString("MMMM dd,yyyy")</span>
                            </span>
                        </div>
                    }
                </button>
            </h2>
            <div id="flush-collapse@(i)"
                 class="accordion-collapse collapse"
                 aria-labelledby="flush-heading@(i)"
                 data-bs-parent="#accordionFlushExample">
                    <a class="map-btn view-case-btn" asp-action="ViewCase" asp-controller="Admin" asp-route-id="@(Model.requests[i].RequestId)">View Case</a>
                <div class="accordion-body main-flex">
                    
                    @if(Model.adminNavbarViewModel.role == "Admin")
                        {
                            @if (Model.status != "Unpaid")
                            {
                                DateTime now = DateTime.Today;
                                int age = now.Year - DateTime.Parse($"{Model.requests[i].RequestClient.IntYear}-{Model.requests[i].RequestClient.StrMonth}-{Model.requests[i].RequestClient.IntDate}").Year;
                                if (DateTime.Parse($"{Model.requests[i].RequestClient.IntYear}-{Model.requests[i].RequestClient.StrMonth}-{Model.requests[i].RequestClient.IntDate}") > now.AddYears(-age))
                                    age--;
                                <div class="inner-flex">
                                    <div class="outer-img-circle">
                                        <img src="../../images/calendar.svg" alt="" class="inner-img">
                                    </div>
                                    <span class="accordion-heading-inner">
                                        Date Of Birth :
                                        <span class="accordion-value-inner">@(DateTime.Parse($"{Model.requests[i].RequestClient.IntYear}-{Model.requests[i].RequestClient.StrMonth}-{Model.requests[i].RequestClient.IntDate}").ToString("MMMM dd,yyyy"))(@age)</span>
                                    </span>
                                </div>
                            }
                            <div class="inner-flex">
                                <div class="outer-img-circle">
                                    <img src="../../images/envelope-black.svg" alt="" class="inner-img">
                                </div>
                                <span class="accordion-heading-inner">
                                    Email :
                                    <span class="accordion-value-inner">@Model.requests[i].Email</span>
                                </span>
                            </div>
                            @if (Model.status != "ToClose")
                            {
                                <div class="inner-flex">
                                    <div class="outer-img-circle">
                                        <img src="../../images/telephone-black.svg" alt="" class="inner-img">
                                    </div>
                                    <span class="accordion-heading-inner">
                                        Patient :
                                        <span class="accordion-value-inner">@Model.requests[i].PhoneNumber</span>
                                    </span>
                                </div>
                            }

                            @if (Model.status != "ToClose" || Model.status != "Conclude" || Model.status != "Unpaid")
                            {
                                <div class="inner-flex">
                                    <div class="outer-img-circle">
                                        <img src="../../images/person.svg" alt="" class="inner-img">
                                    </div>
                                    <span class="accordion-heading-inner">
                                        Requestor :
                                        <span class="accordion-value-inner">
                                            @(statusClass.Substring(0, 1).ToUpper() + statusClass.Substring(1).ToLower()) @(string.Concat(Model.requests[i].FirstName, ',', Model.requests[i].LastName))
                                        </span>
                                    </span>
                                </div>
                            }

                            @if (Model.status != "New" || Model.status != "Conclude" || Model.status != "Unpaid")
                            {
                                <div class="inner-flex">
                                    <div class="outer-img-circle">
                                        <img src="../../images/file-earmark-text.svg" alt="" class="inner-img">
                                    </div>
                                    <span class="accordion-heading-inner">
                                        Transfer Notes :
                                        <span class="accordion-value-inner">
                                            @for (var k = 0; k < notes.Count; ++k)
                                            {
                                                <div>@notes[k]</div>
                                            }
                                        </span>
                                    </span>
                                </div>
                            }

                            @if (Model.status != "New")
                            {
                                <div class="inner-flex">
                                    <div class="outer-img-circle">
                                        <img src="../../images/calendar.svg" alt="" class="inner-img">
                                    </div>
                                    <span class="accordion-heading-inner">
                                        Date Of Service :
                                        <span class="accordion-value-inner">
                                            @Model.requests[i].AcceptedDate?.ToString("MMMM dd,yyyy")
                                        </span>
                                    </span>
                                </div>
                                <div class="inner-flex">
                                    <div class="outer-img-circle">
                                        <img src="../../images/person.svg" alt="" class="inner-img">
                                    </div>
                                    <span class="accordion-heading-inner">
                                        Physician :
                                        <span class="accordion-value-inner">
                                            @(Model.requests[i].Physician == null ? "-" : "Dr." + Model.requests[i].Physician.FirstName)
                                        </span>
                                    </span>
                                </div>

                            }
                        }
                        else if (Model.adminNavbarViewModel.role == "Provider")
                        {
                            @if(Model.status == "New")
                            {
                                DateTime now = DateTime.Today;
                                int age = now.Year - DateTime.Parse($"{Model.requests[i].RequestClient.IntYear}-{Model.requests[i].RequestClient.StrMonth}-{Model.requests[i].RequestClient.IntDate}").Year;
                                if (DateTime.Parse($"{Model.requests[i].RequestClient.IntYear}-{Model.requests[i].RequestClient.StrMonth}-{Model.requests[i].RequestClient.IntDate}") > now.AddYears(-age))
                                    age--;
                                <div class="inner-flex">
                                    <div class="outer-img-circle">
                                        <img src="../../images/calendar.svg" alt="" class="inner-img">
                                    </div>
                                    <span class="accordion-heading-inner">
                                        Date Of Birth :
                                        <span class="accordion-value-inner">@(DateTime.Parse($"{Model.requests[i].RequestClient.IntYear}-{Model.requests[i].RequestClient.StrMonth}-{Model.requests[i].RequestClient.IntDate}").ToString("MMMM dd,yyyy"))(@age)</span>
                                    </span>
                                </div>
                            }
                            <div class="inner-flex">
                                <div class="outer-img-circle">
                                    <img src="../../images/envelope-black.svg" alt="" class="inner-img">
                                </div>
                                <span class="accordion-heading-inner">
                                    Email :
                                    <span class="accordion-value-inner">@Model.requests[i].Email</span>
                                </span>
                            </div>
                            <div class="inner-flex">
                                <div class="outer-img-circle">
                                    <img src="../../images/telephone-black.svg" alt="" class="inner-img">
                                </div>
                                <span class="accordion-heading-inner">
                                    Patient :
                                    <span class="accordion-value-inner">@Model.requests[i].PhoneNumber</span>
                                </span>
                            </div>
                        }

                    <div class="row">
                        @if (Model.status == "New")
                        {
                                <a class="col-md-3 col-sm-6 col-6 assign-case @admin" data-id="@Model.requests[i].RequestId" data-region-id="@Model.requests[i].RequestClient.RegionId"><div class="action-mob-btn">Assign Case</div></a>
                                <a class="col-md-3 col-sm-6 col-6 cancel-case @admin" data-id="@Model.requests[i].RequestId" data-name="@(string.Concat(Model.requests[i].RequestClient.FirstName, ' ', Model.requests[i].RequestClient.LastName))"><div class="action-mob-btn">Cancel Case</div></a>
                        }
                        @if (Model.status == "New" || Model.status == "Pending" || Model.status == "Active" || Model.status == "Conclude" || Model.status == "ToClose" || Model.status == "Unpaid")
                        {
                                <a class="col-md-3 col-sm-6 col-6" asp-action="ViewNotes" asp-controller="Admin" asp-route-id="@Model.requests[i].RequestId"><div class="action-mob-btn">View Notes</div></a>
                        }
                        @if (Model.status == "New")
                        {
                                <a class="col-md-3 col-sm-6 col-6 block-case @admin" data-id="@Model.requests[i].RequestId" data-name="@(string.Concat(Model.requests[i].RequestClient.FirstName, ' ', Model.requests[i].RequestClient.LastName))"><div class="action-mob-btn">Block Patient</div></a>
                        }
                        @if (Model.status == "Pending" || Model.status == "Active" || Model.status == "Conclude" || Model.status == "ToClose" || Model.status == "Unpaid")
                        {
                            <a class="col-md-3 col-sm-6 col-6" asp-action="ViewUploads" asp-controller="Admin" asp-route-id="@Model.requests[i].RequestId"><div class="action-mob-btn">View Uploads</div></a>
                        }
                        @if (Model.status == "Pending")
                        {
                                <a class="col-md-3 col-sm-6 col-6 transfer-case @admin" data-id="@Model.requests[i].RequestId" data-region-id="@Model.requests[i].RequestClient.RegionId"><div class="action-mob-btn">Transfer</div></a>
                        }
                        @if (Model.status == "Pending" || Model.status == "ToClose")
                        {
                                <a class="col-md-3 col-sm-6 col-6 clear-case @admin" data-id="@Model.requests[i].RequestId"><div class="action-mob-btn">Clear Case</div></a>
                        }
                        @if (Model.status == "Pending")
                        {
                                <a class="col-md-3 col-sm-6 col-6 send-agreement" data-id="@Model.requests[i].RequestId" data-type-id="@Model.requests[i].RequestTypeId" data-email="@Model.requests[i].RequestClient.Email" data-phonenumber="@Model.requests[i].RequestClient.PhoneNumber"><div class="action-mob-btn">Send Agreement</div></a>
                        }
                        @if (Model.status == "Conclude" || Model.status == "ToClose" || Model.status == "Active")
                        {
                                <a class="col-md-3 col-sm-6 col-6 @admin" asp-action="EncounterForm" asp-controller="Admin" asp-route-id="@Model.requests[i].RequestId"><div class="action-mob-btn">Encounter</div></a>
                        }
                        @if (Model.status == "Conclude" || Model.status == "Active")
                        {
                                <a class="col-md-3 col-sm-6 col-6 @admin" asp-action="Orders" asp-controller="Admin" asp-route-id="@Model.requests[i].RequestId"><div class="action-mob-btn">Orders</div></a>
                        }
                        @if (Model.status == "ToClose")
                        {
                                <a class="col-md-3 col-sm-6 col-6" asp-action="CloseCase" asp-controller="Admin" asp-route-id="@Model.requests[i].RequestId"><div class="action-mob-btn">Close Case</div></a>
                        }
                        @if (Model.status == "Active" && Model.adminNavbarViewModel.role == "Provider")
                        {
                            <a class="col-md-3 col-sm-6 col-6" asp-action="Orders" asp-controller="Admin" asp-route-id="@Model.requests[i].RequestId"><div class="action-mob-btn">Orders</div></a>
                        }
                        @if (Model.status == "Active" && Model.adminNavbarViewModel.role == "Provider" && Model.requests[i].Status == 4)
                        {
                                <a class="col-md-3 col-sm-6 col-6" asp-action="HouseCall" asp-controller="Doctor" asp-route-id="@Model.requests[i].RequestId"><div class="action-mob-btn">House Call</div></a>
                        }
                        @if (Model.status == "New" && Model.adminNavbarViewModel.role == "Provider")
                        {
                                <a class="col-md-3 col-sm-6 col-6" asp-action="AcceptCase" asp-controller="Doctor" asp-route-id="@Model.requests[i].RequestId"><div class="action-mob-btn">Accept</div></a>
                        }
                        @if (Model.status == "Conclude" && Model.adminNavbarViewModel.role == "Provider")
                        {
                            <a class="col-md-3 col-sm-6 col-6" asp-action="ConcludeCare" asp-controller="Doctor" asp-route-id="@Model.requests[i].RequestId"><div class="action-mob-btn">Conclude Care</div></a>
                        }
                        @if ((Model.status == "Conclude" || Model.status == "Active") && Model.adminNavbarViewModel.role == "Provider")
                        {
                            if(Model.requests[i].Status == 3)
                            {
                                <a class="col-md-3 col-sm-6 col-6 type-of-care" data-id="@Model.requests[i].RequestId"><div class="action-mob-btn">Encounter</div></a>
                            }
                                else if ((Model.requests[i].Status == 4 || Model.requests[i].Status == 5) && (Model.requests[i].EncounterForms.ToList().Count == 0 || (Model.requests[i].EncounterForms.ToList().Count > 0 && Model.requests[i].EncounterForms.ToList()[0].IsFinalized[0] == false)))
                            {
                                <a class="col-md-3 col-sm-6 col-6" asp-action="EncounterForm" asp-controller="Doctor" asp-route-id="@Model.requests[i].RequestId"><div class="action-mob-btn">Encounter</div></a>
                            }
                                else if ((Model.requests[i].Status == 4 || Model.requests[i].Status == 5) && (Model.requests[i].EncounterForms.ToList().Count > 0 && Model.requests[i].EncounterForms.ToList()[0].IsFinalized[0] == true))
                            {
                                <a class="col-md-3 col-sm-6 col-6 finalize-encounter" data-id="@Model.requests[i].RequestId"><div class="action-mob-btn">Encounter</div></a>
                            }
                        }
                            @if (Model.status == "Pending" && Model.adminNavbarViewModel.role == "Provider")
                        {
                                <a class="col-md-3 col-sm-6 col-6 transfer-doctor-case" data-id="@Model.requests[i].RequestId"><div class="action-mob-btn">Transfer</div></a>
                        }
                            <a class="col-md-3 col-sm-6 col-6" href="mailto:@Model.requests[i].Email"><div class="action-mob-btn">Email</div></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

    <div class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <a data-page="@(Model.CurrentPage - 1)" href="#">Previous</a>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a data-page="@i" href="#" class="@(i == Model.CurrentPage ? "pagination-active" : "")">@i</a>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a data-page="@(Model.CurrentPage + 1)" href="#">Next</a>
        }
    </div>
</form>

<script>
    var divs = document.getElementsByClassName("cancel-case")

    for(let i=0;i<divs.length;++i)
    {
        divs[i].onclick = function () {
            var id = divs[i].getAttribute("data-id");
            var name = divs[i].getAttribute("data-name");
            openCancel(id, name);
        };
    }

    var assign = document.getElementsByClassName("assign-case")
    for (let i = 0; i < assign.length; ++i) {
        assign[i].onclick = function () {
            var id = assign[i].getAttribute("data-id");
            var regionid = assign[i].getAttribute("data-region-id");
            openAssign(id, regionid);
        };
    }

    var send_agreement = document.getElementsByClassName("send-agreement")
    for (let i = 0; i < send_agreement.length; ++i) {
        send_agreement[i].onclick = function () {
            var id = send_agreement[i].getAttribute("data-id");
            var typeid = send_agreement[i].getAttribute("data-type-id");
            var email = send_agreement[i].getAttribute("data-email");
            var phonenumber = send_agreement[i].getAttribute("data-phonenumber");
            openAgreement(id, typeid,email,phonenumber);
        };
    }

    var block = document.getElementsByClassName("block-case")
    for (let i = 0; i < block.length; ++i) {
        block[i].onclick = function () {
            var id = block[i].getAttribute("data-id");
            var name = block[i].getAttribute("data-name");
            openBlock(id, name);
        };
    }

    var map = document.getElementsByClassName("map-abs-btn")
    for(let i=0;i<map.length;++i)
    {
        map[i].onclick = function () {
            var address = map[i].getAttribute("data-address");
            openMap(address);
        };
    }

    var transfer = document.getElementsByClassName("transfer-case")
    for (let i = 0; i < transfer.length; ++i) {
        transfer[i].onclick = function () {
            var id = transfer[i].getAttribute("data-id");
            var regionid = transfer[i].getAttribute("data-region-id");
            openTransfer(id, regionid);
        };
    }

    var clear = document.getElementsByClassName("clear-case")
    for (let i = 0; i < clear.length; ++i) {
        clear[i].onclick = function () {
            var id = clear[i].getAttribute("data-id");
            openClear(id);
        };
    }
    
    var type = document.getElementsByClassName("type-of-care")
    for (let i = 0; i < type.length; ++i) {
        type[i].onclick = function () {
            var id = type[i].getAttribute("data-id");
            openTypeOfCare(id);
        };
    }
    
    var finalize = document.getElementsByClassName("finalize-encounter")
    for (let i = 0; i < finalize.length; ++i) {
        finalize[i].onclick = function () {
            var id = finalize[i].getAttribute("data-id");
            openFinalize(id);
        };
    }
    
    var transferDoctor = document.getElementsByClassName("transfer-doctor-case")
    for (let i = 0; i < transferDoctor.length; ++i) {
        transferDoctor[i].onclick = function () {
            var id = transferDoctor[i].getAttribute("data-id");
            openTransferDoctor(id);
        };
    }

    const openTransferDoctor = (id) => {
        document.getElementById("reqTransferId").value = id
        $("#myModalTransferDoctor").modal("show");
    }

    const openFinalize = (id) => {
        document.getElementById("reqFinalizeId").value = id
        $("#myModalEncounterFinalized").modal("show");
    }

    const openTypeOfCare = (id) => {
        document.getElementById("reqId").value = id
        $("#myModalEncounterActive").modal("show");
    }

    const openMap = (address) => {
        console.log(address)
        
        var Street = address.split(",")[0];
        var City = address.split(",")[1];
        var State = address.split(",")[2];
        var ZipCode = address.split(",")[3];
        var address = "https://maps.google.com/maps?q=" + Street + City + State + ZipCode + "&t=&z=13&ie=UTF8&iwloc=&output=embed";
        $("#gmap_canvas").attr("src", address);
        $("#myModal1").modal("show");
    }

    const openClear = (id) => {

        console.log(id)
        document.getElementById("req-clear-id").value = id
        $("#myModalClear").modal("show");
    }


    const openCancel = (id,name) => {
        document.getElementById("pt-name").innerHTML = name
        document.getElementById("req-id").value = id
        $("#myModal").modal("show");
    }

    const openBlock = (id, name) => {
        document.getElementById("pt-block-name").innerHTML = name
        document.getElementById("req-block-id").value = id
        $("#myModalBlock").modal("show");
    }

    const openAgreement = (id, typeid,email,phonenumber) => {
        document.getElementById("business-agreement").style.display = "none";
        document.getElementById("patient-agreement").style.display = "none";
        document.getElementById("family-agreement").style.display = "none";
        document.getElementById("concierge-agreement").style.display = "none";
        if(typeid == 1)
        {
            document.getElementById("business-agreement").style.display = "block";
        }
        else if(typeid == 2)
        {
            document.getElementById("patient-agreement").style.display = "block";
        }
        else if (typeid == 3) {
            document.getElementById("family-agreement").style.display = "block";
        }
        else{
            document.getElementById("concierge-agreement").style.display = "block";
        }
        document.getElementById("req-agreement-id").value = id
        document.getElementById("agreement-phone").value = phonenumber
        document.getElementById("agreement-email").value = email
        $("#myModalAgreement").modal("show");
    }


    const openTransfer = (id, regionid) => {
        console.log(id)
        console.log(regionid)
        const selectElement = document.getElementById("Select-region-t");
        for (const option of selectElement.options) {
            if (option.value == regionid) {
                option.selected = true;
                break;
            }
        }
        const selectphysician = document.getElementById("Select-physician-t");
        selectphysician.innerHTML = "";
        const firstoption = document.createElement("option");
        firstoption.textContent = "Select Physician"
        firstoption.value = -1
        selectphysician.append(firstoption);
        $.get('/Admin/GetPhysician', { regionid: regionid }, function (response) {
            for (let i = 0; i < response.data.length; ++i) {
                const newOption = document.createElement("option");
                newOption.textContent = response.data[i].firstName + " " + response.data[i].lastName
                newOption.value = response.data[i].physicianId
                selectphysician.append(newOption);
            }
        });
        document.getElementById("req-transfer-id").value = id
        $("#myModalTransfer").modal("show");
    }

    const openAssign = (id,regionid) => {
        console.log(id)
        console.log(regionid)
        const selectElement = document.getElementById("Select-region");
        for (const option of selectElement.options) {
            if (option.value == regionid) {
                option.selected = true;
                break;
            }
        }
        const selectphysician = document.getElementById("Select-physician");
        selectphysician.innerHTML = "";
        const firstoption = document.createElement("option");
        firstoption.textContent = "Select Physician"
        firstoption.value = -1
        selectphysician.append(firstoption);
        $.get('/Admin/GetPhysician', { regionid:regionid  }, function (response) {
            for(let i=0;i<response.data.length;++i)
            {
                const newOption = document.createElement("option");
                newOption.textContent = response.data[i].firstName + " " + response.data[i].lastName
                newOption.value = response.data[i].physicianId
                selectphysician.append(newOption);
            }
        });
        document.getElementById("req-assign-id").value = id
        $("#myModalAssign").modal("show");
    }

    $(document).ready(function () {
        $('.pagination a').click(function (e) {
            e.preventDefault();
            var page = $(this).attr('data-page');

            filter(page,10)
        });
    });
</script>