@model EmailLogViewModel

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Recipient</th>
                <th>Action</th>
                <th>Role Name</th>
                <th>Mobile Number</th>
                <th>Create Date</th>
                <th>Sent Date</th>
                <th>Sent</th>
                <th>Sent Tries</th>
                <th>Confirmation Number</th>
            </tr>
        </thead>
        @foreach (var item in Model.logViewModels)
        {
            <tbody>
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Action</td>
                    <td>@item.RoleName</td>
                    <td>@item.PhoneNumber</td>
                    <td>@item.CreatedDate?.ToString("MMMM dd,yyyy")</td>
                    <td>
                        @if (item.Sent == "Yes")
                        {
                            <span>@item.SentDate?.ToString("MMMM dd,yyyy")</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>@item.Sent</td>
                    <td>@item.SentTries</td>
                    <td>@item.ConfirmationNumber</td>
                </tr>
            </tbody>
        }
    </table>
</div>

<div class="accordion accordion-flush" id="accordionFlushExample">
    @for (var i = 0; i < Model.logViewModels.Count; ++i)
    {

        <div class="accordion-item">
            <h2 class="accordion-header" id="flush-heading@(i)">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#flush-collapse@(i)" aria-expanded="false" aria-controls="flush-collapse@(i)">
                    <div class="mb-3">@Model.logViewModels[i].Name</div>
                    <span class="accordion-heading-inner mb-1">
                        Action Name :
                        <span class="accordion-value-inner">@Model.logViewModels[i].Action</span>
                    </span>
                    <span class="accordion-heading-inner">
                        Mobile Number :
                        <span class="accordion-value-inner">@Model.logViewModels[i].PhoneNumber</span>
                    </span>
                </button>
            </h2>
            <div id="flush-collapse@(i)" class="accordion-collapse collapse" aria-labelledby="flush-heading@(i)"
                 data-bs-parent="#accordionFlushExample">
                <div class="accordion-body main-flex">
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <i class="bi bi-person tick-color"></i>
                        </div>
                        <span class="accordion-heading-inner">
                            Role Name :
                            <span class="accordion-value-inner">@Model.logViewModels[i].RoleName</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/calendar.svg" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Create Date :
                            <span class="accordion-value-inner">@Model.logViewModels[i].CreatedDate?.ToString("MMMM dd,yyyy")</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/calendar.svg" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Sent Date :
                            <span class="accordion-value-inner">@Model.logViewModels[i].SentDate?.ToString("MMMM dd,yyyy")</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <i class="bi bi-check tick-color"></i>
                        </div>
                        <span class="accordion-heading-inner">
                            Sent :
                            <span class="accordion-value-inner">@Model.logViewModels[i].Sent</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/envelope-black.svg" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Sent Tries :
                            <span class="accordion-value-inner">@Model.logViewModels[i].SentTries</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <i class="bi bi-check tick-color"></i>
                        </div>
                        <span class="accordion-heading-inner">
                            Confirmation Number :
                            <span class="accordion-value-inner">@Model.logViewModels[i].ConfirmationNumber</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


<div class="pagination">
    @if (Model.CurrentPage > 1)
    {
        <a data-page="@(Model.CurrentPage - 1)" href="#">Previous</a>
    }

    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        <a data-page="@i" href="#" class="@(i == Model.CurrentPage ? "pagination-active" : "")">@i</a>
    }

    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a data-page="@(Model.CurrentPage + 1)" href="#">Next</a>
    }
</div>

<script>
    $(document).ready(function () {
        $('.pagination a').click(function (e) {
            e.preventDefault();
            var page = $(this).attr('data-page');

            filter(page, 10)
        });
    });
</script>