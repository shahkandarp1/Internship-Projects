@using static HalloDoc.ViewModels.Enums;
@model DashboardViewModel

<!-- Table View - Desktop -->


        <table class="table">
            <thead>
                <tr>
                    <th class="heading">Created date</th>
                    <th class="heading">Current Status</th>
                    <th class="heading">Chat With</th>
                    <th class="heading">Document</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.requests)
                {
                    <tr>
                        <td>@row.CreatedDate.ToString("MMMM dd,yyyy")</td>
                        <td>@Enum.GetName(typeof(Status), @row.Status)</td>
                        <td>
                            <span class="chat-section">
                                <span class="chat-btn" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight-Admin-@(row.RequestId)" aria-controls="offcanvasRight-Admin-@(row.RequestId)" data-reqid="@row.RequestId" data-aspid="@row.aspid">
                                    <img src="../../images/person-circle.svg" alt="" class="accordion-img-inner">
                                    <span class="text-info">Admin</span>
                                </span>
                                <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight-Admin-@(row.RequestId)" aria-labelledby="offcanvasRight-Admin-@(row.RequestId)Label">
                                    <div class="offcanvas-header">
                                    <h5 id="offcanvasRight-Admin-@(row.RequestId)Label">Admin</h5>
                                        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                                    </div>
                                    <div class="offcanvas-body">
                                        <div class="main-chat-body" id="Admin-@(row.RequestId)">
                                        </div>
                                        <div class="send-section d-flex">
                                        <input type="text" class="chat-msg" id="message-input-admin-@(row.RequestId)" placeholder="Type a message">
                                            <div class="btn btn-info text-white patient-text-btn" onclick="sendToAdmin()">
                                                <i class="bi bi-send"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @if(row.aspid!=null)
                                {
                                    <span class="chat-btn" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight-Provider-@(row.RequestId)-@(row.aspid)" aria-controls="offcanvasRight-Provider-@(row.RequestId)-@(row.aspid)" data-reqid="@row.RequestId" data-aspid="@row.aspid">
                                        <img src="../../images/person-circle.svg" alt="" class="accordion-img-inner">
                                        <span class="text-info">Provider</span>
                                    </span>
                                    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight-Provider-@(row.RequestId)-@(row.aspid)" aria-labelledby="offcanvasRight-Provider-@(row.RequestId)-@(row.aspid)Label">
                                        <div class="offcanvas-header">
                                            <h5 id="offcanvasRight-Provider-@(row.RequestId)-@(row.aspid)Label">Dr. @row.Name</h5>
                                            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                                        </div>
                                        <div class="offcanvas-body">
                                            <div class="main-chat-body" id="Provider-@(row.RequestId)-@(row.aspid)">
                                            </div>
                                            <div class="send-section d-flex">
                                            <input type="text" class="chat-msg" id="message-input-provider-@(row.RequestId)-@(row.aspid)" placeholder="Type a message">
                                                <div class="btn btn-info text-white patient-text-btn" onclick="sendToPhysician()">
                                                    <i class="bi bi-send"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </span>
                           
                        </td>
                        <td>
                            @if (row.Status == 6 || row.Status == 7 || row.Status == 8 || row.Status == 9)
                            {
                                <a class="document" asp-controller="Patient" asp-action="ViewDocument" asp-route-id="@(row.RequestId)">
                                    <span class="logout-text">(@(row.Count ?? 0)) Documents</span>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <input type="hidden" id="req-id"/>
        <input type="hidden" id="asp-id"/>

        <!-- Table Mobile - Accordian -->
        <div class="accordion accordion-flush" id="accordionFlushExample">
            @for (var i = 0; i < Model.requests.Count; ++i)
            {
                if (Model.requests[i].Status == 6 || Model.requests[i].Status == 7 || Model.requests[i].Status == 8 || Model.requests[i].Status == 9)
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="flush-heading@(i)">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#flush-collapse@(i)" aria-expanded="false" aria-controls="flush-collapse@(i)">
                                <img src="../../images/clock.svg" alt="" class="accordion-img"> <span class="accordion-heading">
                                    Created
                                    Date: <span class="accordion-value">@Model.requests[i].CreatedDate.ToString("MMMM dd,yyyy")</span>
                                </span>
                            </button>
                        </h2>
                        <div id="flush-collapse@(i)" class="accordion-collapse collapse" aria-labelledby="flush-heading@(i)"
                             data-bs-parent="#accordionFlushExample">
                            <div class="accordion-body main-flex">
                                <div class="inner-flex">
                                    <img src="../../images/person-circle.svg" alt="" class="accordion-img-inner">
                                    <span class="accordion-heading-inner">
                                        Provider :
                                        <span class="accordion-value-inner">@Model.requests[i].Name</span>
                                    </span>
                                </div>
                                <div class="inner-flex">
                                    <img src="../../images/success-icon.svg" alt="" class="accordion-img-inner"> <span class="accordion-heading-inner">
                                        Current
                                        Status: <span class="accordion-value-inner">@Enum.GetName(typeof(Status), @Model.requests[i].Status)</span>
                                    </span>
                                </div>
                                <a class="document-mob" asp-controller="Patient" asp-action="ViewDocument" asp-route-id="@(Model.requests[i].RequestId)">
                                    <span class="logout-text">(@(Model.requests[i].Count ?? 0)) Documents</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="flush-heading@(i)">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#flush-collapse@(i)" aria-expanded="false" aria-controls="flush-collapse@(i)">
                                <img src="../../images/clock.svg" alt="" class="accordion-img"> <span class="accordion-heading">
                                    Created
                                    Date: <span class="accordion-value">@Model.requests[i].CreatedDate.ToString("MMMM dd,yyyy")</span>
                                </span>
                            </button>
                        </h2>
                        <div id="flush-collapse@(i)" class="accordion-collapse collapse" aria-labelledby="flush-heading@(i)"
                             data-bs-parent="#accordionFlushExample">
                            <div class="accordion-body main-flex">
                                <div class="inner-flex">
                                    <img src="../../images/person-circle.svg" alt="" class="accordion-img-inner">
                                    <span class="accordion-heading-inner">
                                        Provider :
                                        <span class="accordion-value-inner">@Model.requests[i].Name</span>
                                    </span>
                                </div>
                                <div class="inner-flex">
                                    <img src="../../images/success-icon.svg" alt="" class="accordion-img-inner"> <span class="accordion-heading-inner">
                                        Current
                                        Status: <span class="accordion-value-inner">@Enum.GetName(typeof(Status), @Model.requests[i].Status)</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

        </div>
        <div class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <a data-page="@(Model.CurrentPage - 1)" href="#">Previous</a>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a data-page="@i" href="#" class="@(i == Model.CurrentPage ? "pagination-active" : "")">@i</a>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a data-page="@(Model.CurrentPage + 1)" href="#">Next</a>
            }
        </div>


<script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
<script src="~/js/patient-chat.js"></script>
<script>
    $(document).ready(function () {
        $('.pagination a').click(function (e) {
            e.preventDefault();
            var page = $(this).attr('data-page');

            filter(page, 10)
        });
    });

    

</script>