@model ProviderViewModel
<table class="table">
    <thead class="thead-dark">
        <tr>
            <th style="max-width:80px;">Stop Notification</th>
            <th>Provider Name</th>
            <th>Role</th>
            <th>On Call Status</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @for(var i=0;i<Model.physicianproviders.Count;++i)
    {

                var status = "";
                @if (Model.physicianproviders[i].status == 3)
                {
                status = "In-Active";
                }
                else if (Model.physicianproviders[i].status == 2)
                {
                    status = "Active";
                }
                else
                {
                    status = "Pending";
                }
                <tr>
                    <td>
                        <div class="form-check top-check">
                        <input class="form-check-input" data-id="@Model.physicianproviders[i].physicianId" type="checkbox" id="flexCheckDefault" onchange="changeNotification(this)" asp-for="@Model.physicianproviders[i].isStopNotification">
                        </div>
                    </td>
                    <td>@Model.physicianproviders[i].name</td>
                    <td>@Model.physicianproviders[i].role</td>
                    <td>@Model.physicianproviders[i].oncallstatus</td>
                    <td>@status</td>
                    <td>
                    <span class="btn contact-btn contact-provider" data-id="@Model.physicianproviders[i].physicianId">Contact</span>
                    <a class="btn contact-btn" asp-action="EditPhysician" asp-controller="Admin" asp-route-id="@Model.physicianproviders[i].physicianId">Edit</a>
                    </td>
                </tr>

    }
    </tbody>
</table>
<div class="accordion accordion-flush" id="accordionFlushExample">
@for(var i=0;i<Model.physicianproviders.Count;++i)
{
    var status = "";
    @if (Model.physicianproviders[i].status == 3)
    {
        status = "In-Active";
    }
    else if (Model.physicianproviders[i].status == 2)
    {
        status = "Active";
    }
    else
    {
        status = "Pending";
    }

        <div class="accordion-item">
            <h2 class="accordion-header" id="flush-heading@(i)">
                <button class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#flush-collapse@(i)"
                        aria-expanded="false"
                        aria-controls="flush-collapse@(i)">
                    <div class="form-check">
                        <input class="form-check-input" data-id="@Model.physicianproviders[i].physicianId" type="checkbox" id="flexCheckDefault@(i)" onchange="changeNotification(this)" asp-for="@Model.physicianproviders[i].isStopNotification">
                        <label class="form-check-label" for="flexCheckDefault@(i)">
                            @Model.physicianproviders[i].name
                        </label>
                    </div>
                    <span class="accordion-heading-inner">
                        On Call Status :
                        <span class="accordion-value-inner">@Model.physicianproviders[i].oncallstatus</span>
                    </span>
                </button>
            </h2>
            <div id="flush-collapse@(i)"
                 class="accordion-collapse collapse"
                 aria-labelledby="flush-heading@(i)"
                 data-bs-parent="#accordionFlushExample">
                <div class="accordion-body main-flex">
                    <div class="inner-flex">
                        <img src="../../images/person-circle.svg" alt="" class="accordion-img-inner">
                        <span class="accordion-heading-inner">
                            Role :
                            <span class="accordion-value-inner">@Model.physicianproviders[i].role</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <img src="../../images/success-icon.svg" alt="" class="accordion-img-inner"> <span class="accordion-heading-inner">
                            Status: <span class="accordion-value-inner">@status</span>
                        </span>
                    </div>
                    <div class="lower-btn-mob-flex">
                        <span class="btn contact-btn contact-provider" data-id="@Model.physicianproviders[i].physicianId">Contact</span>
                        <a class="btn contact-btn" asp-action="EditPhysician" asp-controller="Admin" asp-route-id="@Model.physicianproviders[i].physicianId">Edit</a>
                    </div>
                </div>
            </div>
        </div>

}
</div>
<div class="pagination">
    @if (Model.CurrentPage > 1)
    {
        <a data-page="@(Model.CurrentPage - 1)" href="#">Previous</a>
    }

    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        <a data-page="@i" href="#" class="@(i == Model.CurrentPage ? "pagination-active" : "")">@i</a>
    }

    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a data-page="@(Model.CurrentPage + 1)" href="#">Next</a>
    }
</div>

<script>
    $(document).ready(function () {
        $('.pagination a').click(function (e) {
            e.preventDefault();
            var page = $(this).attr('data-page');

            filter(page, 10)
        });
    });

    var divs = document.getElementsByClassName("contact-provider")

    for (let i = 0; i < divs.length; ++i) {
        divs[i].onclick = function () {
            const id = divs[i].getAttribute("data-id");
            openProvider(id);
        };
    }

    const openProvider = (id) => {
        document.getElementById("req-provider-id").value = id
        $("#myModalProvider").modal("show");
    }
</script>