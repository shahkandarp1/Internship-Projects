@model PartnerViewModal
<div class="table-responsive">
    <table class="table">
        <thead class="thead-dark">
            <tr>
                <th>Profession</th>
                <th>Business Name</th>
                <th>Email</th>
                <th>Fax Number</th>
                <th>Phone Number</th>
                <th>Business Contact</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.healthProfessionals)
            {
                <tr>
                    <td>
                        @if(item.Profession == null)
                        {
                            <span>-</span>
                        }
                        else
                        {
                            <span>@item.ProfessionNavigation.ProfessionName</span>
                        }
                    </td>
                    <td>@item.VendorName</td>
                    <td>@item.Email</td>
                    <td>@item.FaxNumber</td>
                    <td>@item.PhoneNumber</td>
                    <td>@(item.BusinessContact == null ? "-" : item.BusinessContact)</td>
                    <td>
                        <a class="btn contact-btn contact-provider mb-1" asp-action="EditBusiness" asp-controller="Admin" asp-route-id="@item.VendorId">Edit</a>
                        <a class="btn contact-btn" asp-action="DeleteBusiness" asp-controller="Admin" asp-route-id="@item.VendorId">Delete</a>
                    </td>
                </tr>

            }
        </tbody>
    </table>
</div>

<div class="accordion accordion-flush" id="accordionFlushExample">
    @for (var i = 0; i < Model.healthProfessionals.Count; ++i)
    {

        <div class="accordion-item">
            <h2 class="accordion-header" id="flush-heading@(i)">
                <button class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#flush-collapse@(i)"
                        aria-expanded="false"
                        aria-controls="flush-collapse@(i)">
                    <div class="mb-3">@Model.healthProfessionals[i].VendorName</div>
                </button>
            </h2>
            <div id="flush-collapse@(i)"
                 class="accordion-collapse collapse"
                 aria-labelledby="flush-heading@(i)"
                 data-bs-parent="#accordionFlushExample">
                <div class="accordion-body main-flex">
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/envelope-black.svg" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Email :
                            <span class="accordion-value-inner">@Model.healthProfessionals[i].Email</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/telephone-black.svg" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Fax :
                            <span class="accordion-value-inner">@Model.healthProfessionals[i].FaxNumber</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/telephone-black.svg" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Phone Number :
                            <span class="accordion-value-inner">@Model.healthProfessionals[i].PhoneNumber</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/envelope-black.svg" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Business Contact :
                            <span class="accordion-value-inner">@(Model.healthProfessionals[i].BusinessContact == null ? "-" : Model.healthProfessionals[i].BusinessContact)</span>
                        </span>
                    </div>
                    <div class="lower-btn-mob-flex">
                        <a class="btn contact-btn contact-provider" asp-action="EditBusiness" asp-controller="Admin" asp-route-id="@Model.healthProfessionals[i].VendorId">Edit</a>
                        <a class="btn contact-btn" asp-action="DeleteBusiness" asp-controller="Admin" asp-route-id="@Model.healthProfessionals[i].VendorId">Delete</a>
                    </div>
                </div>
            </div>
        </div>

    }
</div>

<div class="pagination">
    @if (Model.CurrentPage > 1)
    {
        <a data-page="@(Model.CurrentPage - 1)" href="#">Previous</a>
    }

    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        <a data-page="@i" href="#" class="@(i == Model.CurrentPage ? "pagination-active" : "")">@i</a>
    }

    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a data-page="@(Model.CurrentPage + 1)" href="#">Next</a>
    }
</div>

<script>
    $(document).ready(function () {
        $('.pagination a').click(function (e) {
            e.preventDefault();
            var page = $(this).attr('data-page');

            filter(page, 10)
        });
    });
</script>