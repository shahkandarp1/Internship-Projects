@model PhysicianInvoicingViewModel

@if (Model.timesheetReimbursement == null)
{
    <div class ="no-record-pad">No Record(s) Found</div>
}
else
{
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Item</th>
                    <th>Amount</th>
                    <th>Bill</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.timesheetDetails.TimesheetReimbursements)
                {
                    <tr>
                        <td>@item.Date?.ToString("MMMM dd,yyyy")</td>
                        <td>@item.Item</td>
                        <td>@item.Amount</td>
                        <td>@item.Bill</td>
                        <td><a class="back-btn reset-btn mt-3" id="reset-password"><span class="back-text">View</span></a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
