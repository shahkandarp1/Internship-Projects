@model PhysicianInvoicingViewModel

@if ((Model.timesheetReimbursement != null && Model.timesheetReimbursement.TimesheetReimbursements.Count == 0) || Model.timesheetReimbursement == null)
{
    <div class ="no-record-pad">No Record(s) Found</div>
}
else
{
    <div class="table-responsive">
        <table class="timesheet-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Item</th>
                    <th>Amount</th>
                    <th>Bill</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.timesheetReimbursement.TimesheetReimbursements)
                {
                    <tr>
                        <td>@item.Date?.ToString("MMMM dd,yyyy")</td>
                        <td>@item.Item</td>
                        <td>@item.Amount</td>
                        <td>@(item.Bill ?? "-")</td>
                        <td>
                            @if(item.Bill!=null)
                            {
                                <a class="back-btn reset-btn db" id="reset-password" onclick="viewDoc('@item.Bill')">View</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}