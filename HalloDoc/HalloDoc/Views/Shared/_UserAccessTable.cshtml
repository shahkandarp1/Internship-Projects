@model UserAccessViewModel
<div class="table-responsive">
    <table class="table">
        <thead class="thead-dark">
            <tr>
                <th>Account Type</th>
                <th>Account POC</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Open Requests</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.userAccessData)
            {
                <tr>
                    <td>@item.AccountType</td>
                    <td>@item.Name</td>
                    <td>@item.PhoneNumber</td>
                    <td>
                        @if(item.Status == 1)
                        {
                            <span>Pending</span>
                        }
                        else if (item.Status == 2)
                        {
                            <span>Active</span>
                            
                        }
                        else
                        {
                            <span>In-Active</span>
                        }
                    </td>
                    <td>@item.OpenRequest</td>
                    <td>
                        @if (item.AccountType == "Provider")
                        {
                            <a class="btn contact-btn contact-provider mb-1" asp-action="EditPhysician" asp-controller="Admin" asp-route-id="@item.PhysicianId">Edit</a>
                        }
                        else
                        {
                            <a class="btn contact-btn contact-provider mb-1" asp-action="EditAdmin" asp-controller="Admin" asp-route-id="@item.AdminId">Edit</a>
                        }
                    </td>
                </tr>

            }
        </tbody>
    </table>
</div>

<div class="accordion accordion-flush" id="accordionFlushExample">
    @for (var i = 0; i < Model.userAccessData.Count; ++i)
    {

        <div class="accordion-item">
            <h2 class="accordion-header" id="flush-heading@(i)">
                <button class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#flush-collapse@(i)"
                        aria-expanded="false"
                        aria-controls="flush-collapse@(i)">
                    <div class="mb-3">@Model.userAccessData[i].Name</div>
                    <span class="accordion-heading-inner">
                        Account Type :
                        <span class="accordion-value-inner">@Model.userAccessData[i].AccountType</span>
                    </span>
                </button>
            </h2>
            <div id="flush-collapse@(i)"
                 class="accordion-collapse collapse"
                 aria-labelledby="flush-heading@(i)"
                 data-bs-parent="#accordionFlushExample">
                <div class="accordion-body main-flex">
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/telephone-black.svg" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Phone :
                            <span class="accordion-value-inner">@Model.userAccessData[i].PhoneNumber</span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <i class="bi bi-check tick-color"></i>
                        </div>
                        <span class="accordion-heading-inner">
                            Status :
                            <span class="accordion-value-inner">
                                @if (Model.userAccessData[i].Status == 1)
                                {
                                    <span>Pending</span>
                                }
                                else if (Model.userAccessData[i].Status == 2)
                                {
                                    <span>Active</span>

                                }
                                else
                                {
                                    <span>In-Active</span>
                                }
                            </span>
                        </span>
                    </div>
                    <div class="inner-flex">
                        <div class="outer-img-circle">
                            <img src="../../images/list.png" alt="" class="inner-img">
                        </div>
                        <span class="accordion-heading-inner">
                            Open Requests :
                            <span class="accordion-value-inner">@Model.userAccessData[i].OpenRequest</span>
                        </span>
                    </div>
                    <div class="lower-btn-mob-flex">
                        @if (Model.userAccessData[i].AccountType == "Provider")
                        {
                            <a class="btn contact-btn contact-provider" asp-action="EditPhysician" asp-controller="Admin" asp-route-id="@Model.userAccessData[i].PhysicianId">Edit</a>
                        }
                        else
                        {
                            <a class="btn contact-btn contact-provider" asp-action="EditAdmin" asp-controller="Admin" asp-route-id="@Model.userAccessData[i].AdminId">Edit</a>
                        }
                    </div>
                </div>
            </div>
        </div>

    }
</div>

<div class="pagination">
    @if (Model.CurrentPage > 1)
    {
        <a data-page="@(Model.CurrentPage - 1)" href="#">Previous</a>
    }

    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        <a data-page="@i" href="#" class="@(i == Model.CurrentPage ? "pagination-active" : "")">@i</a>
    }

    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a data-page="@(Model.CurrentPage + 1)" href="#">Next</a>
    }
</div>

<script>
    $(document).ready(function () {
        $('.pagination a').click(function (e) {
            e.preventDefault();
            var page = $(this).attr('data-page');

            filter(page, 10)
        });
    });
</script>