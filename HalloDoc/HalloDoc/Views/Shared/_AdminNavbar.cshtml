@model AdminNavbarViewModel

@Html.HiddenFor(m => m.Name)
@Html.HiddenFor(m => m.curr_active)

<div class="navbar-custom">
    <button class="nav-btn list-border"
            type="button"
            data-toggle="collapse"
            data-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="Toggle navigation"
            onclick="sidebar_open()">
        <img src="../../images/list.svg" alt="" class="list-img" />
    </button>
    <img src="../../images/logo1.png" alt="" class="logo" />
    <div class="right-side-elements">
        <span class="welcome-text">Welcome <span class="name-text">@Model.Name</span></span>
        <a class="logout log" asp-controller="Login" asp-action="PatientLogin">
            <span class="logout-text">Logout</span>
        </a>
        <a class="logout-mob log" asp-controller="Login" asp-action="PatientLogin">
            <img id="logout"
                 src="../../images/box-arrow-right.svg"
                 alt=""
                 class="logout-img" />
        </a>
        <button class="moon" onclick="changeMode()">
            <img id="moon" src="../../images/moon.svg" alt="" class="moon-img" />
            <img id="sun"
                 src="../../images/sun.svg"
                 alt=""
                 class="moon-img hidden" />
        </button>
    </div>
</div>

<!-- Sidebar -->

@{
    string dashboardM,dashboard,providerlocationM,providerlocation,profileM,profile,providerM,provider,partner,partnerM,access,accessM,record,recordM;
    dashboardM = Model.curr_active == "Dashboard" ? "mobile-sidebar-active" : "";
    providerlocationM = Model.curr_active == "ProviderLocation" ? "mobile-sidebar-active" : "";
    profileM = Model.curr_active == "Profile" ? "mobile-sidebar-active" : "";
    providerM = Model.curr_active == "Provider" ? "mobile-sidebar-active" : "";
    partnerM = Model.curr_active == "Partner" ? "mobile-sidebar-active" : "";
    accessM = Model.curr_active == "Access" ? "mobile-sidebar-active" : "";
    recordM = Model.curr_active == "Record" ? "mobile-sidebar-active" : "";

    dashboard = Model.curr_active == "Dashboard" ? "sidebar-active" : "";
    providerlocation = Model.curr_active == "ProviderLocation" ? "sidebar-active" : "";
    profile = Model.curr_active == "Profile" ? "sidebar-active" : "";
    provider = Model.curr_active == "Provider" ? "sidebar-active" : "";
    partner = Model.curr_active == "Partner" ? "sidebar-active" : "";
    access = Model.curr_active == "Access" ? "sidebar-active" : "";
    record = Model.curr_active == "Record" ? "sidebar-active" : "";
}

<div id="mySidebar" class="sidebar">
    <div class="sidebar-tab">
        <span class="mob-welcome-text">Welcome <span class="mob-name-text">Kandarp Shah</span></span>
        <button class="sidebar-tablinks @dashboardM">
            <a class="mobile-sidebar-a" asp-action="Dashboard" asp-controller="Admin"> Dashboard </a>
        </button>
        <button class="sidebar-tablinks @providerlocationM">
            <a class="mobile-sidebar-a"> Provider Location </a>
        </button>
        <button class="sidebar-tablinks @profileM">
            <a class="mobile-sidebar-a" asp-action="Profile" asp-controller="Admin"> My Profile </a>
        </button>
        <button class="sidebar-tablinks accordion-mob-btn @providerM">Providers</button>
        <div class="panel">
            <a class="mobile-sidebar-a accord-inner" asp-action="Provider" asp-controller="Admin"> Provider </a>
            <a class="mobile-sidebar-a accord-inner"> Scheduling </a>
            <a class="mobile-sidebar-a accord-inner"> Invoicing </a>
        </div>
        <button class="sidebar-tablinks @partnerM">
            <a class="mobile-sidebar-a"> Partners </a>
        </button>
        <button class="sidebar-tablinks accordion-mob-btn @accessM">Access</button>
        <div class="panel">
            <a class="mobile-sidebar-a accord-inner" asp-action="AccountAccess" asp-controller="Admin">Account Access</a>
            <a class="mobile-sidebar-a accord-inner">User Access</a>
        </div>
        <button class="sidebar-tablinks accordion-mob-btn @recordM">Records</button>
        <div class="panel">
            <a class="mobile-sidebar-a accord-inner" asp-action="SearchRecord" asp-controller="Admin">Search Records</a>
            <a class="mobile-sidebar-a accord-inner">Email Logs</a>
            <a class="mobile-sidebar-a accord-inner">SMS Logs</a>
            <a asp-action="PatientHistory" asp-controller="Admin" class="mobile-sidebar-a accord-inner">Patient History</a>
            <a asp-action="BlockHistory" asp-controller="Admin" class="mobile-sidebar-a accord-inner">Block History</a>
        </div>
    </div>
</div>

<!-- Dark Background when sidebar is open -->
<div class="overlay" onclick="sidebar_close()"></div>

<!-- Navbar Below Container -->

<div class="nav-below-container"></div>

<!-- Navbar - Below -->

<div class="bottom-navbar" id="">
    <div>
        <button class="navbar-btn @dashboard" onclick="navbar(this)">
            <a asp-action="Dashboard" asp-controller="Admin"> Dashboard </a>
        </button>
        <button class="navbar-btn @providerlocation" onclick="navbar(this)">
            <a> Provider Location </a>
        </button>
        <button class="navbar-btn @profile" onclick="navbar(this)">
            <a asp-action="Profile" asp-controller="Admin"> My Profile </a>
        </button>
        <div class="dropdown navbar-dropdown">
            <button class="navbar-btn dropdown-toggle @provider" type="button" id="provider" data-bs-toggle="dropdown" aria-expanded="false" onclick="navbar(this)">
                Providers
            </button>
            <ul class="dropdown-menu" aria-labelledby="provider">
                <li><a class="navbar-dropdown-item dropdown-item" asp-action="Provider" asp-controller="Admin">Provider</a></li>
                <li><a class="navbar-dropdown-item dropdown-item" href="#">Scheduling</a></li>
                <li><a class="navbar-dropdown-item dropdown-item" href="#">Invoicing</a></li>
            </ul>
        </div>
        <button class="navbar-btn @partner" onclick="navbar(this)">
            <a> Partners </a>
        </button>
        <div class="dropdown navbar-dropdown">
            <button class="navbar-btn dropdown-toggle @access" type="button" id="access" data-bs-toggle="dropdown" aria-expanded="false" onclick="navbar(this)">
                Access
            </button>
            <ul class="dropdown-menu" aria-labelledby="access">
                <li><a class="navbar-dropdown-item dropdown-item" asp-action="AccountAccess" asp-controller="Admin">Account Access</a></li>
                <li><a class="navbar-dropdown-item dropdown-item" href="#">User Access</a></li>
            </ul>
        </div>
        <div class="dropdown navbar-dropdown">
            <button class="navbar-btn dropdown-toggle @record" type="button" id="records" data-bs-toggle="dropdown" aria-expanded="false" onclick="navbar(this)">
                Records
            </button>
            <ul class="dropdown-menu" aria-labelledby="records">
                <li><a class="navbar-dropdown-item dropdown-item" asp-action="SearchRecord" asp-controller="Admin">Search Records</a></li>
                <li><a class="navbar-dropdown-item dropdown-item" href="#">Email Logs</a></li>
                <li><a class="navbar-dropdown-item dropdown-item" href="#">SMS Logs</a></li>
                <li><a asp-action="PatientHistory" asp-controller="Admin" class="navbar-dropdown-item dropdown-item">Patient History</a></li>
                <li><a asp-action="BlockHistory" asp-controller="Admin" class="navbar-dropdown-item dropdown-item">Block History</a></li>
            </ul>
        </div>
    </div>
</div>
