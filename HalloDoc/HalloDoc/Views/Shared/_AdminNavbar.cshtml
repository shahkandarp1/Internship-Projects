@model AdminNavbarViewModel

@Html.HiddenFor(m => m.Name)
@Html.HiddenFor(m => m.curr_active)

<div class="navbar-custom bg-body">
    <button class="nav-btn list-border bg-body"
            type="button"
            data-toggle="collapse"
            data-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="Toggle navigation"
            onclick="sidebar_open()">
        <img src="../../images/list.svg" alt="" class="list-img" />
    </button>
    <img src="../../images/logo1.png" alt="" class="logo" />
    <div class="right-side-elements">
        <span class="welcome-text">Welcome <span class="name-text" id="nav-name-text">@Model.Name</span></span>
        <a class="logout log bg-body" asp-controller="Login" asp-action="PatientLogin">
            <span class="logout-text">Logout</span>
        </a>
        <a class="logout-mob log bg-body" asp-controller="Login" asp-action="PatientLogin">
            <img id="logout"
                 src="../../images/box-arrow-right.svg"
                 alt=""
                 class="logout-img" />
        </a>
        <div class="pg-theme">
            <button type="button" id="pg-theme-btn" class="btn btn-outline-info moon bg-body"
                    data-bs-toggle="button">
                <i class="bi bi-moon moon-img" id="theme-btn"></i>
            </button>
        </div>
    </div>
</div>

<!-- Sidebar -->

@{
    string dashboardM,dashboard,providerlocationM,providerlocation,profileM,profile,providerM,provider,partner,partnerM,access,accessM,record,recordM,Dprofile,DprofileM,Dschedule,DscheduleM,Dinvoice,DinvoiceM;
    dashboardM = Model.curr_active == "Dashboard" ? "mobile-sidebar-active" : "";
    providerlocationM = Model.curr_active == "ProviderLocation" ? "mobile-sidebar-active" : "";
    profileM = Model.curr_active == "Profile" ? "mobile-sidebar-active" : "";
    providerM = Model.curr_active == "Provider" ? "mobile-sidebar-active" : "";
    partnerM = Model.curr_active == "Partner" ? "mobile-sidebar-active" : "";
    accessM = Model.curr_active == "Access" ? "mobile-sidebar-active" : "";
    recordM = Model.curr_active == "Record" ? "mobile-sidebar-active" : "";
    DprofileM = Model.curr_active == "DoctorProfile" ? "mobile-sidebar-active" : "";
    DscheduleM = Model.curr_active == "DoctorSchedule" ? "mobile-sidebar-active" : "";
    DinvoiceM = Model.curr_active == "DoctorInvoice" ? "mobile-sidebar-active" : "";

    dashboard = Model.curr_active == "Dashboard" ? "sidebar-active" : "";
    providerlocation = Model.curr_active == "ProviderLocation" ? "sidebar-active" : "";
    profile = Model.curr_active == "Profile" ? "sidebar-active" : "";
    provider = Model.curr_active == "Provider" ? "sidebar-active" : "";
    partner = Model.curr_active == "Partner" ? "sidebar-active" : "";
    access = Model.curr_active == "Access" ? "sidebar-active" : "";
    record = Model.curr_active == "Record" ? "sidebar-active" : "";
    Dprofile = Model.curr_active == "DoctorProfile" ? "sidebar-active" : "";
    Dschedule = Model.curr_active == "DoctorSchedule" ? "sidebar-active" : "";
    Dinvoice = Model.curr_active == "DoctorInvoice" ? "sidebar-active" : "";


}

<!-- Roles -->
@{
    string dashboardrole, providerlocationrole, profilerole, providermainrole, providerrole, schedulingrole, invoicingrole, partnerrole, accessrole, accountaccessrole, useraccessrole,createadminaccount, recordrole, searchrecordrole, emailrole, smsrole, patienthistoryrole, blockhistoryrole;
    string admin, physician;
    string Dinvoicingrole, Dschedulingrole;
    dashboardrole = Model.menus.Contains("Dashboard") ? "" : "d-none";
    providerlocationrole = Model.menus.Contains("Provider Location") ? "" : "d-none";
    profilerole = Model.menus.Contains("My Profile") ? "" : "d-none";
    providerrole = Model.menus.Contains("Providerr") ? "" : "d-none";
    schedulingrole = Model.menus.Contains("Scheduling") ? "" : "d-none";
    invoicingrole = Model.menus.Contains("Invoicing") ? "" : "d-none";
    providermainrole = Model.menus.Contains("Providerr") || Model.menus.Contains("Scheduling") || Model.menus.Contains("Invoicing") ? "" : "d-none";
    partnerrole = Model.menus.Contains("Partners") ? "" : "d-none";
    accessrole = Model.menus.Contains("Account Access") || Model.menus.Contains("User Access") || Model.menus.Contains("Create Admin Account") ? "" : "d-none";
    accountaccessrole = Model.menus.Contains("Account Access") ? "" : "d-none";
    useraccessrole = Model.menus.Contains("User Access") ? "" : "d-none";
    createadminaccount = Model.menus.Contains("Create Admin Account") ? "" : "d-none";
    recordrole = Model.menus.Contains("Search Records") || Model.menus.Contains("Email Logs") || Model.menus.Contains("SMS Logs") || Model.menus.Contains("Patient History") || Model.menus.Contains("Block History") ? "" : "d-none";
    searchrecordrole = Model.menus.Contains("Search Records") ? "" : "d-none";
    emailrole = Model.menus.Contains("Email Logs") ? "" : "d-none";
    smsrole = Model.menus.Contains("SMS Logs") ? "" : "d-none";
    patienthistoryrole = Model.menus.Contains("Patient History") ? "" : "d-none";
    blockhistoryrole = Model.menus.Contains("Block History") ? "" : "d-none";
    Dinvoicingrole = Model.menus.Contains("Invoicing") ? "" : "d-none";
    Dschedulingrole = Model.menus.Contains("My Schedule") ? "" : "d-none";

    admin = Model.role.Contains("Admin") ? "" : "d-none";
    physician = Model.role.Contains("Provider") ? "" : "d-none";

}



<div id="mySidebar" class="sidebar bg-body">
    <div class="sidebar-tab">
        <span class="mob-welcome-text">Welcome <span class="mob-name-text" id="nav-mob-name-text">Kandarp Shah</span></span>
        <button class="sidebar-tablinks @dashboardM @dashboardrole" onclick="clearStorage()">
            <a class="mobile-sidebar-a" asp-action="Dashboard" asp-controller="Admin"> Dashboard </a>
        </button>
        <button class="sidebar-tablinks @DinvoiceM @Dinvoicingrole @physician" onclick="clearStorage()">
            <a class="mobile-sidebar-a" asp-action="Invoicing" asp-controller="Doctor"> Invoicing </a>
        </button>
        <button class="sidebar-tablinks @DscheduleM @Dschedulingrole @physician" onclick="clearStorage()">
            <a class="mobile-sidebar-a" asp-action="MySchedule" asp-controller="Doctor"> My Schedule </a>
        </button>
        <button class="sidebar-tablinks @providerlocationM @providerlocationrole @admin" onclick="clearStorage()">
            <a class="mobile-sidebar-a" asp-action="ProviderLocation" asp-controller="Admin"> Provider Location </a>
        </button>
        @if (Model.role == "Admin")
        {
            <button class="sidebar-tablinks @profileM @profilerole" onclick="clearStorage()">
                <a class="mobile-sidebar-a" asp-action="Profile" asp-controller="Admin"> My Profile </a>
            </button>
        }
        else if (Model.role == "Provider")
        {
            <button class="sidebar-tablinks @DprofileM @profilerole" onclick="clearStorage()">
                <a class="mobile-sidebar-a" asp-action="DoctorProfile" asp-controller="Doctor"> My Profile </a>
            </button>
        }
        <button class="sidebar-tablinks accordion-mob-btn @providerM @providermainrole @admin" onclick="clearStorage()">Providers</button>
        <div class="panel">
            <a class="mobile-sidebar-a accord-inner @providerrole" asp-action="Provider" asp-controller="Admin"> Provider </a>
            <a class="mobile-sidebar-a accord-inner @schedulingrole" asp-action="Scheduling" asp-controller="Admin"> Scheduling </a>
            <a class="mobile-sidebar-a accord-inner @admin @invoicingrole"> Invoicing </a>
        </div>
        <button class="sidebar-tablinks @partnerM @partnerrole @admin" onclick="clearStorage()">
            <a class="mobile-sidebar-a" asp-action="Partners" asp-controller="Admin"> Partners </a>
        </button>
        <button class="sidebar-tablinks accordion-mob-btn @accessM @accessrole @admin" onclick="clearStorage()">Access</button>
        <div class="panel">
            <a class="mobile-sidebar-a accord-inner @accountaccessrole" asp-action="AccountAccess" asp-controller="Admin">Account Access</a>
            <a class="mobile-sidebar-a accord-inner @useraccessrole" asp-action="UserAccess" asp-controller="Admin">User Access</a>
            <a class="mobile-sidebar-a accord-inner @createadminaccount" asp-action="CreateAdmin" asp-controller="Admin">Create Admin</a>
        </div>
        <button class="sidebar-tablinks accordion-mob-btn @recordM @recordrole @admin" onclick="clearStorage()">Records</button>
        <div class="panel">
            <a class="mobile-sidebar-a accord-inner @searchrecordrole" asp-action="SearchRecord" asp-controller="Admin">Search Records</a>
            <a class="mobile-sidebar-a accord-inner @emailrole" asp-action="EmailLog" asp-controller="Admin">Email Logs</a>
            <a class="mobile-sidebar-a accord-inner @smsrole" asp-action="SMSLog" asp-controller="Admin">SMS Logs</a>
            <a asp-action="PatientHistory" asp-controller="Admin" class="mobile-sidebar-a accord-inner @patienthistoryrole">Patient History</a>
            <a asp-action="BlockHistory" asp-controller="Admin" class="mobile-sidebar-a accord-inner @blockhistoryrole">Block History</a>
        </div>
    </div>
</div>

<!-- Dark Background when sidebar is open -->
<div class="overlay" onclick="sidebar_close()"></div>

<!-- Navbar Below Container -->

<div class="nav-below-container"></div>

<!-- Navbar - Below -->

<div class="bottom-navbar bg-body" id="">
    <div>
        <a class="navbar-btn bg-body @dashboard @dashboardrole" asp-action="Dashboard" asp-controller="Admin" onclick="navbar(this)">
            <span> Dashboard </span>
        </a>
        <a class="navbar-btn bg-body @providerlocation @providerlocationrole @admin" asp-action="ProviderLocation" asp-controller="Admin" onclick="navbar(this)">
            <span> Provider Location </span>
        </a>
        <a class="navbar-btn bg-body @Dinvoice @Dinvoicingrole @physician" asp-action="Invoicing" asp-controller="Doctor" onclick="navbar(this)">
            <span> Invoicing </span>
        </a>
        <a class="navbar-btn bg-body @Dschedule @Dschedulingrole @physician" asp-action="MySchedule" asp-controller="Doctor" onclick="navbar(this)">
            <span> My Schedule </span>
        </a>
        @if (Model.role == "Admin")
        {
            <a class="navbar-btn bg-body @profile @profilerole" asp-action="Profile" asp-controller="Admin" onclick="navbar(this)">
                <span> My Profile </span>
            </a>
        }
        else if (Model.role == "Provider")
        {
            <a class="navbar-btn bg-body @Dprofile @profilerole" asp-action="DoctorProfile" asp-controller="Doctor" onclick="navbar(this)">
                <span> My Profile </span>
            </a>
        }
        <div class="dropdown navbar-dropdown">
            <button class="navbar-btn dropdown-toggle bg-body @provider @providermainrole @admin" type="button" id="provider" data-bs-toggle="dropdown" aria-expanded="false" onclick="navbar(this)">
                Providers
            </button>
            <ul class="dropdown-menu" aria-labelledby="provider">
                <li><a class="navbar-dropdown-item dropdown-item @providerrole" asp-action="Provider" asp-controller="Admin">Provider</a></li>
                <li><a class="navbar-dropdown-item dropdown-item @schedulingrole" asp-action="Scheduling" asp-controller="Admin">Scheduling</a></li>
                <li><a class="navbar-dropdown-item dropdown-item @invoicingrole" href="#">Invoicing</a></li>
            </ul>
        </div>
        <a class="navbar-btn bg-body @partner @partnerrole @admin" asp-action="Partners" asp-controller="Admin" onclick="navbar(this)">
            <span > Partners </span>
        </a>
        <div class="dropdown navbar-dropdown @admin">
            <button class="navbar-btn bg-body dropdown-toggle @access @accessrole @admin" type="button" id="access" data-bs-toggle="dropdown" aria-expanded="false" onclick="navbar(this)">
                Access
            </button>
            <ul class="dropdown-menu bg-body" aria-labelledby="access">
                <li><a class="navbar-dropdown-item dropdown-item @accountaccessrole" asp-action="AccountAccess" asp-controller="Admin">Account Access</a></li>
                <li><a class="navbar-dropdown-item dropdown-item @useraccessrole" asp-action="UserAccess" asp-controller="Admin">User Access</a></li>
                <li><a class="navbar-dropdown-item dropdown-item @createadminaccount" asp-action="CreateAdmin" asp-controller="Admin">Create Admin</a></li>
            </ul>
        </div>
        <div class="dropdown navbar-dropdown">
            <button class="navbar-btn dropdown-toggle bg-body @record @recordrole @admin" type="button" id="records" data-bs-toggle="dropdown" aria-expanded="false" onclick="navbar(this)">
                Records
            </button>
            <ul class="dropdown-menu" aria-labelledby="records">
                <li><a class="navbar-dropdown-item dropdown-item @searchrecordrole" asp-action="SearchRecord" asp-controller="Admin">Search Records</a></li>
                <li><a class="navbar-dropdown-item dropdown-item @emailrole" asp-action="EmailLog" asp-controller="Admin">Email Logs</a></li>
                <li><a class="navbar-dropdown-item dropdown-item @smsrole" asp-action="SMSLog" asp-controller="Admin">SMS Logs</a></li>
                <li><a asp-action="PatientHistory" asp-controller="Admin" class="navbar-dropdown-item dropdown-item @patienthistoryrole">Patient History</a></li>
                <li><a asp-action="BlockHistory" asp-controller="Admin" class="navbar-dropdown-item dropdown-item @blockhistoryrole">Block History</a></li>
            </ul>
        </div>
    </div>
</div>
