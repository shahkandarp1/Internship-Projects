@using HalloDoc.ViewModels;
@model EncounterFormViewModel
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=Edge" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/patient-profile.css" rel="stylesheet" type="text/css" />
    <link href="~/css/encounter-form.css" rel="stylesheet" type="text/css" />
</head>
<body>



    <div id="body">

        <div class="main-container">
            <div class="flex-container">
                <div class="top-text">
                    <span class="submit-text" id="submit-text">Encounter Form</span>
                </div>
                <form class="main-form bg-body" id="encounterForm">

                    <!-- Medical Report-Confidential  -->
                    <div class="upper-text encounter-head">
                        Medical Report-Confidential
                    </div>
                    <div class="row symptoms-textarea">
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <input type="text" class="form-control" id="first-name"  asp-for="FirstName" />
                            <label for="first-name" class="form-label">First Name</label>
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <input type="text" class="form-control" id="last-name"  asp-for="LastName" />
                            <label for="last-name" class="form-label">Last Name</label>
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-12">
                            <input type="text" class="form-control" id="location"  asp-for="Location" />
                            <label for="location" class="form-label">Location</label>
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <input type="date" class="form-control dob" id="dob"  asp-for="DateOfBirth" />
                            <label for="dob" class="form-label dob-label">Date Of Birth</label>
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <input type="date" class="form-control editable dob" id="date"  asp-for="Date" />
                            <label for="date" class="form-label dob-label">Date</label>
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <input type="tel" class="form-control phone" id="phone" asp-for="PhoneNumber" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <input type="email" class="form-control" id="email"  asp-for="Email" />
                            <label for="email" class="form-label">Email</label>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="floatingInput_illness"
                                       asp-for="Illness_history"></textarea>
                            <label for="floatingInput_illness" class="form-label">History of Illness</label>
                            <span asp-validation-for="Illness_history" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="floatingInput_medical"
                                       asp-for="Medical_history"></textarea>
                            <label for="floatingInput_medical" class="form-label">Medical History</label>
                            <span asp-validation-for="Medical_history" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="floatingInput_medication"
                                       asp-for="Medications"></textarea>
                            <label for="floatingInput_medication" class="form-label">Medications</label>
                            <span asp-validation-for="Medications" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="floatingInput_allergies"
                                       asp-for="Allergies"></textarea>
                            <label for="floatingInput_allergies" class="form-label">Allergies</label>
                            <span asp-validation-for="Allergies" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-4 col-md-4 col-sm-12">
                            <input type="number" class="form-control editable" id="temp"  asp-for="Temp" />
                            <label for="temp" class="form-label">Temp</label>
                            <span asp-validation-for="Temp" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-4 col-md-4 col-sm-12">
                            <input type="number" class="form-control editable" id="hr"  asp-for="Hr" />
                            <label for="hr" class="form-label">HR</label>
                            <span asp-validation-for="Hr" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-4 col-md-4 col-sm-12">
                            <input type="number" class="form-control editable" id="rr"  asp-for="Rr" />
                            <label for="rr" class="form-label">RR</label>
                            <span asp-validation-for="Rr" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-2 col-md-2 col-sm-6 col-6">
                            <input type="number" class="form-control editable" id="bps"  asp-for="BpS" />
                            <label for="bps" class="form-label">BP(S)</label>
                            <span asp-validation-for="BpS" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-2 col-md-2 col-sm-6 col-6">
                            <input type="number" class="form-control editable" id="bpd"  asp-for="BpD" />
                            <label for="bpd" class="form-label">BP(D)</label>
                            <span asp-validation-for="BpD" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-4 col-md-4 col-sm-12">
                            <input type="number" class="form-control editable" id="O2"  asp-for="O2" />
                            <label for="O2" class="form-label">O2</label>
                            <span asp-validation-for="O2" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-4 col-md-4 col-sm-12">
                            <input type="text" class="form-control editable" id="pain"  asp-for="Pain" />
                            <label for="pain" class="form-label">Pain</label>
                            <span asp-validation-for="Pain" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="heent"
                                       asp-for="Heent"></textarea>
                            <label for="heent" class="form-label">HEENT</label>
                            <span asp-validation-for="Heent" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="CV"
                                       asp-for="Cv"></textarea>
                            <label for="CV" class="form-label">CV</label>
                            <span asp-validation-for="Cv" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="Chest"
                                       asp-for="Chest"></textarea>
                            <label for="Chest" class="form-label">Chest</label>
                            <span asp-validation-for="Chest" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="Abd"
                                       asp-for="Abd"></textarea>
                            <label for="Abd" class="form-label">ABD</label>
                            <span asp-validation-for="Abd" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="Extr"
                                       asp-for="Extr"></textarea>
                            <label for="Extr" class="form-label">Extr</label>
                            <span asp-validation-for="Extr" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="Skin"
                                       asp-for="Skin"></textarea>
                            <label for="Skin" class="form-label">Skin</label>
                            <span asp-validation-for="Skin" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="Neuro"
                                       asp-for="Neuro"></textarea>
                            <label for="Neuro" class="form-label">Neuro</label>
                            <span asp-validation-for="Neuro" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="Other"
                                       asp-for="Other"></textarea>
                            <label for="Other" class="form-label">Other</label>
                            <span asp-validation-for="Other" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="Diagnosis"
                                       asp-for="Diagnosis"></textarea>
                            <label for="Diagnosis" class="form-label">Diagnosis</label>
                            <span asp-validation-for="Diagnosis" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="TreatmentPlan"
                                       asp-for="TreatmentPlan"></textarea>
                            <label for="TreatmentPlan" class="form-label">Treatment Plan</label>
                            <span asp-validation-for="TreatmentPlan" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="MedicationDispensed"
                                       asp-for="MedicationDispensed"></textarea>
                            <label for="MedicationDispensed" class="form-label">Medication Dispensed</label>
                            <span asp-validation-for="MedicationDispensed" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                            <textarea class="form-control text-area editable" id="Procedures"
                                       asp-for="Procedures"></textarea>
                            <label for="Procedures" class="form-label">Procedures</label>
                            <span asp-validation-for="Procedures" class="text-danger"></span>
                        </div>
                        <div class="form-floating mt-3 inp col-sm-12">
                            <textarea class="form-control text-area editable" id="floatingInput_followup"
                                       asp-for="FollowUp"></textarea>
                            <label for="floatingInput_followup" class="form-label">FollowUp</label>
                            <span asp-validation-for="FollowUp" class="text-danger"></span>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>

</body>
</html>