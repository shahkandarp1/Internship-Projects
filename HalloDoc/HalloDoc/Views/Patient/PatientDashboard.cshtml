@using static HalloDoc.ViewModels.Enums;
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
@section Styles {
    <link href="~/css/patient-dashboard.css" rel="stylesheet" type="text/css" />
    <script src="~/js/patient-dashboard.js"></script>
}

<div id="body">

        <!-- Toaster -->
        <partial name="Toast" />

        <!-- Navbar -->
        <div class="navbar-custom">
            <img src="../../images/logo1.png" alt="" class="logo" />
            <div class="right-side-elements">
                <span class="welcome-text">Welcome <span class="name-text">@Model.name</span></span>
                <a class="logout log" asp-controller="Login" asp-action="PatientLogin">
                    <span class="logout-text">Logout</span>
                </a>
                <a class="logout-mob log" asp-controller="Login" asp-action="PatientLogin">
                    <img id="logout" src="../../images/box-arrow-right.svg" alt="" class="logout-img" />
                </a>
                <button class="moon" onclick="changeMode()">
                    <img id="moon" src="../../images/moon.svg" alt="" class="moon-img" />
                    <img id="sun" src="../../images/sun.svg" alt="" class="moon-img hidden" />
                </button>
            </div>
        </div>

        <!-- Sidebar -->

        <div id="mySidebar" class="sidebar">
            <div class="tab sidebar-tab">
                <span class="mob-welcome-text">Welcome <span class="mob-name-text">@Model.name</span></span>
                <button class="tablinks sidebar-tablinks mobile-sidebar-active">
                    <a asp-controller="Patient" asp-action="PatientDashboard" class="mobile-sidebar-a">
                        Dashboard
                    </a>
                </button>
                <button class="tablinks sidebar-tablinks">
                    <a asp-controller="Patient" asp-action="PatientProfile" class="mobile-sidebar-a">
                        Profile
                    </a>
                </button>
            </div>
        </div>

        <!-- Dark Background when sidebar is open -->
        <div class="overlay" onclick="sidebar_close()">
        </div>

        <!-- Navbar Below Container -->

        <div class="nav-below-container"></div>

        <!-- Navbar - Below -->

        <nav class="navbar navbar-expand-sm navbar-light bg-light">
            <button class="navbar-toggler list-border" type="button" data-toggle="collapse" data-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation" onclick="sidebar_open()">
                <img src="../../images/list.svg" alt="" class="list-img" />
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="tab">
                    <button class="tablinks sidebar-active" >
                        <a asp-controller="Patient" asp-action="PatientDashboard">
                            Dashboard
                        </a>
                    </button>
                    <button class="tablinks">
                        <a asp-controller="Patient" asp-action="PatientProfile">
                            Profile
                        </a>
                    </button>
                </div>
            </div>
        </nav>

    <!-- Create Request Modal -->
    <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-title" id="exampleModalLongTitle">Create New Request</div>
                    <span aria-hidden="true" data-bs-dismiss="modal" class="cross-btn">&times;</span>
                </div>
                <form action="">
                    <input type="hidden" name="" id="redirect-value" value="SubmitForMe">
                    <div class="modal-body">
                        <span class="modal-head">Here, I want to create new request for ...</span>
                        <div class="modal-flex">
                            <div class="btn common-btn cancel-btn create-request-active" onclick="toggleButton(this,'SubmitForMe')"> Me </div>
                            <div class="btn common-btn cancel-btn" onclick="toggleButton(this,'SubmitSomeoneElse')"> Some One Else</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-info continue-btn" data-bs-dismiss="modal" onclick="redirect()">Continue</button>
                        <button type="button" class="btn cancel-btn">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Table View - Desktop -->

    <div id="Dashboard" class="tabcontent">
        <span class="main-heading" id="main-heading">Medical History</span>
        <div class="main-content">
            <div class="create-request">
                <button type="button" class="create-request-btn" id="request-btn" data-bs-toggle="modal"
                        data-bs-target="#myModal">
                    Create New Request
                </button>
                <a class="create-request-btn-mob" data-bs-toggle="modal" data-bs-target="#myModal">
                    <img id="create-request" src="../../images/plus.svg" alt="" class="logout-img" />
                </a>
            </div>
            <table class="table">
                <thead>
                    <tr>
                        <th class="heading">Created date</th>
                        <th class="heading">Current Status</th>
                        <th class="heading">Document</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var row in Model.requests)
                    {
                        <tr>
                            <td>@row.CreatedDate.ToString("MMMM dd,yyyy")</td>
                            <td>@Enum.GetName(typeof(Status), @row.Status)</td>
                            <td>
                                @if (row.Status == 6 || row.Status == 7 || row.Status == 8 || row.Status == 9)
                                {
                                    <a class="document" asp-controller="Patient" asp-action="ViewDocument" asp-route-id="@(row.RequestId)">
                                        <span class="logout-text">(@(row.Count ?? 0)) Documents</span>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                   
                </tbody>
            </table>

            <!-- Table Mobile - Accordian -->
            <div class="accordion accordion-flush" id="accordionFlushExample">
                @for(var i = 0; i < Model.requests.Count; ++i)
                {
                    if (Model.requests[i].Status == 6 || Model.requests[i].Status == 7 || Model.requests[i].Status == 8 || Model.requests[i].Status == 9 )
                    {
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="flush-heading@(i)">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#flush-collapse@(i)" aria-expanded="false" aria-controls="flush-collapse@(i)">
                                    <img src="../../images/clock.svg" alt="" class="accordion-img"> <span class="accordion-heading">
                                        Created
                                        Date: <span class="accordion-value">@Model.requests[i].CreatedDate.ToString("MMMM dd,yyyy")</span>
                                    </span>
                                </button>
                            </h2>
                            <div id="flush-collapse@(i)" class="accordion-collapse collapse" aria-labelledby="flush-heading@(i)"
                                 data-bs-parent="#accordionFlushExample">
                                <div class="accordion-body main-flex">
                                    <div class="inner-flex">
                                        <img src="../../images/person-circle.svg" alt="" class="accordion-img-inner">
                                        <span class="accordion-heading-inner">
                                            Provider :
                                            <span class="accordion-value-inner">@Model.requests[i].Name</span>
                                        </span>
                                    </div>
                                    <div class="inner-flex">
                                        <img src="../../images/success-icon.svg" alt="" class="accordion-img-inner"> <span class="accordion-heading-inner">
                                            Current
                                            Status: <span class="accordion-value-inner">@Enum.GetName(typeof(Status), @Model.requests[i].Status)</span>
                                        </span>
                                    </div>
                                    <a class="document-mob" asp-controller="Patient" asp-action="ViewDocument" asp-route-id="@(Model.requests[i].RequestId)">
                                        <span class="logout-text">(@(Model.requests[i].Count ?? 0)) Documents</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="flush-heading@(i)">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#flush-collapse@(i)" aria-expanded="false" aria-controls="flush-collapse@(i)">
                                    <img src="../../images/clock.svg" alt="" class="accordion-img"> <span class="accordion-heading">
                                        Created
                                        Date: <span class="accordion-value">@Model.requests[i].CreatedDate.ToString("MMMM dd,yyyy")</span>
                                    </span>
                                </button>
                            </h2>
                            <div id="flush-collapse@(i)" class="accordion-collapse collapse" aria-labelledby="flush-heading@(i)"
                                 data-bs-parent="#accordionFlushExample">
                                <div class="accordion-body main-flex">
                                    <div class="inner-flex">
                                        <img src="../../images/person-circle.svg" alt="" class="accordion-img-inner">
                                        <span class="accordion-heading-inner">
                                            Provider :
                                            <span class="accordion-value-inner">@Model.requests[i].Name</span>
                                        </span>
                                    </div>
                                    <div class="inner-flex">
                                        <img src="../../images/success-icon.svg" alt="" class="accordion-img-inner"> <span class="accordion-heading-inner">
                                            Current
                                            Status: <span class="accordion-value-inner">@Enum.GetName(typeof(Status), @Model.requests[i].Status)</span>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        var logElements = document.querySelectorAll('.log');
        logElements.forEach(function (element) {
            element.addEventListener('click', function () {

                $.get('/Login/Logout', function (response) {
                    console.log(response)
                });
            });
        });
    });
</script>