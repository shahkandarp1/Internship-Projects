@model FamilyRequestViewModel
@{
    ViewData["Title"] = "Request for Someone Else";
}
@section Styles {
    <link href="~/css/form.css" rel="stylesheet" type="text/css" />
    <link href="~/css/map.css" rel="stylesheet" type="text/css" />
    <script src="~/js/form.js"></script>
}

<div id="body">

    <!-- Navbar -->

    <partial name="_FormNavbar" />

    <!--Location Modal -->

    <div class="modal" id="myModal1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content  map-modal-content">
                <div class="gmap_canvas">
                    <iframe id="gmap_canvas" src="" frameborder="0" scrolling="no" marginheight="0" marginwidth="0">
                    </iframe>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->

    <div class="main-container">
        <div class="flex-container">
            <div class="top-text">
                <span class="submit-text" id="submit-text">Submit Information</span>
                <a class="back-btn" asp-controller="Patient" asp-action="PatientDashboard">
                    &lt; <span class="back-text">Back</span>
                </a>
            </div>
            <form class="main-form" method="post" enctype="multipart/form-data" asp-action="SubmitSomeoneElse">

                <input type="hidden" asp-for="FamilyFirstName" />
                <input type="hidden" asp-for="FamilyLastName" />
                <input type="hidden" asp-for="FamilyEmail" />
                <input type="hidden" asp-for="FamilyPhoneNumber" />

                <!-- Patient Information  -->

                <div class="upper-text">
                    Patient Information
                </div>
                <div class="row symptoms-textarea">
                    <div class="form-floating mt-3 inp col-sm-12">
                        <textarea class="form-control text-area" id="floatingInput" placeholder="name@example.com" asp-for="Symptoms"></textarea>
                        <label for="floatingInput" class="form-label">Enter Brief Details of Symptoms(Optional)</label>
                        <span asp-validation-for="Symptoms" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="first-name" placeholder="name@example.com" asp-for="FirstName">
                        <label for="first-name" class="form-label">First Name</label>
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="last-name" placeholder="name@example.com" asp-for="LastName">
                        <label for="last-name" class="form-label">Last Name</label>
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="date" class="form-control dob" id="dob" placeholder="name@example.com" asp-for="DateOfBirth" >
                        <label for="dob" class="form-label dob-label">Date Of Birth</label>
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                </div>

                <!-- Patient Contact Information -->

                <div class="upper-text margin-top">
                    Patient Contact Information
                </div>
                <div class="row symptoms-textarea">
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="email" class="form-control" id="email" placeholder="name@example.com" asp-for="Email">
                        <label for="email" class="form-label">Email</label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="tel" class="form-control phone" id="phone" asp-for="Phone">
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                </div>

                <!-- Patient Location -->
                <div class="upper-text margin-top">
                    Patient Location
                </div>
                <div class="row symptoms-textarea">
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="street" placeholder="name@example.com" asp-for="Street">
                        <label for="street" class="form-label">Street</label>
                        <span asp-validation-for="Street" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="city" placeholder="name@example.com" asp-for="City">
                        <label for="city" class="form-label">City</label>
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="state" placeholder="name@example.com" asp-for="State">
                        <label for="state" class="form-label">State</label>
                        <span asp-validation-for="State" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="zipcode" placeholder="name@example.com" asp-for="ZipCode">
                        <label for="zipcode" class="form-label">Zipcode</label>
                        <span asp-validation-for="ZipCode" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="room" placeholder="name@example.com" asp-for="Room">
                        <label for="room" class="form-label">Room / Suite (Optional)</label>
                        <span asp-validation-for="Room" class="text-danger"></span>
                    </div>
                    <button class="location col-lg-6 col-md-6 col-sm-12 mt-3" type="button" id="openBtn">
                        <img class="map-img" src="../../images/geo-alt.svg" alt="">
                        <span class="map-text">Map</span>
                    </button>
                </div>

                <!-- Relation -->
                <div class="upper-text margin-top">
                    Relation
                </div>
                <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12 relation">
                    <input type="text" class="form-control" id="relation" placeholder="name@example.com" asp-for="FamilyRelation">
                    <label for="relation" class="form-label">Relation with patient(Optional)</label>
                    <span asp-validation-for="FamilyRelation" class="text-danger"></span>
                </div>

                <!-- Upload Photo or Document -->
                <div class="upper-text margin-top">
                    Upload Photo or Document(Optional)
                </div>
                <div class="file-upload symptoms-textarea">
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12 upload-form">
                        <input type="text" class="form-control" id="file-upload" disabled>
                        <label for="file-upload" class="upload-label dob-label" id="form-label">Select File</label>
                    </div>
                    <label class="custom-file-upload mt-3">
                        <input type="file" onchange="getFileData(this)" asp-for="ImageContent"/>
                        <img src="../../images/cloud-upload-icon.svg" alt="" class="file-upload-img">
                        <span class="upload-text">
                            Upload
                        </span>
                    </label>
                </div>
                <span asp-validation-for="ImageContent" class="text-danger custom-msg"></span>

                <!-- Submit / Clear -->
                <div class="lower-btn">
                    <button class="lower-custom-btn submit-btn" type="submit">Submit</button>
                    <button type="button" class="lower-custom-btn cancel-btn" onclick="reload()">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bottom Part -->

    <partial name="_FormFooter" />
</div>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
    }