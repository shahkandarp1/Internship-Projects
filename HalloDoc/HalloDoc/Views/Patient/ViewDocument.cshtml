@model ViewDocumentModal
@{
    ViewData["Title"] = "View Document";
}
@section Styles {
    <link href="~/css/patient-dashboard.css" rel="stylesheet" type="text/css" />
    <link href="~/css/view-document.css" rel="stylesheet" type="text/css" />
    <script src="~/js/view-document.js"></script>
}

<div id="body">

    <!-- Navbar -->
    <div class="navbar-custom">
        <img src="../../images/logo1.png" alt="" class="logo" />
        <div class="right-side-elements">
            <span class="welcome-text">Welcome <span class="name-text">@Model.name</span></span>
            <a class="logout log" asp-controller="Patient" asp-action="PatientLogin">
                <span class="logout-text">Logout</span>
            </a>
            <a class="logout-mob log" asp-controller="Patient" asp-action="PatientLogin">
                <img id="logout" src="../../images/box-arrow-right.svg" alt="" class="logout-img" />
            </a>
            <button class="moon" onclick="changeMode()">
                <img id="moon" src="../../images/moon.svg" alt="" class="moon-img" />
                <img id="sun" src="../../images/sun.svg" alt="" class="moon-img hidden" />
            </button>
        </div>
    </div>

    <!-- Sidebar -->

    <div id="mySidebar" class="sidebar">
        <div class="tab sidebar-tab">
            <span class="mob-welcome-text">Welcome <span class="mob-name-text">@Model.name</span></span>
            <button class="tablinks sidebar-tablinks mobile-sidebar-active">
                <a asp-controller="Patient" asp-action="PatientDashboard" class="mobile-sidebar-a">
                    Dashboard
                </a>
            </button>
            <button class="tablinks sidebar-tablinks">
                <a asp-controller="Patient" asp-action="PatientProfile" class="mobile-sidebar-a">
                    Profile
                </a>
            </button>
        </div>
    </div>

    <!-- Dark Background when sidebar is open -->
    <div class="overlay" onclick="sidebar_close()">
    </div>

    <!-- Navbar Below Container -->

    <div class="nav-below-container"></div>

    <!-- Navbar - Below -->

    <nav class="navbar navbar-expand-sm navbar-light bg-light">
        <button class="navbar-toggler list-border" type="button" data-toggle="collapse" data-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation" onclick="sidebar_open()">
            <img src="../../images/list.svg" alt="" class="list-img" />
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <div class="tab">
                <button class="tablinks sidebar-active">
                    <a asp-controller="Patient" asp-action="PatientDashboard">
                        Dashboard
                    </a>
                </button>
                <button class="tablinks">
                    <a asp-controller="Patient" asp-action="PatientProfile">
                        Profile
                    </a>
                </button>
            </div>
        </div>
    </nav>
    <div class="upload-main-container">
        <div class="upload-inner-container">
            <div class="top-part">
                <span class="main-heading view-main dark-heading-text" id="main-heading">Documents</span>
                <a class="back-btn" asp-controller="Patient" asp-action="PatientDashboard">
                    &lt; <span class="back-text">Back</span>
                </a>
            </div>
            <div class="wrapper">
                
                <div id="Dashboard" class="main-content">
                    <span class="pt-name-text dark-text">Patient Name</span>
                    <div class="pt-name">@Model.patient_name<span class="con_num dark-text">(@Model.confirmation_number)</span></div>
                    <span class="upload-desc dark-text">Check here for any files that you or doctors of your subsequents requestors have attatched for you to review.</span>
                    <div class="file-upload symptoms-textarea">
                        <div class="form-floating mb-3 inp col-lg-6 col-md-6 col-sm-12 upload-form">
                            <input type="text" class="form-control" id="file-upload" disabled>
                            <label for="file-upload" class="upload-label dob-label" id="form-label">Select File</label>
                        </div>
                        <label class="custom-file-upload">
                            <input id="FileUpload" type="file" onchange="getFileData(this)" name="file" />
                            <img src="../../images/cloud-upload-icon.svg" alt="" class="file-upload-img">
                            <span class="upload-text">
                                Upload
                            </span>
                        </label>

                    </div>
                    <div class="middle-part">
                        <span class="main-heading document-main dark-heading-text" id="main-heading">Documents</span>
                        <a class="back-btn download-text" id="download-all">
                            <span class="back-text">Download All</span>
                        </a>
                        <a class="logout-mob download-mob" id="download-all-mob">
                            <img id="logout" src="~/images/cloud-arrow-down.svg" alt="" class="logout-img" />
                        </a>
                    </div>

                </div>
                <form class="desktop-table" asp-action="ViewDocument">
                    <input type="hidden" style="opacity:0;height:1px;width:1px;" id="filename" asp-for="filename"/>
                    <input type="hidden" asp-for="patient_name"/>

                    <table class="table">
                        <thead>
                            <tr>
                                <th><input type="checkbox" class="checkbox-main" name="selectall" onchange="tickAll()"/></th>
                                <th>Uploader</th>
                                <th>Upload Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var row in Model.requestWiseFiles)
                            {
                                <tr>
                                    <td class="first-col">
                                        <input type="checkbox" name="Mark" value="@(row.FileName)" class="checkbox check" onchange="allCheck()" />
                                        <span class="document-combo">
                                            @if (row.FileName.Split(".")[row.FileName.Split(".").Length - 1] == "xlsx" || row.FileName.Split(".")[row.FileName.Split(".").Length - 1] == "xls")
                                            {
                                                <img src = "~/images/file-x-fill.svg" />
                                            }
                                            else if (row.FileName.Split(".")[row.FileName.Split(".").Length - 1] == "pdf")
                                            {
                                                <img src = "~/images/file-earmark-pdf-fill.svg" />
                                            }
                                            else if (row.FileName.Split(".")[row.FileName.Split(".").Length - 1] == "doc" || row.FileName.Split(".")[row.FileName.Split(".").Length - 1] == "docx")
                                            {
                                                <img src = "~/images/file-word-fill.svg" />
                                            }
                                            else
                                            {
                                                <img src = "~/images/card-image.svg" />
                                            }

                                            <span class="document-name">@row.FileName</span>
                                        </span></td>
                                    <td>

                                        @if(row.PhysicianId != null)
                                        {
                                            <span>@(string.Concat(row.Physician.FirstName, ' ', row.Physician.LastName))</span>
                                        }
                                        else if (row.AdminId != null)
                                        {
                                            <span>@(string.Concat(row.Admin.FirstName, ' ', row.Admin.LastName))</span>
                                        }
                                        else
                                        {
                                            <span>@Model.uploader_name</span>
                                        }
                                    </td>
                                    <td>@row.CreatedDate.ToString("MMMM dd,yyyy")</td>
                                    <td>
                                        <div class="outer-div">
                                            <a class="downld-btn" download href="~/uploads/@(row.FileName)">
                                                <img id="logout" src="~/images/cloud-arrow-down.svg" alt="" class="logout-img" />
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="mob-documents">
                        @foreach (var row in Model.requestWiseFiles)
                        {
                            <span class="mob-component">
                                <div class="first-col">
                                    <input type="checkbox" class="check" name="Mark" value="@(row.FileName)" onchange="allCheck()" />
                                    <span class="document-combo mob-doc-name">
                                        @if (row.FileName.Split(".")[row.FileName.Split(".").Length - 1] == "xlsx" || row.FileName.Split(".")[row.FileName.Split(".").Length - 1] == "xls")
                                        {
                                            <img src="~/images/file-x-fill.svg" />
                                        }
                                        else if (row.FileName.Split(".")[row.FileName.Split(".").Length - 1] == "pdf")
                                        {
                                            <img src="~/images/file-earmark-pdf-fill.svg" />
                                        }
                                        else if (row.FileName.Split(".")[row.FileName.Split(".").Length - 1] == "doc" || row.FileName.Split(".")[row.FileName.Split(".").Length - 1] == "docx")
                                        {
                                            <img src="~/images/file-word-fill.svg" />
                                        }
                                        else
                                        {
                                            <img src="~/images/card-image.svg" />
                                        }
                                        <span class="document-name mob-text dark-text">@row.FileName</span>
                                    </span>
                                </div>
                                <span class="document-name mob-text mob-date dark-text">
                                    @if (row.PhysicianId != null)
                                    {
                                        <span>@(string.Concat(row.Physician.FirstName, ' ', row.Physician.LastName))</span>
                                    }
                                    else if (row.AdminId != null)
                                    {
                                        <span>@(string.Concat(row.Admin.FirstName, ' ', row.Admin.LastName))</span>
                                    }
                                    else
                                    {
                                        <span>@Model.uploader_name</span>
                                    }
                                </span>
                                <span class="document-name mob-text mob-date dark-text">@row.CreatedDate.ToString("MMMM dd,yyyy")</span>
                                <a class="downld-btn mob-download" download href="~/uploads/@(row.FileName)">
                                    <img id="logout" src="~/images/cloud-arrow-down.svg" alt="" class="logout-img" />
                                </a>
                            </span>
                        }
                    </div>
                    <button class="d-none" type="submit" id="submit-btn"></button>
                </form>
            </div>
        </div>
    </div>

    

</div>

<script>
    $(document).ready(function () {
        $('#FileUpload').on('change', function () {
            var inputValue = document.getElementById('FileUpload');
            var file = inputValue.files[0];
            var id = window.location.href.split("/")[window.location.href.split("/").length - 1]

            var formData = new FormData();
            formData.append("file", file);
            formData.append("id", id);

            $.ajax(
                {
                    url: "/Patient/FileUpload",
                    data: formData,
                    processData: false,
                    contentType: false,
                    type: "POST",
                    success: function (data) {
                        location.reload();
                    }
                }
            );
        });
    });

        $(document).ready(function () {
            $('#download-all').on('click', function () {
            const checkbox = document.getElementsByClassName("check")
            let flag = 0
                    let filename = ''
                    for (let i = 0; i < checkbox.length;++i){
                        if(checkbox[i].checked){
                            filename += checkbox[i].value
                            filename+= ','
                            flag = 1
                        }
                    }
                    if(flag==1)
                    {
                        document.getElementById("filename").value = filename
                        document.getElementById("submit-btn").click();
                    }
            });
        });

    $(document).ready(function () {
        $('#download-all-mob').on('click', function () {
            const checkbox = document.getElementsByClassName("check")
            let flag = 0
            let filename = ''
            for (let i = 0; i < checkbox.length; ++i) {
                if (checkbox[i].checked) {
                    filename += checkbox[i].value
                    filename += ','
                    flag = 1
                }
            }
            if (flag == 1) {
                document.getElementById("filename").value = filename
                document.getElementById("submit-btn").click();
            }

        });
    });
</script>

