@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
@section Styles {
    <link href="~/css/admin-login.css" rel="stylesheet" type="text/css" />
    <script src="~/js/admin-login.js"></script>
}
<div onload="checkMode()">

    <partial name="Toast"/>

    <img src="../../images/7774236_3736765.jpg" alt="" class="bg-image">
    <div class="main-container">
        <div class="left half-container">
            <img class="left-img" src="../../images/11116016_415.jpg" alt="">
        </div>
        <div class="right half-container" id="body">
            <span class="top-right-moon">
                <button class="moon" onclick="changeMode()">
                    <img id="moon" src="../../images/moon.svg" alt="" class="moon-img" />
                    <img id="sun" src="../../images/sun.svg" alt="" class="moon-img hidden" />
                </button>
            </span>
            <div class="right-flex-container">
                <div class="logo">
                    <img src="../../images/logo1.png" alt="" class="logo-img">
                </div>
                <form class="login-content" asp-action="Login" asp-controller="Admin" method="post">
                    <span class="login-text" id="login-text">Login To Your Account</span>
                    <div class="form-floating mt-3 inp">
                        <input type="email" class="form-control" id="floatingInput" placeholder="name@example.com" asp-for="Email">
                        <label for="floatingInput" class="form-label">Username</label>
                        <img src="../../images/user.png" alt="" class="inp-side-picture">
                    </div>
                    <span asp-validation-for="Email" class="text-danger mb-3"></span>
                    <div class="form-floating inp">
                        <input type="password" class="form-control" id="floatingPassword" placeholder="Password" asp-for="Password">
                        <label for="floatingPassword" class="form-label">Password</label>
                        <a href="#" onclick="changeVisibility()" style="cursor: pointer;"><img id="open-eye" src="../../images/view.png" alt="" class="inp-side-picture eye"></a>
                        <a href="#" onclick="changeVisibility()" style="cursor: pointer;"><img id="closed-eye" src="../../images/hide.png" alt="" class="inp-side-picture eye hidden"></a>
                    </div>
                    <span asp-validation-for="Password" class="text-danger mb-3"></span>

                    <button class="btn btn-info custom-submit-btn" type="submit">Log In</button>
                    <a asp-controller="Admin" asp-action="ForgotPassword" class="forgot-password">Forgot Password?</a>
                </form>
            </div>
            <div class="bottom-part-flex" id="bottom-flex"><a href="#" class="bottom-part-a right-a">Terms of Conditions</a> | <a href="#" class="bottom-part-a left-a">Privacy Policy</a></div>
        </div>
    </div>
</div>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}