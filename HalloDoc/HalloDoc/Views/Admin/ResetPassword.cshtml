@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}
@section Styles {
    <link href="~/css/admin-login.css" rel="stylesheet" type="text/css" />
    <script src="~/js/admin-login.js"></script>
}
<div onload="checkMode()">
    <partial name="Toast" />
    <img src="../../images/7768657_3763028.jpg" alt="" class="bg-image">
    <div class="main-container">
        <div class="left half-container">
            <img class="left-img" src="../../images/11116016_415.jpg" alt="">
        </div>
        <div class="right half-container" id="body">
            <span class="top-right-moon">
                <button class="moon" onclick="changeMode()">
                    <img id="moon" src="../../images/moon.svg" alt="" class="moon-img" />
                    <img id="sun" src="../../images/sun.svg" alt="" class="moon-img hidden" />
                </button>
            </span>
            <div class="right-flex-container">
                <div class="logo">
                    <img src="../../images/logo1.png" alt="" class="logo-img">
                </div>
                <form class="login-content" asp-action="ResetPassword" asp-controller="Admin" method="post">
                    <input type="hidden" asp-for="Token"/>
                    <span class="login-text mb-3" id="login-text">Reset Your Password</span>
                    <div class="form-floating mt-3 inp">
                        <input type="password" class="form-control" id="floatingPassword" placeholder="Password" asp-for="Password">
                        <label for="floatingPassword" class="form-label">Password</label>
                        <a href="#" onclick="changeVisibility()" style="cursor: pointer;"><img src="../../images/view.png" alt="" class="inp-side-picture eye open-eye"></a>
                        <a href="#" onclick="changeVisibility()" style="cursor: pointer;"><img src="../../images/hide.png" alt="" class="inp-side-picture eye hidden close-eye"></a>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <div class="form-floating mt-3 inp">
                        <input type="password" class="form-control" id="floatingConfirmPassword" placeholder="Password" asp-for="ConfirmPassword">
                        <label for="floatingConfirmPassword" class="form-label">Confirm Password</label>
                        <a href="#" onclick="changeVisibility1()" style="cursor: pointer;"><img id="open-eye" src="../../images/view.png" alt="" class="inp-side-picture eye"></a>
                        <a href="#" onclick="changeVisibility1()" style="cursor: pointer;"><img id="closed-eye" src="../../images/hide.png" alt="" class="inp-side-picture eye hidden"></a>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                    <button class="btn btn-info custom-submit-btn" type="submit">Reset Password</button>
                    <a class="back-to-login-text" asp-controller="Admin" asp-action="Login">&lt; Back To Login</a>
                </form>
            </div>
            <div class="bottom-part-flex" id="bottom-flex"><a href="#" class="bottom-part-a right-a">Terms of Conditions</a> | <a href="#" class="bottom-part-a left-a">Privacy Policy</a></div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}