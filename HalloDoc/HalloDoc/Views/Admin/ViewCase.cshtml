@model ViewCaseViewModel
@{
    ViewData["Title"] = "View Case";
    Layout = "_AdminLayout";
}
@section Styles {
    <link href="~/css/admin-navbar.css" rel="stylesheet" type="text/css" />
    <script src="~/js/admin-navbar.js"></script>
    <script src="~/js/view-case.js"></script>
    <link href="~/css/view-case.css" rel="stylesheet" type="text/css" />
}

<div id="body">


    <!-- Navbar -->
    <partial name="_AdminNavbar" />

    <!-- Toaster -->
    <partial name="Toast" />

    <!-- Cancellation Modal -->
    <form asp-action="CancelRequest" asp-controller="Admin" method="post" onsubmit="checkSelect()">
    <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-title" id="exampleModalLongTitle">Confirm Cancellation</div>
                    <span aria-hidden="true" data-bs-dismiss="modal" class="cross-btn">&times;</span>
                </div>
                
                    <div class="modal-body">
                        <input type="hidden" asp-for="RequestId"/>
                        <span class="modal-head"><label for="floatingInput" class="form-label">Patient Name:</label><span class="pt-name">@(string.Concat(Model.FirstName, ' ', Model.LastName))</span></span>
                        <div class="form-floating mt-3 inp col-lg-2 col-md-2 col-sm-4 col-4">
                            <select class="form-control select editable" id="Select" placeholder="name@example.com" onchange="selectChange(this)" asp-for="CaseTag">
                                <option class="option-modal" value="-1">Reason For Cancellation</option>
                                @foreach (var item in Model.caseTags)
                                {
                                    <option class="option-modal" value="@item.Name">@item.Name</option>
                                }
                            </select>
                        </div>
                        <span id="warning" class="text-danger hidden">Please select Case Tag</span>
                        <div class="form-floating mt-3 inp col-sm-12 notes-text">
                            <textarea class="form-control text-area" id="admin-notes" placeholder="name@example.com" required asp-for="Admin_notes"></textarea>
                            <label for="admin_notes" class="form-label">Provide Additional Notes</label>
                        </div>
                        <div class="lower-btn">
                            <button type="submit" class="btn btn-info continue-btn" id="confirm-btn">Confirm</button>
                            <a id="cancel" class="btn cancel-btn">Cancel</a>
                        </div>
                    </div>
                
            </div>
        </div>
        </div>
        </form>
    <!--Location Modal -->

    <div class="modal" id="myModal1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <section>
                    <div class="mapouter">
                        <div class="gmap_canvas">
                            <iframe width="600" height="500" id="gmap_canvas" src="" frameborder="0" scrolling="no" marginheight="0" marginwidth="0">

                                <!-- </iframe><a href="https://123movies-to.org">123 movies</a><br> -->
                                <style>
                                    .mapouter {
                                        position: relative;
                                        text-align: right;
                                        height: 500px;
                                        width: 600px;
                                    }</style>
                                <!-- <a href="https://www.embedgooglemap.net">embedgooglemap.net</a> -->
                                <style>
                                    .gmap_canvas {
                                        overflow: hidden;
                                        background: none !important;
                                        height: 500px;
                                        width: 600px;
                                    }
                                </style>
                            </iframe>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <div class="main-container">
        <div class="flex-container">
            <div class="top-text">
                <div class="view-text">
                    @if (Model.Status == 1)
                    {
                        <span class="submit-text" id="submit-text">New Request</span>
                    }
                    else
                    {
                        <span class="submit-text" id="submit-text">View Reservation</span>
                    }
                    @if(Model.RequestTypeId == 1)
                    {
                        <span class="requestor-btn business-color">Business</span>
                    }
                    else if (Model.RequestTypeId == 2)
                    {
                        <span class="requestor-btn patient-color">Patient</span>
                    }
                    else if (Model.RequestTypeId == 3)
                    {
                        <span class="requestor-btn family-color">Family</span>
                    }
                    else
                    {
                        <span class="requestor-btn concierge-color">Concierge</span>
                    }
                </div>

                <a class="back-btn" asp-controller="Admin" asp-action="Dashboard">
                    &lt; <span class="back-text">Back</span>
                </a>
            </div>
            <form class="main-form" asp-action="ViewCase" method="post" onsubmit="beforeSubmit()">

                <input type="hidden" asp-for="RequestClientId" />
                <input type="hidden" asp-for="Status" />
                <input type="hidden" asp-for="RequestId" />
                <input type="hidden" asp-for="RequestTypeId" />
                <input type="hidden" asp-for="ConfirmationNumber" />
                <input type="hidden" asp-for="RequestTypeId" />
                <!-- General Information  -->
                <div class="upper-text">
                    Patient Information
                </div>
                <div class="cont-con-num mb-2">
                    <label for="dob" class="form-label con-label">Confirmation Number</label>
                    <span class="con-num">@Model.ConfirmationNumber</span>
                </div>
                <div class="row">
                    <div class="form-floating inp col-sm-12">
                        <textarea class="form-control text-area" id="floatingInput" placeholder="name@example.com" asp-for="Notes" disabled></textarea>
                        <label for="floatingInput" class="form-label">Patient Notes</label>
                    </div>

                    <span class="outer-hr"><hr class="dotted-line"></span>

                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="first-name" placeholder="name@example.com" asp-for="FirstName" disabled>
                        <label for="first-name" class="form-label">First Name</label>
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="last-name" placeholder="name@example.com" asp-for="LastName" disabled>
                        <label for="last-name" class="form-label">Last Name</label>
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="date" class="form-control dob" id="dob" placeholder="name@example.com" asp-for="DateOfBirth" disabled>
                        <label for="dob" class="form-label dob-label">Date Of Birth</label>
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-5 col-md-5 col-sm-10 col-10">
                        <input type="tel" class="form-control phone editable" id="phone" asp-for="PhoneNumber" disabled>
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <a class="location col-lg-1 col-md-1 col-sm-2 mt-3">
                        <img class="map-img" src="../../images/telephone-blue.svg" alt="">
                    </a>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="email" class="form-control editable" id="emailInput" placeholder="name@example.com" asp-for="Email" disabled>
                        <label for="emailInput" class="form-label">Email</label>
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    @if(Model.Status != 1)
                    {
                        <div class="col-lg-6 col-md-6 col-sm-12 mt-3">
                            <a class="lower-custom-btn cancel-btn" onclick="Edit()">Edit</a>
                            <div class="lower-edit-btn">
                                <button class="lower-custom-btn cancel-btn hidden" type="submit">Save</button>
                                <a class="lower-custom-btn cancel-btn hidden" onclick="Cancel()">Cancel</a>
                            </div>
                        </div>
                    }
                </div>

                <!-- Patient Location -->
                <div class="upper-text margin-top mt-3">
                    Location Information
                </div>
                <div class="row symptoms-textarea">
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="region" placeholder="name@example.com" asp-for="Region" disabled>
                        <label for="street" class="form-label">Region</label>
                        <span asp-validation-for="Region" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-5 col-md-5 col-sm-10 col-10">
                        <input type="text" class="form-control" id="address" placeholder="name@example.com" asp-for="Address" disabled>
                        <label for="city" class="form-label">Address</label>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <a class="location col-lg-1 col-md-1 col-sm-2 mt-3" id="openBtn">
                        <img class="map-img" src="../../images/geo-alt.svg" alt="">
                    </a>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="room" placeholder="name@example.com" asp-for="Room" disabled>
                        <label for="zipcode" class="form-label">Room</label>
                    </div>
                    
                </div>
                <span asp-validation-for="Address" class="text-danger custom-msg"></span>

                <!-- Submit / Clear -->
                <div class="lower-btn">
                    @if(Model.Status == 1)
                    {
                        <a class="btn btn-info">Assign</a>
                    }
                    <a class="btn btn-info" asp-action="ViewNotes" asp-controller="Admin" asp-route-id="@Model.id">View Notes</a>
                    <a class="btn btn-danger" id="openBtnC">Cancel</a>
                </div>
            </form>
        </div>
    </div>
    <script src="//code.jquery.com/jquery-1.11.0.min.js"></script>
    <script>

        const selectChange = (text) => {
            if(text.value!=-1)
            {
                document.getElementById("warning").style.display = "none";
            }
        }

        const checkSelect = () => {
            const select = document.getElementById("Select")
            if (select.value == -1) {
                document.getElementById("warning").style.display = "block";
                return false;
            }
        }

        const beforeSubmit = () => {
            const inputs = document.getElementsByClassName("form-control")
            for(let i=0;i<inputs.length;++i)
            {
                inputs[i].disabled = false;
            }
        }

        $(document).ready(function () {
            $('#confirm-btn').on('click', function () {
                console.log("Hello")
                const select = document.getElementById("Select")
                if (select.value == -1) {
                    document.getElementById("warning").style.display = "block";
                    return false;
                }
                else{
                    document.getElementById("warning").style.display = "none";
                }
        });

        });

                $(document).ready(function () {
                    $("#openBtnC").click(function () {
                        $("#myModal").modal("show");
                    });
                });

        $(document).ready(function () {
            $("#cancel").click(function () {
                $("#myModal").modal("hide");
            });
        });

        $(document).ready(function () {
            $("#openBtn").click(function () {
                $("#myModal1").modal("show");
                var address = $("#address").val();
                var Street = address.split(",")[0]
                var City = address.split(",")[1]
                var State = address.split(",")[2]
                var ZipCode = address.split(",")[3]
                var address = "https://maps.google.com/maps?q=" + Street + City + State + ZipCode + "&t=&z=13&ie=UTF8&iwloc=&output=embed";
                $("#gmap_canvas").attr("src", address);
            });
        });
    </script>

</div>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
    }