@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}
@section Styles {
    <link href="~/css/admin-dashboard.css" rel="stylesheet" type="text/css" />
    <link href="~/css/admin-navbar.css" rel="stylesheet" type="text/css" />
    <link href="~/css/map.css" rel="stylesheet" type="text/css" />

}
<div id="body">
    @{
        var admin = Model.adminNavbarViewModel.role == "Admin" ? "" : "hidden";
    }
    <!-- Navbar -->

    <partial name="_AdminNavbar" model="@Model.adminNavbarViewModel" />


    <!-- Toaster -->
    <partial name="Toast" />


    <!-- Cancellation Modal -->
    <form asp-action="CancelRequest" asp-controller="Admin" method="post" onsubmit="@Html.Raw("return checkSelect()")">
        <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="modal-title" id="exampleModalLongTitle">Confirm Cancellation</div>
                        <span aria-hidden="true" data-bs-dismiss="modal" class="cross-btn">&times;</span>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" asp-for="RequestId" id="req-id"/>
                        <span class="modal-head"><label for="floatingInput" class="form-label">Patient Name:</label><span class="pt-name" id="pt-name"></span></span>
                        <div class="form-floating mt-3 inp col-lg-2 col-md-2 col-sm-4 col-4">
                            <select class="form-control select editable" id="Select-cancel" placeholder="name@example.com" onchange="selectChange(this)" asp-for="CaseTag">
                                <option class="option-modal" value="-1">Reason For Cancellation</option>
                                @foreach (var items in Model.caseTags)
                                {
                                    <option class="option-modal" value="@items.Name">@items.Name</option>
                                }
                            </select>
                        </div>
                        <span id="warning-cancel" class="text-danger hidden">Please select Case Tag</span>
                        <div class="form-floating mt-3 inp col-sm-12 notes-text">
                            <textarea class="form-control text-area" id="admin-notes" placeholder="name@example.com" required asp-for="Admin_notes"></textarea>
                            <label for="admin_notes" class="form-label">Provide Additional Notes</label>
                        </div>
                        <div class="lower-btn">
                            <button type="submit" class="btn btn-info continue-btn" id="confirm-btn">Confirm</button>
                            <a id="cancel" class="btn cancel-btn">Cancel</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <!-- Block Case Modal -->
    <form asp-action="BlockCase" asp-controller="Admin" method="post">
        <div class="modal fade" id="myModalBlock" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="modal-title" id="exampleModalLongTitle">Confirm Block</div>
                        <span aria-hidden="true" data-bs-dismiss="modal" class="cross-btn">&times;</span>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" asp-for="RequestId" id="req-block-id" />
                        <span class="modal-head"><label for="floatingInput" class="form-label">Patient Name:</label><span class="pt-name" id="pt-block-name"></span></span>
                        <div class="form-floating mt-3 inp col-sm-12 notes-text">
                            <textarea class="form-control text-area" id="block-reason" placeholder="name@example.com" required asp-for="BlockReason"></textarea>
                            <label for="admin_notes" class="form-label">Reason for Block Request</label>
                        </div>
                        <div class="lower-btn">
                            <button type="submit" class="btn btn-info continue-btn" id="confirm-btn">Confirm</button>
                            <a id="cancel-block" class="btn cancel-btn">Cancel</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <!-- Request DTY Support -->
    <form asp-action="RequestDTYSupport" asp-controller="Admin" method="post">
        <div class="modal fade" id="myModalDTY" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="modal-title" id="exampleModalLongTitle">Request Support</div>
                        <span aria-hidden="true" data-bs-dismiss="modal" class="cross-btn">&times;</span>
                    </div>

                    <div class="modal-body">
                        <div class="disclaimer-agreement-font assign-transfer-modal">To all unscheduled Physicians: We are on coverage and needs needs additional support on Call to respond to Requests.</div>
                        <div class="form-floating mt-3 inp col-sm-12 notes-text">
                            <textarea class="form-control text-area" id="request-reason" placeholder="name@example.com" required asp-for="BlockReason"></textarea>
                            <label for="admin_notes" class="form-label">Message</label>
                        </div>
                        <div class="lower-btn">
                            <button type="submit" class="btn btn-info continue-btn" id="confirm-btn">Send</button>
                            <a id="cancel-dty" class="btn cancel-btn">Cancel</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <!-- Assign Case Modal -->
    <form asp-action="AssignCase" asp-controller="Admin" method="post" onsubmit="@Html.Raw("return checkAssign()")">
        <div class="modal fade" id="myModalAssign" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="modal-title" id="exampleModalLongTitle">Assign Request</div>
                        <span aria-hidden="true" data-bs-dismiss="modal" class="cross-btn">&times;</span>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" asp-for="RequestId" id="req-assign-id" />
                        <div class="disclaimer-agreement-font assign-transfer-modal">To assign this request, search and select another physician</div>
                        <div class="form-floating mt-3 inp col-lg-2 col-md-2 col-sm-4 col-4">
                            <select class="form-control select editable" id="Select-region" placeholder="name@example.com" asp-for="RegionId" onchange="changePhysician(this)">
                                @foreach (var items in Model.regions)
                                {
                                    <option class="option-modal" value="@items.RegionId">@(items.Name.Substring(0, 1).ToUpper() + items.Name.Substring(1).ToLower())</option>
                                }
                            </select>
                            <label for="Select-region" class="form-label">Narrow search By Region</label>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-2 col-md-2 col-sm-4 col-4">
                            <select class="form-control physician-assign editable" id="Select-physician" placeholder="name@example.com" asp-for="PhysicianId" onchange="selectAssign(this)">
                                <option class="option-modal" value="-1">Select Physician</option>
                            </select>
                        </div>
                        <span id="warning-assign" class="text-danger hidden">Please Select Physician</span>
                        <div class="form-floating mt-3 inp col-sm-12 notes-text">
                            <textarea class="form-control text-area" id="transfer-notes" placeholder="name@example.com" required asp-for="Description"></textarea>
                            <label for="admin_notes" class="form-label">Description</label>
                        </div>
                        <div class="lower-btn">
                            <button type="submit" class="btn btn-info continue-btn" id="confirm-btn">Confirm</button>
                            <a id="cancel-assign" class="btn cancel-btn">Cancel</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <!-- Transfer Case Modal -->
    <form asp-action="TransferCase" asp-controller="Admin" method="post" onsubmit="@Html.Raw("return checkAssignT()")">
        <div class="modal fade" id="myModalTransfer" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="modal-title" id="exampleModalLongTitle">Transfer Request</div>
                        <span aria-hidden="true" data-bs-dismiss="modal" class="cross-btn">&times;</span>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" asp-for="RequestId" id="req-transfer-id" />
                        <div class="disclaimer-agreement-font assign-transfer-modal">To transfer this request, search and select another physician</div>
                        <div class="form-floating mt-3 inp col-lg-2 col-md-2 col-sm-4 col-4">
                            <select class="form-control select editable" id="Select-region-t" placeholder="name@example.com" asp-for="RegionId" onchange="changePhysicianT(this)">
                                @foreach (var items in Model.regions)
                                {
                                    <option class="option-modal" value="@items.RegionId">@(items.Name.Substring(0, 1).ToUpper() + items.Name.Substring(1).ToLower())</option>
                                }
                            </select>
                            <label for="Select-region-t" class="form-label">Narrow search By Region</label>
                        </div>
                        <div class="form-floating mt-3 inp col-lg-2 col-md-2 col-sm-4 col-4">
                            <select class="form-control physician-assign editable" id="Select-physician-t" placeholder="name@example.com" asp-for="PhysicianId" onchange="selectAssignT(this)">
                                <option class="option-modal" value="-1">Select Physician</option>
                            </select>
                        </div>
                        <span id="warning-assign-t" class="text-danger hidden">Please Select Physician</span>
                        <div class="form-floating mt-3 inp col-sm-12 notes-text">
                            <textarea class="form-control text-area" id="transfer-notes-t" placeholder="name@example.com" required asp-for="Description"></textarea>
                            <label for="admin_notes" class="form-label">Description</label>
                        </div>
                        <div class="lower-btn">
                            <button type="submit" class="btn btn-info continue-btn" id="confirm-btn">Confirm</button>
                            <a id="cancel-transfer" class="btn cancel-btn">Cancel</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>


    <!-- Send Link Modal -->
    <form asp-action="SendLink" asp-controller="Admin" method="post">
        <div class="modal fade" id="myModalLink" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="modal-title" id="exampleModalLongTitle">Send Mail to patient for submitting request</div>
                        <span aria-hidden="true" data-bs-dismiss="modal" class="cross-btn">&times;</span>
                    </div>

                    <div class="modal-body">
                        <div class="form-floating mt-3 col-12 notes-text">
                            <input type="text" class="form-control" id="business-first-name" placeholder="name@example.com" asp-for="Mail_FirstName" required>
                            <label for="business-first-name" class="form-label">First Name</label>
                        </div>
                        <div class="form-floating mt-3 col-12 notes-text">
                            <input type="text" class="form-control" id="business-last-name" placeholder="name@example.com" asp-for="Mail_LastName" required>
                            <label for="business-last-name" class="form-label">Last Name</label>
                        </div>
                        <div class="form-floating mt-3 col-12 notes-text">
                            <input type="tel" class="form-control phone" id="business-phone" asp-for="Mail_PhoneNumber" required>
                        </div>
                        <span class="text-danger" asp-validation-for="Mail_PhoneNumber"></span>
                        <div class="form-floating mt-3 col-12 notes-text">
                            <input type="email" class="form-control" id="business-email" placeholder="name@example.com" asp-for="Mail_Email" required>
                            <label for="business-email" class="form-label">Your email</label>
                        </div>
                        <span class="text-danger" asp-validation-for="Mail_Email"></span>
                        <div class="lower-btn">
                            <button type="submit" class="btn btn-info continue-btn" id="confirm-btn">Send</button>
                            <a id="cancel-link" class="btn cancel-btn">Cancel</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <!-- Send Agreement Modal -->
    <form asp-action="SendAgreement" asp-controller="Admin" method="post">
        <div class="modal fade" id="myModalAgreement" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="modal-title" id="exampleModalLongTitle">Send Agreement</div>
                        <span aria-hidden="true" data-bs-dismiss="modal" class="cross-btn">&times;</span>
                    </div>

                    <div class="modal-body">  
                        <input type="hidden" asp-for="RequestId" id="req-agreement-id" />
                        <div class="req-accordion-filter Patient hidden" id="patient-agreement">
                            <span class="color patient-color"></span>
                            <span class="requestor-type accordion-requestor agreement-type-font">Patient</span>
                        </div>

                        <div class="req-accordion-filter Patient hidden" id="business-agreement">
                            <span class="color business-color"></span>
                            <span class="requestor-type accordion-requestor agreement-type-font">Business</span>
                        </div>

                        <div class="req-accordion-filter Patient hidden" id="family-agreement">
                            <span class="color family-color"></span>
                            <span class="requestor-type accordion-requestor agreement-type-font">Family</span>
                        </div>
                        <div class="req-accordion-filter Patient hidden" id="concierge-agreement">
                            <span class="color concierge-color"></span>
                            <span class="requestor-type accordion-requestor agreement-type-font">Concierge</span>
                        </div>

                        <div class="disclaimer-agreement-font">To send agreement please make sure you are updating the correct contact information below for the responsible party</div>
                        <div class="form-floating mt-3 col-12 notes-text">
                            <input type="tel" class="form-control phone" id="agreement-phone" asp-for="Mail_PhoneNumber" required >
                        </div>
                        <span class="text-danger" asp-validation-for="Mail_PhoneNumber"></span>
                        <div class="form-floating mt-3 col-12 notes-text">
                            <input type="email" class="form-control" id="agreement-email" placeholder="name@example.com" asp-for="Mail_Email" required >
                            <label for="agreement-email" class="form-label">Your email</label>
                        </div>
                        <span class="text-danger" asp-validation-for="Mail_Email"></span>
                        <div class="lower-btn">
                            <button type="submit" class="btn btn-info continue-btn" id="confirm-btn">Send</button>
                            <a id="cancel-agreement" class="btn cancel-btn">Cancel</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <!-- Clear case Modal -->
    <form asp-action="ClearCase" asp-controller="Admin" method="post">
        <div class="modal" id="myModalClear">
            <div class="modal-dialog modal-dialog-centered clear-modal-dialog-centered">
                <div class="modal-content clear-modal-content">
                    <div class="modal-body clear-modal-body">
                        <input type="hidden" asp-for="RequestId" id="req-clear-id" />
                        <div class="outer-border">
                            <img src="../../images/exclamation-circle-fill.svg" alt="" class="exclamation-img">
                        </div>
                        <p class="information-heading">Confirmation for Clear Case</p>
                        <p class="information-data">
                            Are you sure you want to clear this request? Once clear this request then you are not able to see this request.
                        </p>
                        <div>
                            <button type="submit" class="btn btn-info ok-btn clear-btn">Clear</button>
                            <a id="cancel-clear" class="btn cancel-btn cancel-clear-btn">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- Doctor Encounter Modal -->
    <div class="modal fade" id="myModalEncounterActive" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-title" id="exampleModalLongTitle">Select Type Of Care</div>
                    <span aria-hidden="true" data-bs-dismiss="modal" class="cross-btn">&times;</span>
                </div>
                <form asp-action="TypeOfCare" asp-controller="Doctor" method="post">
                    <input type="hidden" asp-for="typeOfCare" id="typeOfCare">
                    <input type="hidden" asp-for="RequestId" id="reqId">
                    <div class="modal-body">
                        <div class="modal-flex">
                            <div class="btn common-btn cancel-btn create-request-active" onclick="toggleButton(this,'HouseCall')"> House Call </div>
                            <div class="btn common-btn cancel-btn" onclick="toggleButton(this,'Consult')"> Consult </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-info continue-btn" data-bs-dismiss="modal">Save</button>
                        <button type="button" class="btn cancel-btn" id="cancel-encounter">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Doctor Transfer Case -->
    <form asp-action="TransferCase" asp-controller="Doctor" method="post">
        <div class="modal fade" id="myModalTransferDoctor" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="modal-title" id="exampleModalLongTitle">Transfer Case</div>
                        <span aria-hidden="true" data-bs-dismiss="modal" class="cross-btn">&times;</span>
                    </div>
                    <input type="hidden" asp-for="RequestId" id="reqTransferId">
                    <div class="modal-body">
                        <div class="disclaimer-agreement-font assign-transfer-modal">This request will transfered to admin.</div>
                        <div class="form-floating mt-3 inp col-sm-12 notes-text">
                            <textarea class="form-control text-area" id="request-doctor-reason" placeholder="name@example.com" required asp-for="BlockReason"></textarea>
                            <label for="admin_notes" class="form-label">Description</label>
                        </div>
                        <div class="lower-btn">
                            <button type="submit" class="btn btn-info continue-btn" id="confirm-btn">Submit</button>
                            <a id="cancel-doctor-transfer" class="btn cancel-btn">Cancel</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </form>

    <!-- Finalized Encounter Modal -->
    <div class="modal fade" id="myModalEncounterFinalized" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-title" id="exampleModalLongTitle">Encounter Form</div>
                    <span aria-hidden="true" data-bs-dismiss="modal" class="cross-btn">&times;</span>
                </div>
                <form asp-action="DownloadEncounterForm" asp-controller="Doctor" method="post">
                    <input type="hidden" asp-for="RequestId" id="reqFinalizeId">
                    <div class="modal-body">
                        <div class="disclaimer-agreement-font assign-transfer-modal">Encounter form is finalized successfully!!</div>
                        <div class="modal-flex finalize-encounter-download">
                            <button type="submit" class="btn common-btn cancel-btn create-request-active"> Download </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!--Location Modal -->

    <div class="modal" id="myModal1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content map-modal-content">
                <div class="gmap_canvas">
                    <iframe id="gmap_canvas" src="" frameborder="0" scrolling="no" marginheight="0" marginwidth="0">
                    </iframe>
                </div>
            </div>
        </div>
    </div>


    <div class="main-container">
        
      <div class="inner-main-container">
        <!-- Status Cards -->
        
            <div class="row status-row">
                <div class="col-lg-2 col-md-4 col-4 mb-2">
                    <div class="row-cards new"
                         id="card1"
                         onclick="changeStatus(this)">
                        <div class="inner-row-cards">
                            <img src="../../images/new.svg"
                                 alt=""
                                 class="row-card-img"
                                 id="new" />
                            <img src="../../images/new_active.png"
                                 alt=""
                                 class="row-card-img hidden"
                                 id="new-active" />
                            <span class="row-card-text">NEW</span>
                        </div>
                        <h4 class="type_no_txt">@Model.new_count</h4>
                        <div id="new-img" class="absolutivity hidden">
                            <img src="../../images/caret-down-fill.svg"
                                 alt=""
                                 class="arrow-width" />
                        </div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4 col-4 mb-2">
                    <div class="row-cards pending"
                         id="card2"
                         onclick="changeStatus(this)">
                        <div>
                            <img src="../../images/pending.svg"
                                 alt=""
                                 class="row-card-img"
                                 id="pending" />
                            <img src="../../images/pending_active.png"
                                 alt=""
                                 class="row-card-img hidden"
                                 id="pending-active" />
                            <span class="row-card-text">PENDING</span>
                        </div>
                        <h4 class="type_no_txt">@Model.pending_count</h4>
                        <div id="pending-img" class="absolutivity hidden">
                            <img src="../../images/caret-down-fill1.svg"
                                 alt=""
                                 class="arrow-width" />
                        </div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4 col-4 mb-2">
                    <div class="row-cards active"
                         id="card3"
                         onclick="changeStatus(this)">
                        <div>
                            <img src="../../images/active.svg"
                                 alt=""
                                 class="row-card-img"
                                 id="active" />
                            <img src="../../images/active_active.png"
                                 alt=""
                                 class="row-card-img hidden"
                                 id="active-active" />
                            <span class="row-card-text">ACTIVE</span>
                        </div>
                        <h4 class="type_no_txt">@Model.active_count</h4>
                        <div id="active-img" class="absolutivity hidden">
                            <img src="../../images/caret-down-fill2.svg"
                                 alt=""
                                 class="arrow-width" />
                        </div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4 col-4 mb-2">
                    <div class="row-cards conclude"
                         id="card4"
                         onclick="changeStatus(this)">
                        <div>
                            <img src="../../images/conclude.svg"
                                 alt=""
                                 class="row-card-img"
                                 id="conclude" />
                            <img src="../../images/conclude_active.png"
                                 alt=""
                                 class="row-card-img hidden"
                                 id="conclude-active" />
                            <span class="row-card-text">CONCLUDE</span>
                        </div>
                        <h4 class="type_no_txt">@Model.conclude_count</h4>
                        <div id="conclude-img" class="absolutivity hidden">
                            <img src="../../images/caret-down-fil3.svg"
                                 alt=""
                                 class="arrow-width" />
                        </div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4 col-4 mb-2 @admin">
                    <div class="row-cards to-close"
                         id="card5"
                         onclick="changeStatus(this)">
                        <div>
                            <img src="../../images/toclose.svg"
                                 alt=""
                                 class="row-card-img"
                                 id="to-close" />
                            <img src="../../images/toclose_active.png"
                                 alt=""
                                 class="row-card-img hidden"
                                 id="to-close-active" />
                            <span class="row-card-text">TO CLOSE</span>
                        </div>
                        <h4 class="type_no_txt">@Model.toclose_count</h4>
                        <div id="to-close-img" class="absolutivity hidden">
                            <img src="../../images/caret-down-fill4.svg"
                                 alt=""
                                 class="arrow-width" />
                        </div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4 col-4 mb-2 @admin">
                    <div class="row-cards unpaid"
                         id="card6"
                         onclick="changeStatus(this)">
                        <div>
                            <img src="../../images/unpaid.svg"
                                 alt=""
                                 class="row-card-img"
                                 id="unpaid" />
                            <img src="../../images/unpaid_active.png"
                                 alt=""
                                 class="row-card-img hidden"
                                 id="unpaid-active" />
                            <span class="row-card-text">UNPAID</span>
                        </div>
                        <h4 class="type_no_txt">@Model.unpaid_count</h4>
                        <div id="unpaid-img" class="absolutivity hidden">
                            <img src="../../images/caret-down-fill5.svg"
                                 alt=""
                                 class="arrow-width" />
                        </div>
                    </div>
                </div>

          <!-- Patient text and buttons -->
        </div>
        <div class="row mt-3">
          <div class="inner-pt-container">
            <span class="patients-text"
              >Patients<span class="status-text" id="status-text"
                >(New)</span
              ></span
            >
            <div class="links">
              <div class="btn btn-info text-white patient-text-btn" id="sendEmail">
                <i class="bi bi-send"></i>
                <span class="d-none d-lg-inline-flex">Send Link</span>
              </div>
              <a class="btn btn-info text-white patient-text-btn" asp-action="CreateRequest" asp-controller="Admin">
                <i class="bi bi-pencil-square"></i>
                <span class="d-none d-lg-inline-flex">Create Request</span>
              </a>

            <div class="btn btn-info text-white patient-text-btn @admin" onclick="submit()">
                <i class="bi bi-arrow-90deg-right"></i>
                <span class="d-none d-lg-inline-flex">Export</span>
            </div>

               <a class="btn btn-info text-white patient-text-btn @admin" asp-action="ExportAll" asp-controller="Admin">
                <i class="bi bi-arrow-90deg-right"></i>
                <span class="d-none d-lg-inline-flex">Export All</span>
              </a>
                <div class="btn btn-info text-white patient-text-btn @admin">
                <i class="bi bi-person-fill"></i>
                <span class="d-none d-lg-inline-flex" id="request-dty-support">Request DTY Support</span>
              </div>
            </div>
          </div>
        </div>

        <div class="bottom-main-container mt-3 mb-3 pb-3 bg-body">
          <!-- Filter Section -->

          <div class="filter-section">
            <div class="inner-filter-flex">
              <div class="search-flex">
                <span class="search">
                  <img
                    class="search-image"
                    src="../../images/search.svg"
                    alt=""
                  />
                  <input
                    class="search-inp"
                    id="search"
                    type="text"
                    placeholder="Search Patients"
                    onkeyup="filter(1,10)"
                  />
                </span>
                <span class="search @admin">
                  <img
                    class="search-image"
                    src="../../images/search.svg"
                    alt=""
                  />
                  <select name="" id="region" class="search-inp" onchange="filter(1,10)">
                    <option value="-1">All Regions</option>
                    @foreach(var item in Model.regions){
                        <option value="@item.RegionId">@(item.Name.Substring(0, 1).ToUpper() + item.Name.Substring(1).ToLower())</option>
                    }
                  </select>
                </span>
              </div>
              <div class="request-filter">
                <a
                  class="req-filter All filter-active"
                  onclick="changeRequestor(this)"
                  >All</a
                >
                <a class="req-filter Patient" onclick="changeRequestor(this)"
                  ><span class="color patient-color"></span
                  ><span class="requestor-type">Patient</span></a
                >
                <a class="req-filter Family" onclick="changeRequestor(this)"
                  ><span class="color family-color"></span
                  ><span class="requestor-type">Family/Friend</span></a
                >
                <a class="req-filter Business" onclick="changeRequestor(this)"
                  ><span class="color business-color"></span
                  ><span class="requestor-type">Business</span></a
                >
                <a class="req-filter Concierge" onclick="changeRequestor(this)"
                  ><span class="color concierge-color"></span
                  ><span class="requestor-type">Concierge</span></a
                >
              </div>
            </div>
          </div>

          <!-- Dynamic Content -->

          <div id="partial-container"></div>

          <!--Loader-->

          <div class="loader-container">
                    <div class="loader"></div>
          </div>
          
        </div>
      </div>
    </div>
</div>
<script src="//code.jquery.com/jquery-1.11.0.min.js"></script>
<script>

    const filter = (page,pageSize) => {
        const states = document.getElementsByClassName("req-filter")
        for (let i = 0; i < states.length; ++i) {
            if (states[i].classList.length == 3) {
                document.getElementById("partial-container").style.display = "none";
                document.getElementsByClassName("loader-container")[0].style.display = "flex";
                localStorage.setItem("status", document.getElementById("status-text").innerHTML.substring(1, document.getElementById("status-text").innerHTML.length - 1))
                localStorage.setItem("search", document.getElementById("search").value)
                localStorage.setItem("requestor", states[i].classList[1])
                localStorage.setItem("region", document.getElementById("region").value)
                localStorage.setItem("page", page)
                localStorage.setItem("pageSize", pageSize)
                $.ajax({
                    url: `/Admin/${document.getElementById("status-text").innerHTML.substring(1, document.getElementById("status-text").innerHTML.length - 1)}`,
                    type: 'POST',
                    dataType: 'html',
                    data: { search: document.getElementById("search").value, region: document.getElementById("region").value, requestor: states[i].classList[1],page:page,pageSize:pageSize },
                    // Pass your data here
                    success: function (response) {
                        document.getElementsByClassName("loader-container")[0].style.display = "none";
                        document.getElementById("partial-container").style.display = "block";
                        $("#partial-container").html(response)
                    },
                    error: function () {
                        alert('An error occurred.');
                    }
                });
            }
        }
    }

    $(document).ready(function () {
        $("#sendEmail").click(function () {
            $("#myModalLink").modal("show");
        });
    });

    $(document).ready(function () {
        $("#cancel").click(function () {
            document.getElementById("admin-notes").value = ""
            document.getElementById("Select-cancel").value = -1
            $("#myModal").modal("hide");
        });
    });

    $(document).ready(function () {
        $("#cancel-agreement").click(function () {
            $("#myModalAgreement").modal("hide");
        });
    });
    
    $(document).ready(function () {
        $("#cancel-doctor-transfer").click(function () {
            document.getElementById("request-doctor-reason").value = ""
            $("#myModalTransferDoctor").modal("hide");
        });
    });
    
    $(document).ready(function () {
        $("#request-dty-support").click(function () {
            $("#myModalDTY").modal("show");
        });
    });

    $(document).ready(function () {
        $("#cancel-dty").click(function () {
            document.getElementById("request-reason").value = ""
            $("#myModalDTY").modal("hide");
        });
    });

    $(document).ready(function () {
        $("#cancel-assign").click(function () {
            document.getElementById("Select-physician").value = -1
            document.getElementById("transfer-notes").value = ""
            $("#myModalAssign").modal("hide");
        });
    });

    $(document).ready(function () {
        $("#cancel-link").click(function () {
            document.getElementById("business-phone").value = ""
            document.getElementById("business-email").value = ""
            document.getElementById("business-last-name").value = ""
            document.getElementById("business-first-name").value = ""
            $("#myModalLink").modal("hide");
        });
    });

    $(document).ready(function () {
        $("#cancel-block").click(function () {
            document.getElementById("block-reason").value = ""
            $("#myModalBlock").modal("hide");
        });
    });

    $(document).ready(function () {
        $("#cancel-transfer").click(function () {
            document.getElementById("Select-physician-t").value = -1
            document.getElementById("transfer-notes-t").value = ""
            $("#myModalTransfer").modal("hide");
        });
    });

    $(document).ready(function () {
        $("#cancel-clear").click(function () {
            $("#myModalClear").modal("hide");
        });
    });
    
    $(document).ready(function () {
        $("#cancel-encounter").click(function () {
            $("#myModalEncounterActive").modal("hide");
        });
    });

    const submit = () => {
        const states = document.getElementsByClassName("req-filter")
        for (let i = 0; i < states.length; ++i) {
            if (states[i].classList.length == 3) {
                    document.getElementById("requestor_submit").value = states[i].classList[1]
                    document.getElementById("region_submit").value = document.getElementById("region").value
                    document.getElementById("search_submit").value = document.getElementById("search").value
                console.log(document.getElementById("requestor_submit").value)
                console.log(document.getElementById("region_submit").value)
                console.log(document.getElementById("search_submit").value)
            }
        }
        document.getElementById("submit-btn").click();
    }

    const selectChange = (text) => {
        if (text.value != -1) {
            document.getElementById("warning-cancel").style.display = "none";
        }
    }

    const selectAssign = (text) => {
        if (text.value != -1) {
            document.getElementById("warning-assign").style.display = "none";
        }
    }

    const selectAssignT = (text) => {
        if (text.value != -1) {
            document.getElementById("warning-assign-t").style.display = "none";
        }
    }

    const checkSelect = () => {
        const select = document.getElementById("Select-cancel")
        if (select.value == -1) {
            document.getElementById("warning-cancel").style.display = "block";
            return false;
        }
    }

    const checkAssign = () => {
        const select = document.getElementById("Select-physician")
        if (select.value == -1) {
            document.getElementById("warning-assign").style.display = "block";
            return false;
        }
    }

    const checkAssignT = () => {
        const select = document.getElementById("Select-physician-t")
        if (select.value == -1) {
            document.getElementById("warning-assign-t").style.display = "block";
            return false;
        }
    }

    const changePhysician = (element) => {
        $.get('/Admin/GetPhysician', { regionid: element.value }, function (response) {
            const selectphysician = document.getElementById("Select-physician");
            selectphysician.innerHTML = "";
            const firstoption = document.createElement("option");
            firstoption.textContent = "Select Physician"
            firstoption.value = -1
            selectphysician.append(firstoption);
            for (let i = 0; i < response.data.length; ++i) {
                const newOption = document.createElement("option");
                newOption.textContent = response.data[i].firstName + " " + response.data[i].lastName
                newOption.value = response.data[i].physicianId
                selectphysician.append(newOption);
            }
        });
    }

    const changePhysicianT = (element) => {
        $.get('/Admin/GetPhysician', { regionid: element.value }, function (response) {
            const selectphysician = document.getElementById("Select-physician-t");
            selectphysician.innerHTML = "";
            const firstoption = document.createElement("option");
            firstoption.textContent = "Select Physician"
            firstoption.value = -1
            selectphysician.append(firstoption);
            for (let i = 0; i < response.data.length; ++i) {
                const newOption = document.createElement("option");
                newOption.textContent = response.data[i].firstName + " " + response.data[i].lastName
                newOption.value = response.data[i].physicianId
                selectphysician.append(newOption);
            }
        });
    }


    $(document).ready(function () {
        var logElements = document.querySelectorAll('.log');
        console.log(logElements)
        logElements.forEach(function (element) {
            element.addEventListener('click', function () {


                $.get('/Login/Logout', function (response) {
                    console.log(response)
                });

                clearStorage()
            });
        });
    });

    window.onload = () => {

        const phoneInputField = document.getElementsByClassName("phone");
        for (let i = 0; i < phoneInputField.length; ++i) {
            const phoneInput = window.intlTelInput(phoneInputField[i], {
                utilsScript:
                    "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
            });
        }

        if(localStorage.getItem("status") == null)
        {

            designStatus("new")

            $.ajax({
                url: `/Admin/New`,
                type: 'POST',
                dataType: 'html',
                // Pass your data here
                success: function (response) {
                    document.getElementsByClassName("loader-container")[0].style.display = "none";
                    $("#partial-container").html(response)
                },
                error: function (xhr, status, error) {
                    if (xhr.status === 401) {
                        location.reload();
                    }
                    console.log(error);
                }
            });
        }
        else
        {

            designStatus(localStorage.getItem("status").toLowerCase() == "close" ? "to-close" : localStorage.getItem("status").toLowerCase())

            designRequestor(localStorage.getItem("requestor") ?? "All")

            document.getElementById("search").value = localStorage.getItem("search")
            document.getElementById("region").value = localStorage.getItem("region") ?? -1
            
            $.ajax({
                url: `/Admin/${localStorage.getItem("status")}`,
                type: 'POST',
                dataType: 'html',
                data: { search: localStorage.getItem("search"), region: localStorage.getItem("region"), requestor: localStorage.getItem("requestor"), page: localStorage.getItem("page") ?? 1, pageSize: localStorage.getItem("pageSize") ?? 10 },
                // Pass your data here
                success: function (response) {
                    document.getElementsByClassName("loader-container")[0].style.display = "none";
                    document.getElementById("partial-container").style.display = "block";
                    $("#partial-container").html(response)
                },
                error: function (xhr, status, error) {
                    if (xhr.status === 401) {
                        location.reload();
                    }
                    console.log(error);
                }
            });
                
        }

        
    }

    const toggleButton = (curr_btn, typeOfCare) => {
        const buttons = document.getElementsByClassName("common-btn")
        for (let i = 0; i < buttons.length; ++i) {
            if (buttons[i] != curr_btn) {
                buttons[i].classList.remove('create-request-active')
            }
            else {
                buttons[i].classList.add('create-request-active')
            }
        }
        document.getElementById("typeOfCare").value = typeOfCare
    }
</script>
<script src="~/js/admin-dashboard.js"></script>
<script src="~/js/admin-navbar.js"></script>
@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}