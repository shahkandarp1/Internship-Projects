@model PatientRequestViewModel
@{
    ViewData["Title"] = "Patient Request";
}
@section Styles {
    <link href="~/css/form.css" rel="stylesheet" type="text/css" />
    <script src="~/js/form.js"></script>
    <link href="~/css/admin-navbar.css" rel="stylesheet" type="text/css" />
    <script src="~/js/admin-navbar.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
}

<div id="body">

    <!-- Navbar -->

    <partial name="_AdminNavbar" />

    <!-- Toaster -->
    <partial name="Toast"/>

    <!--Location Modal -->

    <div class="modal" id="myModal1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <section>
                    <div class="mapouter">
                        <div class="gmap_canvas">
                            <iframe width="600" height="500" id="gmap_canvas" src="" frameborder="0" scrolling="no" marginheight="0" marginwidth="0">

                                <!-- </iframe><a href="https://123movies-to.org">123 movies</a><br> -->
                                <style>
                                    .mapouter {
                                        position: relative;
                                        text-align: right;
                                        height: 500px;
                                        width: 600px;
                                    }</style>
                                <!-- <a href="https://www.embedgooglemap.net">embedgooglemap.net</a> -->
                                <style>
                                    .gmap_canvas {
                                        overflow: hidden;
                                        background: none !important;
                                        height: 500px;
                                        width: 600px;
                                    }
                                </style>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <!-- Main Content -->

    <div class="main-container">
        <div class="flex-container">
            <div class="top-text">
                <span class="submit-text" id="submit-text">Submit Information</span>
                <a class="back-btn" asp-controller="Admin" asp-action="Dashboard">
                    &lt; <span class="back-text">Back</span>
                </a>
            </div>
            <form class="main-form" method="post" asp-action="CreateRequest" asp-controller="Admin" enctype="multipart/form-data">

                <!-- Patient -->

                <div class="upper-text">
                    Patient
                </div>
                <div class="row">
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="first-name" placeholder="name@example.com" asp-for="FirstName">
                        <label for="first-name" class="form-label">First Name</label>
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="last-name" placeholder="name@example.com" asp-for="LastName">
                        <label for="last-name" class="form-label">Last Name</label>
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="email" class="form-control" id="email" placeholder="name@example.com" asp-for="Email">
                        <label for="email" class="form-label">Email</label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="tel" class="form-control phone" id="phone" asp-for="Phone">
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="date" class="form-control dob" id="dob" placeholder="name@example.com" asp-for="DateOfBirth">
                        <label for="dob" class="form-label dob-label">Date Of Birth</label>
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                </div>

                <!-- Location -->
                <div class="upper-text margin-top">
                    Location
                </div>
                <div class="row symptoms-textarea">
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="street" placeholder="name@example.com" asp-for="Street">
                        <label for="street" class="form-label">Street</label>
                        <span asp-validation-for="Street" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="city" placeholder="name@example.com" asp-for="City">
                        <label for="city" class="form-label">City</label>
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="state" placeholder="name@example.com" asp-for="State">
                        <label for="state" class="form-label">State</label>
                        <span asp-validation-for="State" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="zipcode" placeholder="name@example.com" asp-for="ZipCode">
                        <label for="zipcode" class="form-label">Zipcode</label>
                        <span asp-validation-for="ZipCode" class="text-danger"></span>
                    </div>
                    <div class="form-floating mt-3 inp col-lg-6 col-md-6 col-sm-12">
                        <input type="text" class="form-control" id="room" placeholder="name@example.com" asp-for="Room">
                        <label for="room" class="form-label">Room / Suite (Optional)</label>
                        <span asp-validation-for="Room" class="text-danger"></span>
                    </div>
                    <button class="location col-lg-6 col-md-6 col-sm-12 mt-3" type="button" id="verifyRegion">
                        <span class="map-text">Verify</span>
                    </button>
                    <button class="location col-lg-6 col-md-6 col-sm-12 mt-3" type="button" id="openBtn">
                        <img class="map-img" src="../../images/geo-alt.svg" alt="">
                        <span class="map-text">Map</span>
                    </button>
                </div>

                <!-- Notes -->

                <div class="upper-text margin-top">
                    Notes
                </div>
                <div class="row symptoms-textarea">
                    <div class="row symptoms-textarea">
                        <div class="form-floating mt-3 inp col-sm-12">
                            <textarea class="form-control text-area" id="floatingInput" placeholder="name@example.com" asp-for="Admin_notes"></textarea>
                            <label for="floatingInput" class="form-label">Admin Notes(Optional)</label>
                            <span asp-validation-for="Admin_notes" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Submit / Clear -->
                <div class="lower-btn">
                    <button class="lower-custom-btn submit-btn" type="submit">Submit</button>
                    <button type="button" class="lower-custom-btn cancel-btn" onclick="reload()">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bottom Part -->

    <partial name="_FormFooter" />
</div>
<script>
    $('#verifyRegion').on('click',()=>{
        console.log("Hello")
        $.post('/Admin/VerifyRegion', { region: document.getElementById("state")?.value },function (response) {
            console.log(response)
            if (response.isVerified == 1) {
                toastr.success("We are serving in this region!!");
            }
            else if (response.isVerified == 2) {
                toastr.error("Please provide the required details to verify!!");
            }
            else if (response.isVerified == 3) {
                toastr.error("We are currently not serving in this region!!");
            }
        });
    })
</script>
@section Scripts {
    @{
                <partial name="_ValidationScriptsPartial" />
    }
}