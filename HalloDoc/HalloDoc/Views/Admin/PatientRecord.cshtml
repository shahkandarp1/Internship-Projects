@model PatientHistoryViewModel
@{
    ViewData["Title"] = "Patient Records";
    Layout = "_AdminLayout";
}

@section Styles {
    <link href="~/css/admin-navbar.css" rel="stylesheet" type="text/css" />
    <link href="~/css/admin-dashboard.css" rel="stylesheet" type="text/css" />
    <link href="~/css/patient-profile.css" rel="stylesheet" type="text/css" />
    <link href="~/css/admin-provider.css" rel="stylesheet" type="text/css" />
    <link href="~/css/patient-history.css" rel="stylesheet" type="text/css" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
}

<div id="body">

    <!-- Navbar -->
    <partial name="_AdminNavbar" model="@Model.adminNavbarViewModel" />

    <!-- Toaster -->
    <partial name="Toast" />

    <div class="main-container">
        <div class="flex-container">
            <div class="top-text">
                <span class="submit-text" id="submit-text">Patient Record</span>
                <a class="back-btn" asp-controller="Admin" asp-action="PatientHistory">
                    &lt; <span class="back-text">Back</span>
                </a>
            </div>
            <div class="bottom-main-container mt-3 mb-3 pb-3">


                <!--Partial View-->
                <div id="partial-container"></div>


                <!--Loader-->
                <div class="loader-container">
                    <div class="loader"></div>
                </div>



            </div>
        </div>
    </div>
</div>

<script>
    const filter = (page, pageSize) => {
        document.getElementById("partial-container").style.display = "none";
        document.getElementsByClassName("loader-container")[0].style.display = "flex";
        var id = window.location.href.split("/")[window.location.href.split("/").length - 1]
        $.ajax({
            url: `/Admin/PatientRecordTable`,
            type: 'POST',
            dataType: 'html',
            data: { id:id,page: page, pageSize: pageSize },
            // Pass your data here
            success: function (response) {
                document.getElementsByClassName("loader-container")[0].style.display = "none";
                document.getElementById("partial-container").style.display = "block";
                $("#partial-container").html(response)
            },
            error: function () {
                alert('An error occurred.');
            }
        });
    }

    window.onload = () => {
        var id = window.location.href.split("/")[window.location.href.split("/").length - 1]
        $.ajax({
            url: `/Admin/PatientRecordTable`,
            type: 'POST',
            dataType: 'html',
            data: { id: id, page: 1, pageSize: 10 },
            // Pass your data here
            success: function (response) {
                document.getElementsByClassName("loader-container")[0].style.display = "none";
                document.getElementById("partial-container").style.display = "block";
                $("#partial-container").html(response)
            },
            error: function () {
                alert('An error occurred.');
            }
        });

    }


</script>


<script src="~/js/admin-navbar.js"></script>
<script src="~/js/admin-dashboard.js"></script>