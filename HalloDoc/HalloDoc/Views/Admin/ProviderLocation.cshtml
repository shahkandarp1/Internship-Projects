@using System.Diagnostics;
@model ProviderLocationViewModel
@{
    ViewData["Title"] = "Provider Location";
    Layout = "_AdminLayout";
}

@section Styles {
    <link href="~/css/admin-navbar.css" rel="stylesheet" type="text/css" />
    <link href="~/css/admin-dashboard.css" rel="stylesheet" type="text/css" />
    <link href="~/css/patient-profile.css" rel="stylesheet" type="text/css" />
    <link href="~/css/admin-provider.css" rel="stylesheet" type="text/css" />
    <link href="~/css/account-access.css" rel="stylesheet" type="text/css" />
    <link href="~/css/provider-location.css" rel="stylesheet" type="text/css" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
}

<div id="body">
    <!-- Navbar -->
    <partial name="_AdminNavbar" model="@Model.adminNavbarViewModel" />

    <!-- Toaster -->
    <partial name="Toast" />


    <div class="main-container">
        <div class="flex-container">
            <div class="top-text">
                <span class="submit-text" id="submit-text">Provider Location</span>
            </div>
            <div class="bottom-main-container bg-body mt-3 mb-3 pb-3">
                
                <div id="map" class="provider-location-map"></div>

            </div>
        </div>
    </div>
</div>

<script>

    @{
        var list = System.Text.Json.JsonSerializer.Serialize(Model.physicianLocations);
        Debug.WriteLine(list);
    }

    var markersData = @Html.Raw(list);

    for(let i=0;i<markersData.length;++i)
    {
        markersData[i].content = `<div style='padding:5px'>${markersData[i].PhysicianName}</div>`
    }

    // Create a single InfoWindow object
    const infoWindow = new google.maps.InfoWindow();

    const bounds = new google.maps.LatLngBounds();

    // Loop through markers and extend bounds
    for (const markerData of markersData) {
        const lat = markerData.Latitude;
        const lng = markerData.Longitude;
        const myLatLng = new google.maps.LatLng(lat, lng);
        bounds.extend(myLatLng);
    }

    const map = new google.maps.Map(document.getElementById("map"), {
        zoom: 8, // Adjust initial zoom level (optional)
        center: bounds.getCenter(), // Center on calculated bounds
    });

    // Loop through the data and create markers
    for (const markerData of markersData) {
        const lat = markerData.Latitude;
        const lng = markerData.Longitude;
        const content = markerData.content;

        const myLatLng = { lat: lat, lng: lng };

        // Create a marker with label (adjust labelOrigin for positioning)
        const marker = new google.maps.Marker({
            position: myLatLng,
            map: map,
        });

        // Create a closure to capture marker specific content
        (function (marker, content) {
            marker.addListener("click", () => {
                infoWindow.setContent(content);
                infoWindow.open(map, marker);
            });
        })(marker, content);
    }

    map.fitBounds(bounds);

</script>


<script src="~/js/admin-navbar.js"></script>
<script src="~/js/admin-dashboard.js"></script>

