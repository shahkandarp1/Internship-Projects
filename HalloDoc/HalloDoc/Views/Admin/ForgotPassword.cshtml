@{
    ViewData["Title"] = "Forgot Password";
}
@section Styles {
    <link href="~/css/admin-login.css" rel="stylesheet" type="text/css" />
    <script src="~/js/admin-login.js"></script>
}
<div onload="checkMode()">
    <img src="../../images/7768657_3763028.jpg" alt="" class="bg-image">
    <div class="main-container">
        <div class="left half-container">
            <img class="left-img" src="../../images/11116016_415.jpg" alt="">
        </div>
        <div class="right half-container" id="body">
            <span class="top-right-moon">
                <button class="moon" onclick="changeMode()">
                    <img id="moon" src="../../images/moon.svg" alt="" class="moon-img" />
                    <img id="sun" src="../../images/sun.svg" alt="" class="moon-img hidden" />
                </button>
            </span>
            <div class="right-flex-container">
                <div class="logo">
                    <img src="../../images/logo1.png" alt="" class="logo-img">
                </div>
                <form action="" class="login-content">
                    <span class="login-text" id="login-text">Reset Your Password</span>
                    <div class="form-floating mb-3 inp">
                        <input type="email" class="form-control" id="floatingInput" placeholder="name@example.com">
                        <label for="floatingInput" class="form-label">Username</label>
                        <img src="../../images/user.png" alt="" class="inp-side-picture">
                    </div>

                    <a class="btn btn-info custom-submit-btn" href="#">Reset Password</a>
                    <a class="back-to-login-text" asp-controller="Admin" asp-action="Login">&lt; Back To Login</a>
                </form>
            </div>
            <div class="bottom-part-flex" id="bottom-flex"><a href="#" class="bottom-part-a right-a">Terms of Conditions</a> | <a href="#" class="bottom-part-a left-a">Privacy Policy</a></div>
        </div>
    </div>
</div>