@model LoginViewModel
@{
    ViewData["Title"] = "Patient Login";
}
@section Styles {
    <link href="~/css/patient-login.css" rel="stylesheet" type="text/css" />
    <script src="~/js/patient-login.js"></script>
}
<div id="body">

    <!-- Toaster -->
    <partial name="Toast" />

    <div class="main-container">
        <span class="top-right-moon">
            <button class="moon" onclick="changeMode()">
                <img id="moon" src="../../images/moon.svg" alt="" class="moon-img" />
                <img id="sun" src="../../images/sun.svg" alt="" class="moon-img hidden" />
            </button>
        </span>
        <div class="flex-container">
            <div class="image-container">
                <img src="../../images/11116016_415.jpg" alt="" class="bg-image">
                <div class="inner-flex">
                    <div class="logo">
                        <img src="../../images/logo1.png" alt="" class="logo-img">
                    </div>
                    <form asp-action="PatientLogin" class="login-content" method="post">
                        <div class="back">
                            <a class="back-text" asp-controller="CreateRequest" asp-action="PatientSite">&lt; Back</a>
                            <span class="login-text" id="login-text">Login To Your Account</span>
                        </div>
                        <div class="form-floating mt-3 inp">
                            <input type="text" class="form-control" id="floatingInput" placeholder="username" asp-for="Email">
                            <label for="floatingInput" class="form-label">Email</label>
                            <img src="../../images/user.png" alt="" class="inp-side-picture">
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                        <div class="form-floating mt-3 inp">
                            <input type="password" class="form-control" id="floatingPassword" placeholder="password" asp-for="Password">
                            <label for="floatingPassword" class="form-label">Password</label>
                            <a href="#" onclick="changeVisibility()" style="cursor: pointer;"><img src="../../images/view.png" alt="" class="inp-side-picture eye open-eye"></a>
                            <a href="#" onclick="changeVisibility()" style="cursor: pointer;"><img src="../../images/hide.png" alt="" class="inp-side-picture eye hidden close-eye"></a>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <button class="btn btn-info custom-submit-btn mt-3" type="submit">Log In</button>
                        <a asp-action="ForgotPassword" class="forgot-password">Forgot Password?</a>
                    </form>
                </div>
            </div>
        </div>
        <div class="bottom-part-flex" id="bottom-flex">
            <a href="#" class="bottom-part-a right-a">Terms of Conditions</a> |
            <a href="#" class="bottom-part-a left-a">Privacy Policy</a>
        </div>
    </div>
</div>
@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
    }