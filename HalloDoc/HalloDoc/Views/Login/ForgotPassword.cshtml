@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Submit Request";
}
@section Styles {
    <link href="~/css/patient-login.css" rel="stylesheet" type="text/css" />
    <script src="~/js/patient-login.js"></script>
}

<div id="body">

    <!-- Toaster -->
    <partial name="Toast" />

    <div class="main-container">
        <span class="top-right-moon">
            <button class="moon" onclick="changeMode()">
                <img id="moon" src="../../images/moon.svg" alt="" class="moon-img" />
                <img id="sun" src="../../images/sun.svg" alt="" class="moon-img hidden" />
            </button>
        </span>
        <div class="flex-container">
            <div class="image-container">
                <img src="../../images/11116016_415.jpg" alt="" class="bg-image">
                <div class="inner-flex">
                    <div class="logo">
                        <img src="../../images/logo1.png" alt="" class="logo-img">
                    </div>
                    <form class="login-content" asp-action="ForgotPassword">
                        <div class="back reset-text">
                            <a class="back-text" asp-controller="Login" asp-action="PatientLogin">&lt; Back</a>
                            <span class="login-text" id="login-text">Reset Your Password</span>
                        </div>
                        <div class="form-floating inp">
                            <input type="email" class="form-control" id="floatingInput" placeholder="name@example.com" asp-for="email">
                            <label for="floatingInput" class="form-label">Email</label>
                            <img src="../../images/user.png" alt="" class="inp-side-picture">
                        </div>
                        <span id="usernameexist" class="text-danger hidden-span">This Email does not Exists!!</span>
                        <span id="mailsent" class="text-success hidden-span">Mail Sent Successfully!!</span>
                        <button class="btn btn-info custom-submit-btn mt-3" type="submit" id="login">Reset Password</button>
                        <a class="back-to-login-text" asp-controller="Login" asp-action="PatientLogin">&lt; Back To Login</a>
                    </form>
                </div>
            </div>
        </div>
        <div class="bottom-part-flex" id="bottom-flex">
            <a href="#" class="bottom-part-a right-a">Terms of Conditions</a> |
            <a href="#" class="bottom-part-a left-a">Privacy Policy</a>
        </div>
    </div>
</div>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
    }

