@{
    ViewData["Title"] = "Patient Site";
}
@section Styles {
    <link href="~/css/patient-site.css" rel="stylesheet" type="text/css" />
    <script src="~/js/patient-site.js"></script>
}

<!-- Toaster -->
<partial name="Toast" />

<div id="body">
    <div class="main-container">
        <span class="top-right-moon">
            <button class="moon" onclick="changeMode()">
                <img id="moon" src="~/images/moon.svg" alt="" class="moon-img" />
                <img id="sun" src="~/images/sun.svg" alt="" class="moon-img hidden" />
            </button>
        </span>
        <div class="flex-container">
            <div class="image-container">
                <img src="~/images/11116016_415.jpg" alt="" class="bg-image">
                <div class="inner-flex">
                    <div class="logo">
                        <img src="~/images/logo1.png" alt="" class="logo-img">
                    </div>
                    <a asp-action="SubmitRequest" class="btn custom-btn btn-info">
                        Submit a Request
                    </a>
                    <a asp-controller="Login" asp-action="PatientLogin" class="btn custom-btn btn-second">
                        Registered Users
                    </a>
                </div>
            </div>
        </div>
        <div class="bottom-part-flex" id="bottom-flex">
            <a href="#" class="bottom-part-a right-a">Terms of Conditions</a> |
            <a href="#" class="bottom-part-a left-a">Privacy Policy</a>
        </div>
    </div>
</div>
